/* ==========================================================================
   Jagruti Appliances — Site Stylesheet
   Palette: sampled directly from the brand wordmark artwork.
   Root brand tokens: Jagruti Blue / Deep Blue / Sky Tint / Ink / Paper —
   the full blue and ink scales below are generated from those five anchors
   so every component on the site inherits the same brand colour.
   ========================================================================== */

:root {
  /* ---- Brand anchors (sampled from artwork) ---- */
  --brand-primary: #0d8ac4;  /* Jagruti Blue — fills the wordmark */
  --brand-deep:    #096590;  /* Deep Blue — hover / pressure states */
  --brand-tint:    #ebf5fa;  /* Sky Tint — washes / backgrounds */
  --brand-ink:     #172026;  /* Ink — body text on light ground */
  --brand-paper:   #ffffff;  /* Paper — the ground the mark ships on */

  /* ---- Blue scale, generated from the brand anchors ---- */
  --blue-900: #053d57;
  --blue-800: #075174;
  --blue-700: var(--brand-deep);
  --blue-600: var(--brand-primary);
  --blue-500: #13a7ec;
  --blue-400: #4eb8e9;
  --blue-300: #86caea;
  --blue-200: #bce0f0;
  --blue-100: var(--brand-tint);
  --blue-50:  #f5fafc;

  /* ---- Ink scale ---- */
  --ink-900: var(--brand-ink);
  --ink-700: #344551;
  --ink-500: #607685;
  --ink-300: #a3b0b8;

  --white: var(--brand-paper);
  --whatsapp: #25d366;
  --whatsapp-dark: #1ebe57;
  --gold: #d7a53b;
  --danger: #c0432f;

  /* ---- Gradients — pick a mood for a richer, less flat surface ---- */
  --gradient-primary: linear-gradient(135deg, var(--blue-500) 0%, var(--blue-600) 50%, var(--blue-700) 100%); /* energetic */
  --gradient-deep:    linear-gradient(160deg, var(--blue-900) 0%, var(--blue-700) 55%, var(--blue-600) 100%); /* premium / dark */
  --gradient-sheen:   linear-gradient(120deg, var(--blue-700) 0%, var(--blue-500) 55%, var(--blue-300) 100%); /* glossy accent */

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --radius-pill: 999px;

  --shadow-sm: 0 2px 10px rgba(5, 61, 87, 0.08);
  --shadow-md: 0 10px 30px rgba(5, 61, 87, 0.12);
  --shadow-lg: 0 20px 50px rgba(5, 61, 87, 0.18);

  --container: 1220px;
  --header-h: 76px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  color: var(--ink-900);
  background: var(--white);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
ul { list-style: none; margin: 0; padding: 0; }
button { font-family: inherit; cursor: pointer; }
h1, h2, h3, h4 { margin: 0 0 .5em; line-height: 1.2; font-weight: 800; letter-spacing: -0.01em; }
p { margin: 0 0 1em; color: var(--ink-700); }

.container { max-width: var(--container); margin: 0 auto; padding: 0 24px; }
.section { padding: 72px 0; }
.section-tight { padding: 44px 0; }
.section-alt { background: var(--blue-50); }
.eyebrow {
  display: inline-block;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--blue-600);
  background: var(--blue-100);
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  margin-bottom: 16px;
}
.section-head { max-width: 700px; margin: 0 auto 44px; text-align: center; }
.section-head h2 { font-size: clamp(26px, 3.2vw, 38px); }
.section-head p { font-size: 17px; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 26px;
  border-radius: var(--radius-pill);
  font-weight: 700;
  font-size: 15px;
  border: 2px solid transparent;
  transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--gradient-primary); color: var(--white); box-shadow: var(--shadow-sm); }
.btn-primary:hover { background: var(--gradient-deep); box-shadow: var(--shadow-md); }
.btn-outline { background: transparent; border-color: var(--blue-300); color: var(--blue-700); }
.btn-outline:hover { border-color: var(--blue-600); background: var(--blue-100); }
.btn-ghost { background: var(--white); color: var(--blue-700); border-color: rgba(255,255,255,.5); }
.btn-whatsapp {
  background: var(--whatsapp); color: var(--white); box-shadow: 0 8px 20px rgba(37,211,102,.30);
}
.btn-whatsapp:hover { background: var(--whatsapp-dark); }
.btn-sm { padding: 9px 18px; font-size: 13.5px; }
.btn-block { width: 100%; }
.btn svg { width: 18px; height: 18px; flex: none; }

/* ---------- Header ---------- */
@keyframes navSheen {
  0% { transform: translateX(-120%) skewX(-12deg); }
  100% { transform: translateX(220%) skewX(-12deg); }
}
@keyframes waPulse {
  0%, 100% { box-shadow: 0 8px 20px rgba(37,211,102,.30), 0 0 0 0 rgba(37,211,102,.35); }
  50% { box-shadow: 0 8px 20px rgba(37,211,102,.30), 0 0 0 7px rgba(37,211,102,0); }
}
@keyframes navItemIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.site-header {
  position: sticky; top: 0; z-index: 500;
  background: rgba(255,255,255,.86);
  backdrop-filter: blur(14px) saturate(1.4);
  -webkit-backdrop-filter: blur(14px) saturate(1.4);
  border-bottom: 1px solid var(--blue-100);
  height: var(--header-h);
  transition: height .3s cubic-bezier(.4,0,.2,1), box-shadow .3s ease, background .3s ease, border-color .3s ease;
}
.site-header.is-scrolled {
  height: calc(var(--header-h) - 16px);
  background: rgba(255,255,255,.96);
  box-shadow: 0 8px 30px rgba(5,61,87,.10);
  border-bottom-color: transparent;
}
.site-header .container { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20px; }

/* ---------- Transparent header over the light hero ----------
   On any page whose header is immediately followed by the light .hero
   (currently the homepage), the bar sits *over* the hero with no ground,
   no blur and no divider, so header and hero read as one surface.
   It returns to the solid treatment as soon as the page is scrolled.
   Inner pages use the dark .page-hero and are unaffected.              */
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border-bottom-color: transparent;
  box-shadow: none;
}
/* Pull the hero up under the transparent bar so there is no seam. The
   container supplies its own header clearance, so no padding is added here. */
body:has(> main > .hero:first-child) main > .hero:first-child {
  margin-top: calc(var(--header-h) * -1);
}
/* The hero is a dark stage, so the un-scrolled bar switches to light-on-dark. */
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .logo-mark {
  color: #fff; border-color: rgba(255,255,255,.55);
}
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .logo-tag { color: rgba(255,255,255,.72); }
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .nav-link,
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .nav-dropdown-btn { color: rgba(255,255,255,.92); }
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .nav-link:hover,
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .nav-dropdown-btn:hover { color: #fff; }
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .header-search-btn {
  color: #fff; border-color: rgba(255,255,255,.38); background: transparent;
}
body:has(> main > .hero:first-child) .site-header:not(.is-scrolled) .hamburger span { background: #fff; }

.logo { display: flex; align-items: center; gap: 10px; flex: none; }
.logo-mark {
  position: relative; overflow: hidden;
  font-weight: 900; font-size: 21px; letter-spacing: .02em; color: var(--blue-700);
  border: 2.5px solid var(--blue-500); border-radius: var(--radius-pill);
  padding: 5px 16px; line-height: 1;
  transition: border-color .25s ease, box-shadow .25s ease, transform .25s cubic-bezier(.34,1.56,.64,1);
}
.logo-mark::after {
  content: ""; position: absolute; top: 0; left: 0; width: 40%; height: 100%;
  background: linear-gradient(120deg, transparent, rgba(255,255,255,.75), transparent);
  transform: translateX(-120%) skewX(-12deg);
}
.logo:hover .logo-mark {
  transform: translateY(-1px) scale(1.03);
  border-color: var(--blue-700);
  box-shadow: 0 6px 18px rgba(13,138,196,.25);
}
.logo:hover .logo-mark::after { animation: navSheen .9s ease; }
.logo-tag { display: block; font-size: 10.5px; font-style: italic; color: var(--ink-500); margin-top: 2px; }

.main-nav { display: flex; align-items: center; gap: 4px; flex: 1; justify-content: center; }
.main-nav > ul { display: flex; align-items: center; gap: 2px; }
.main-nav > ul > li { position: relative; }
.nav-link, .nav-dropdown-btn {
  position: relative;
  display: flex; align-items: center; gap: 5px;
  padding: 10px 14px; border-radius: var(--radius-sm); font-weight: 600; font-size: 14.5px;
  color: var(--ink-700); background: transparent; border: none;
  transition: color .2s ease, background .2s ease;
}
.nav-link::after, .nav-dropdown-btn::after {
  content: ""; position: absolute; left: 14px; right: 14px; bottom: 5px; height: 2px;
  border-radius: 2px; background: var(--gradient-primary);
  transform: scaleX(0); transform-origin: center; opacity: 0;
  transition: transform .28s cubic-bezier(.16,1,.3,1), opacity .28s ease;
}
.nav-link:hover, .nav-dropdown-btn:hover,
.nav-link:focus-visible, .nav-dropdown-btn:focus-visible {
  color: var(--blue-700); background: var(--blue-100);
}
.nav-link:hover::after, .nav-dropdown-btn:hover::after,
.nav-link:focus-visible::after, .nav-dropdown-btn:focus-visible::after,
.nav-link.active::after { transform: scaleX(1); opacity: 1; }
.nav-link.active { color: var(--blue-700); font-weight: 700; }
.nav-dropdown-btn svg { width: 12px; height: 12px; transition: transform .25s cubic-bezier(.34,1.56,.64,1); }
.has-dropdown:hover .nav-dropdown-btn svg, .has-dropdown:focus-within .nav-dropdown-btn svg { transform: rotate(180deg); }

.dropdown-panel {
  position: absolute; top: 100%; left: 0; margin-top: 10px;
  background: rgba(255,255,255,.98); border-radius: var(--radius-md); box-shadow: var(--shadow-lg);
  border: 1px solid var(--blue-100); overflow: hidden;
  min-width: 260px; padding: 10px; opacity: 0; visibility: hidden; transform: translateY(8px) scale(.98);
  transform-origin: top left; pointer-events: none;
  transition: opacity .22s ease, transform .28s cubic-bezier(.16,1,.3,1), visibility .22s;
}
.dropdown-panel::before {
  content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--gradient-primary);
}
.has-dropdown:hover .dropdown-panel, .has-dropdown:focus-within .dropdown-panel {
  opacity: 1; visibility: visible; transform: translateY(0) scale(1); pointer-events: auto;
}
.dropdown-panel a {
  display: flex; flex-direction: column; padding: 10px 12px; border-radius: var(--radius-sm);
  position: relative; opacity: 0; transform: translateY(6px); transition-delay: 0s;
  transition: background .18s ease, transform .35s cubic-bezier(.16,1,.3,1), opacity .3s ease, padding-left .18s ease;
}
.has-dropdown:hover .dropdown-panel a, .has-dropdown:focus-within .dropdown-panel a { opacity: 1; transform: translateY(0); }
.has-dropdown:hover .dropdown-panel a:nth-child(1), .has-dropdown:focus-within .dropdown-panel a:nth-child(1) { transition-delay: .03s; }
.has-dropdown:hover .dropdown-panel a:nth-child(2), .has-dropdown:focus-within .dropdown-panel a:nth-child(2) { transition-delay: .06s; }
.has-dropdown:hover .dropdown-panel a:nth-child(3), .has-dropdown:focus-within .dropdown-panel a:nth-child(3) { transition-delay: .09s; }
.has-dropdown:hover .dropdown-panel a:nth-child(4), .has-dropdown:focus-within .dropdown-panel a:nth-child(4) { transition-delay: .12s; }
.has-dropdown:hover .dropdown-panel a:nth-child(5), .has-dropdown:focus-within .dropdown-panel a:nth-child(5) { transition-delay: .15s; }
.has-dropdown:hover .dropdown-panel a:nth-child(6), .has-dropdown:focus-within .dropdown-panel a:nth-child(6) { transition-delay: .18s; }
.has-dropdown:hover .dropdown-panel a:nth-child(7), .has-dropdown:focus-within .dropdown-panel a:nth-child(7) { transition-delay: .21s; }
.dropdown-panel a:hover { background: var(--blue-50); padding-left: 16px; }
.dropdown-panel a strong { font-size: 14px; color: var(--ink-900); }
.dropdown-panel a span { font-size: 12.5px; color: var(--ink-500); }
.dropdown-panel .view-all { border-top: 1px solid var(--blue-100); margin-top: 6px; padding-top: 10px; font-size: 13.5px; font-weight: 700; color: var(--blue-600); }
.dropdown-panel .view-all:hover { padding-left: 12px; }

.header-actions { display: flex; align-items: center; gap: 10px; flex: none; }
.header-search-btn {
  width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--blue-200); background: var(--white);
  display: flex; align-items: center; justify-content: center; color: var(--blue-700);
  transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s cubic-bezier(.34,1.56,.64,1);
}
.header-search-btn:hover { background: var(--gradient-primary); border-color: transparent; color: var(--white); transform: scale(1.08) rotate(-8deg); }
.header-search-btn svg { width: 17px; height: 17px; }
.btn-whatsapp { animation: waPulse 2.6s ease-in-out infinite; }
.btn-whatsapp:hover { animation-play-state: paused; }

.hamburger { display: none; position: relative; width: 40px; height: 40px; border: none; background: transparent; }
.hamburger span {
  display: block; width: 22px; height: 2.5px; background: var(--ink-900); margin: 5px auto; border-radius: 2px;
  transition: transform .3s cubic-bezier(.4,0,.2,1), opacity .2s ease, width .2s ease;
}
.hamburger.is-open span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
.hamburger.is-open span:nth-child(2) { opacity: 0; width: 0; }
.hamburger.is-open span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

/* mobile nav drawer */
.mobile-nav {
  position: fixed; inset: 0; background: rgba(9,20,28,.55); backdrop-filter: blur(2px);
  z-index: 900; opacity: 0; visibility: hidden; pointer-events: none;
  transition: opacity .3s ease, visibility .3s;
}
.mobile-nav.open { opacity: 1; visibility: visible; pointer-events: auto; }
.mobile-nav-panel {
  position: absolute; top: 0; right: 0; width: min(84vw, 340px); height: 100%;
  background: var(--white); padding: 22px; overflow-y: auto; box-shadow: var(--shadow-lg);
  transform: translateX(100%);
  transition: transform .38s cubic-bezier(.16,1,.3,1);
}
.mobile-nav.open .mobile-nav-panel { transform: translateX(0); }
.mobile-nav-panel .close-btn { float: right; background: none; border: none; font-size: 26px; color: var(--ink-500); transition: transform .25s cubic-bezier(.34,1.56,.64,1), color .2s ease; }
.mobile-nav-panel .close-btn:hover { color: var(--danger); transform: rotate(90deg); }
.mobile-nav-panel ul { margin-top: 40px; }
.mobile-nav-panel li {
  border-bottom: 1px solid var(--blue-100);
  opacity: 0; transform: translateX(16px);
  transition: opacity .35s ease, transform .4s cubic-bezier(.16,1,.3,1);
}
.mobile-nav.open .mobile-nav-panel li { opacity: 1; transform: translateX(0); }
.mobile-nav.open .mobile-nav-panel li:nth-child(1) { transition-delay: .08s; }
.mobile-nav.open .mobile-nav-panel li:nth-child(2) { transition-delay: .13s; }
.mobile-nav.open .mobile-nav-panel li:nth-child(3) { transition-delay: .18s; }
.mobile-nav.open .mobile-nav-panel li:nth-child(4) { transition-delay: .23s; }
.mobile-nav.open .mobile-nav-panel li:nth-child(5) { transition-delay: .28s; }
.mobile-nav.open .mobile-nav-panel li:nth-child(6) { transition-delay: .33s; }
.mobile-nav-panel a, .mobile-nav-panel summary { display: block; padding: 14px 4px; font-weight: 700; font-size: 15.5px; color: var(--ink-900); cursor: pointer; transition: color .18s ease, padding-left .18s ease; }
.mobile-nav-panel a:hover, .mobile-nav-panel a:active { color: var(--blue-700); padding-left: 8px; }
.mobile-nav-panel a.active { color: var(--blue-700); box-shadow: inset 3px 0 0 var(--blue-600); padding-left: 10px; }
.mobile-nav-panel summary::-webkit-details-marker { display: none; }
.mobile-nav-panel summary { position: relative; padding-right: 24px; }
.mobile-nav-panel summary::after {
  content: ""; position: absolute; right: 4px; top: 50%; width: 9px; height: 9px;
  border-right: 2px solid var(--ink-500); border-bottom: 2px solid var(--ink-500);
  transform: translateY(-65%) rotate(45deg); transition: transform .25s ease;
}
.mobile-nav-panel details[open] summary::after { transform: translateY(-35%) rotate(-135deg); }
.mobile-nav-panel details ul { margin: 0 0 10px 12px; }
.mobile-nav-panel details a { display: flex; flex-direction: column; font-weight: 500; font-size: 14px; padding: 10px 4px; }
.mobile-nav-panel details a strong { font-size: 14px; color: var(--ink-900); }
.mobile-nav-panel details a span { font-size: 12.5px; color: var(--ink-500); }
.mobile-nav-panel details a:hover { padding-left: 8px; }

@media (prefers-reduced-motion: reduce) {
  .site-header, .logo-mark, .nav-link, .nav-dropdown-btn, .nav-link::after, .nav-dropdown-btn::after,
  .dropdown-panel, .dropdown-panel a, .header-search-btn, .hamburger span, .mobile-nav, .mobile-nav-panel,
  .mobile-nav-panel li, .mobile-nav-panel a, .btn-whatsapp {
    transition-duration: .01ms !important; animation: none !important;
  }
}

/* ---------- Sticky mobile bottom bar ---------- */
.mobile-bar { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 600; background: var(--white); border-top: 1px solid var(--blue-200); box-shadow: 0 -6px 20px rgba(5,61,87,.10); }
.mobile-bar .row { display: flex; }
.mobile-bar a { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 8px; font-weight: 700; font-size: 14px; }
.mobile-bar .call-btn { color: var(--blue-700); border-right: 1px solid var(--blue-100); }
.mobile-bar .wa-btn { color: var(--white); background: var(--whatsapp); }
.mobile-bar svg { width: 18px; height: 18px; }

/* desktop floating whatsapp */
.float-wa {
  position: fixed; right: 26px; bottom: 26px; z-index: 600;
  width: 60px; height: 60px; border-radius: 50%; background: var(--whatsapp); color: #fff;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 12px 30px rgba(37,211,102,.4);
}
.float-wa svg { width: 30px; height: 30px; }
.float-wa:hover { transform: scale(1.06); }

/* ---------- Hero (homepage — dark stage) ----------
   Layout follows the approved reference: eyebrow, oversized white wordmark
   headline, the product shot centred with feature callouts flanking it,
   CTAs, a category strip and a closing stat row. Every accent that the
   reference rendered in green uses the Jagruti brand blue here.          */
.hero {
  position: relative;
  background: #002032;  /* matched to the photograph's ground as rendered */
  color: #fff;
  overflow: hidden;
  padding: 0 0 18px;
  text-align: left;
  /* Exactly one screen from the top of the viewport: the section starts a
     header's height above it (negative margin), so it is that much taller. */
  height: 100svh;
  min-height: 620px;
}
.hero .container {
  height: 100%;
  display: flex;
  flex-direction: column;
  /* Clears the navbar plus the section's negative pull-up, then a small
     gap — so the headline sits high, as in the approved layout. */
  padding-top: calc(var(--header-h) * 2 - 24px);
  gap: 0;
}
/* Layer 1 — the product photograph. Sized to the section width so the
   machines occupy the centre band, matching the approved composition. */
.hero::before {
  content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
  /* Fills the entire section edge to edge. Because it covers every pixel
     there are no image edges to hide, so no mask is needed. */
  background: url("../images/Home%20page/hero%20section.png") no-repeat 50% 58% / cover;
}
/* Layer 2 — readability scrim. Darkens both side columns where the callouts
   sit and the top/bottom bands, leaving the machines in the centre bright. */
.hero::after {
  content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
  background:
    linear-gradient(90deg, rgba(0,28,45,.80) 0%, rgba(0,28,45,.30) 20%, transparent 32%,
                           transparent 68%, rgba(0,28,45,.30) 80%, rgba(0,28,45,.80) 100%),
    linear-gradient(180deg, rgba(0,30,48,.42) 0%, transparent 24%, transparent 72%, rgba(0,26,42,.48) 100%);
}
.hero .container { position: relative; z-index: 1; }

.hero-eyebrow {
  flex: none; text-align: center;
  font-size: 13px; font-weight: 700; letter-spacing: .10em; text-transform: uppercase;
  color: rgba(255,255,255,.72); margin-bottom: 8px;
}
.hero-eyebrow .accent { color: var(--blue-500); }

.hero h1 {
  flex: none;
  color: #fff;
  /* Centred so the wordmark sits directly behind the appliances, which are
     centred in the photograph. Capped against viewport height too. */
  text-align: center;
  font-size: min(10.2vw, 15vh, 165px);
  line-height: .95;
  letter-spacing: -.035em;
  margin: 0 0 -.04em;
}
.hero h1 .accent { color: var(--blue-500); }

/* --- Stage: the open band the background products show through, with the
   three feature callouts pinned down either side. It takes the largest share
   of the section height so the columns always have room to sit apart. --- */
/* Sized by its own content — the taller of the two callout columns — so the
   columns always fit inside it and never spill onto the CTA row below. */
.hero-stage {
  position: relative; flex: 1 1 auto;
  display: flex;
  min-height: 0;
}

/* Right edge of the stage is one flex column: the sub-line sits tight to the
   top, directly beneath the headline, with the callouts spaced below it. */
.hero-right-col {
  position: absolute; top: 0; right: 0; bottom: 0; z-index: 2;
  display: flex; flex-direction: column; align-items: flex-start;
  gap: clamp(26px, 5vh, 64px);
}
/* Never allowed to shrink or be crowded by the callouts beneath it. */
.hero-sub {
  flex: none;
  margin: 0; width: max-content; text-align: left;
  font-size: clamp(15px, 1.3vw, 20px); line-height: 1.4;
  color: rgba(255,255,255,.95); font-weight: 500;
}

/* Grouped tightly rather than spread, matching the approved composition.
   Both columns are bounded by the stage so they can never overhang the CTA
   row below; the gap collapses first when height is tight. */
.hero-feats {
  display: flex; flex-direction: column; justify-content: flex-start;
  gap: clamp(10px, 2.2vh, 30px); text-align: left; min-height: 0;
}
/* The left column is absolute and sits in the upper part of the stage; the
   right one flows inside .hero-right-col beneath the sub-line. */
.hero-feats-left  { position: absolute; z-index: 2; left: 0; top: 4%; bottom: 0; }
/* Lays out from its top edge so it cannot ride up into the sub-line. */
.hero-feats-right { flex: 1 1 auto; justify-content: flex-start; }
.hero-feats li { display: flex; align-items: center; gap: 11px; }
.hero-feats .ic {
  flex: none; width: clamp(34px, 3.4vw, 44px); height: clamp(34px, 3.4vw, 44px); border-radius: 50%;
  border: 1px solid rgba(255,255,255,.30);
  display: grid; place-items: center; color: #fff;
}
.hero-feats .ic svg { width: 46%; height: 46%; }
.hero-feats div { display: flex; flex-direction: column; line-height: 1.25; }
.hero-feats strong { color: var(--blue-500); font-size: clamp(13px, 1.1vw, 16.5px); font-weight: 800; }
.hero-feats span { color: rgba(255,255,255,.82); font-size: clamp(11.5px, .92vw, 13.5px); max-width: 10em; }

/* --- CTAs: centred in the clear ground beneath the machines --- */
.hero .container > .hero-cta {
  position: relative; z-index: 3; flex: none;
  display: flex; width: 100%; justify-content: center;
  margin-top: clamp(10px, 1.6vh, 20px);
}
.hero .hero-cta .arw { transition: transform .18s ease; }
.hero .hero-cta .btn:hover .arw { transform: translateX(3px); }
.btn-hero-ghost {
  background: transparent; color: #fff; border-color: rgba(255,255,255,.42);
}
.btn-hero-ghost:hover { border-color: var(--blue-500); background: rgba(19,167,236,.14); }

/* --- Category strip --- */
.hero-cats {
  flex: none;
  /* Narrower than the container and centred, so it reads as a contained
     strip rather than spanning the full width. */
  width: min(100%, 1040px); margin-inline: auto;
  margin-top: clamp(12px, 1.8vh, 24px); padding: clamp(6px, 1vh, 12px) 8px;
  display: grid; grid-template-columns: repeat(4, 1fr);
  border: 1px solid rgba(255,255,255,.14); border-radius: var(--radius-lg);
  background: rgba(255,255,255,.045);
}
.hero-cats > a {
  display: flex; align-items: center; gap: 10px; text-align: left;
  padding: 5px 14px; border-right: 1px solid rgba(255,255,255,.12);
}
.hero-cats > a:last-child { border-right: 0; }
.hero-cats .thumb { flex: none; width: 56px; height: 56px; display: grid; place-items: center; overflow: hidden; }
.hero-cats .thumb img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
.hero-cats .thumb-tile {
  border-radius: var(--radius-sm); background: rgba(19,167,236,.16);
  border: 1px solid rgba(19,167,236,.34); color: var(--blue-400);
}
.hero-cats .thumb-tile svg { width: 26px; height: 26px; }
.hero-cats .txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.hero-cats strong { color: var(--blue-500); font-size: 13.5px; font-weight: 800; letter-spacing: .01em; }
.hero-cats .txt > span { color: rgba(255,255,255,.80); font-size: 11.8px; line-height: 1.28; }
.hero-cats .go { color: rgba(255,255,255,.62); font-size: 11.5px; font-weight: 700; margin-top: 3px; transition: color .16s ease; }
.hero-cats > a:hover .go { color: var(--blue-400); }

/* --- Closing stat row --- */
/* --- Stats strip: its own band directly below the hero --- */
.stats-strip {
  background: #001b2c;
  border-top: 1px solid rgba(255,255,255,.08);
  padding: 22px 0;
  color: #fff;
}
.hero-stats { display: grid; grid-template-columns: repeat(5, 1fr); }
.hero-stats > div { display: flex; align-items: center; justify-content: center; gap: 12px; text-align: left; padding: 4px 12px; border-right: 1px solid rgba(255,255,255,.12); }
.hero-stats > div:last-child { border-right: 0; }
.hero-stats .ic { flex: none; color: var(--blue-500); }
.hero-stats .ic svg { width: 34px; height: 34px; }
.hero-stats div div { display: flex; flex-direction: column; line-height: 1.25; }
.hero-stats strong { color: #fff; font-size: 17px; font-weight: 800; }
.hero-stats span { color: rgba(255,255,255,.70); font-size: 12.5px; }

/* page hero (inner pages) */
.page-hero { background: var(--gradient-deep); color: #fff; padding: 58px 0 68px; text-align: center; }
.page-hero h1 { color: #fff; font-size: clamp(28px, 3.6vw, 44px); }
.page-hero p { color: rgba(255,255,255,.9); max-width: 640px; margin: 0 auto 22px; font-size: 16.5px; }
.breadcrumb { font-size: 13px; color: rgba(255,255,255,.8); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,.85); font-weight: 600; }
.breadcrumb a:hover { text-decoration: underline; }
.breadcrumb .sep { margin: 0 6px; opacity: .6; }
.page-hero .hero-cta { justify-content: center; }

/* ---------- Trust bar ---------- */
.trust-bar { background: var(--gradient-deep); color: #fff; padding: 16px 0; }
.trust-bar .container { display: flex; flex-wrap: wrap; gap: 14px 34px; align-items: center; justify-content: center; font-size: 13.5px; font-weight: 700; letter-spacing: .02em; }
.trust-bar .dot { color: var(--blue-300); }

/* ---------- Cards / grids ---------- */
.grid { display: grid; gap: 26px; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.need-card {
  background: var(--white); border: 1px solid var(--blue-100); border-radius: var(--radius-lg);
  padding: 30px 26px; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease;
}
.need-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.need-card .icon { width: 54px; height: 54px; border-radius: 16px; background: var(--blue-100); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; color: var(--blue-700); }
.need-card .icon svg { width: 26px; height: 26px; }
.need-card h3 { font-size: 18.5px; }
.need-card a.link { font-weight: 700; font-size: 14px; color: var(--blue-600); display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; }

.product-card {
  background: var(--white); border: 1px solid var(--blue-100); border-radius: var(--radius-lg);
  overflow: hidden; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease; display: flex; flex-direction: column;
}
.product-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
.product-card .thumb { aspect-ratio: 4/3.1; overflow: hidden; background: var(--blue-50); }
.product-card .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
.product-card:hover .thumb img { transform: scale(1.06); }
.product-card .body { padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
.product-card .cat-tag { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: var(--blue-600); margin-bottom: 6px; }
.product-card h3 { font-size: 18px; margin-bottom: 6px; }
.product-card p.desc { font-size: 13.8px; color: var(--ink-500); margin-bottom: 14px; flex: 1; }
.spec-chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
.spec-chip { font-size: 11.5px; font-weight: 700; background: var(--blue-100); color: var(--blue-700); padding: 5px 10px; border-radius: var(--radius-pill); }
.product-card .card-actions { display: flex; gap: 8px; margin-top: auto; }
.product-card .card-actions .btn { flex: 1; padding: 11px 12px; font-size: 13px; }

/* feature list */
.feature-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 24px; }
.feature-list li { display: flex; gap: 10px; align-items: flex-start; font-weight: 600; font-size: 14.5px; color: var(--ink-900); }
.feature-list li .chk { flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--blue-600); color: #fff; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
.feature-list li .chk svg { width: 11px; height: 11px; }

.why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
.why-item { text-align: center; padding: 26px 16px; }
.why-item .icon { width: 58px; height: 58px; margin: 0 auto 14px; border-radius: 50%; background: var(--blue-100); display: flex; align-items: center; justify-content: center; color: var(--blue-700); }
.why-item .icon svg { width: 26px; height: 26px; }
.why-item h4 { font-size: 15.5px; margin-bottom: 6px; }
.why-item p { font-size: 13.5px; margin: 0; }

/* split (domestic vs commercial etc.) */
.split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.split-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; min-height: 300px; display: flex; align-items: flex-end; box-shadow: var(--shadow-md); }
.split-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.split-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(23,32,38,.86), rgba(23,32,38,.15) 60%); }
.split-card .content { position: relative; z-index: 2; padding: 30px; color: #fff; }
.split-card h3 { color: #fff; font-size: 24px; }
.split-card p { color: rgba(255,255,255,.85); }

/* steps */
.steps-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: step; }
.step { text-align: center; padding: 20px; position: relative; }
.step .num { width: 42px; height: 42px; border-radius: 50%; background: var(--blue-600); color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
.step h4 { font-size: 15px; margin-bottom: 4px; }
.step p { font-size: 13px; }

/* testimonial */
.testimonial-card { background: var(--white); border: 1px solid var(--blue-100); border-radius: var(--radius-lg); padding: 26px; box-shadow: var(--shadow-sm); }
.testimonial-card .stars { color: var(--gold); font-size: 15px; margin-bottom: 10px; letter-spacing: 2px; }
.testimonial-card .who { display: flex; align-items: center; gap: 12px; margin-top: 16px; }
.testimonial-card .avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--blue-200); color: var(--blue-800); display: flex; align-items: center; justify-content: center; font-weight: 800; }
.testimonial-card .who strong { display: block; font-size: 14px; }
.testimonial-card .who span { font-size: 12.5px; color: var(--ink-500); }
.testimonial-empty { text-align: center; padding: 40px 20px; border: 1.5px dashed var(--blue-300); border-radius: var(--radius-lg); color: var(--ink-500); font-size: 14.5px; }

/* CTA band */
.cta-band { background: var(--gradient-sheen); color: #fff; border-radius: var(--radius-lg); padding: 56px 40px; text-align: center; }
.cta-band h2 { color: #fff; font-size: clamp(24px, 3vw, 34px); }
.cta-band p { color: rgba(255,255,255,.88); max-width: 560px; margin: 0 auto 26px; }
.cta-band .hero-cta { justify-content: center; }

/* ---------- Filters / product listing ---------- */
.filter-bar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px; align-items: center; justify-content: space-between; }
.filter-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.filter-pill { padding: 9px 18px; border-radius: var(--radius-pill); border: 1.5px solid var(--blue-200); font-weight: 700; font-size: 13.5px; color: var(--ink-700); background: var(--white); }
.filter-pill.active, .filter-pill:hover { background: var(--blue-600); color: #fff; border-color: var(--blue-600); }
.search-box { display: flex; align-items: center; gap: 8px; border: 1.5px solid var(--blue-200); border-radius: var(--radius-pill); padding: 9px 16px; min-width: 240px; background: #fff; }
.search-box input { border: none; outline: none; font-size: 14px; flex: 1; }
.search-box svg { width: 16px; height: 16px; color: var(--ink-500); flex: none; }
.no-results { text-align: center; padding: 60px 20px; color: var(--ink-500); display: none; }

/* ---------- Product Detail Page ---------- */
.pd-top { padding: 42px 0 20px; }
.pd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: flex-start; }
.pd-gallery img { width: 100%; border-radius: var(--radius-lg); border: 1px solid var(--blue-100); box-shadow: var(--shadow-sm); }
.pd-gallery .cap { text-align: center; font-size: 12.5px; color: var(--ink-500); margin-top: 10px; }
.pd-info .cat-tag { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--blue-600); }
.pd-info h1 { font-size: clamp(26px, 3vw, 36px); margin-top: 8px; }
.pd-info .tagline { font-size: 16px; color: var(--ink-500); margin-bottom: 18px; }
.pd-info .model-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 22px; }
.model-chip { background: var(--blue-100); color: var(--blue-800); font-weight: 800; font-size: 13px; padding: 8px 14px; border-radius: var(--radius-sm); }
.pd-info .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 22px 0; }
.pd-info .mini-note { font-size: 13px; color: var(--ink-500); background: var(--blue-50); border: 1px solid var(--blue-100); padding: 12px 16px; border-radius: var(--radius-sm); }

.spec-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
.spec-table th, .spec-table td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--blue-100); }
.spec-table th { background: var(--blue-700); color: #fff; font-weight: 700; }
.spec-table tbody tr:nth-child(even) { background: var(--blue-50); }
.spec-table td:first-child { font-weight: 700; color: var(--ink-900); white-space: nowrap; }
.spec-table-wrap { overflow-x: auto; border-radius: var(--radius-md); border: 1px solid var(--blue-100); }

.fit-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
.fit-pill { background: var(--blue-50); border: 1px solid var(--blue-100); border-radius: var(--radius-md); padding: 16px 12px; text-align: center; font-size: 13px; font-weight: 700; color: var(--blue-800); }

.related-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

/* ---------- Compare ---------- */
.compare-select-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 30px; }
.compare-select { border: 1.5px solid var(--blue-200); border-radius: var(--radius-md); padding: 12px 14px; font-size: 14.5px; font-weight: 600; background: #fff; width: 100%; }
.compare-table-wrap { overflow-x: auto; }
.compare-table { width: 100%; border-collapse: collapse; min-width: 720px; }
.compare-table th, .compare-table td { padding: 14px 18px; border-bottom: 1px solid var(--blue-100); font-size: 14px; text-align: left; }
.compare-table th { background: var(--blue-50); position: sticky; top: 0; }
.compare-table th.attr-col { width: 190px; color: var(--ink-500); font-weight: 700; background: #fff; }
.compare-table td.attr { font-weight: 700; color: var(--ink-700); background: var(--blue-50); }
.compare-table .prod-head img { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; margin-bottom: 8px; }
.compare-table .prod-head strong { display: block; font-size: 14.5px; }

/* ---------- FAQ ---------- */
.faq-cat-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 34px; }
.faq-item { border: 1px solid var(--blue-100); border-radius: var(--radius-md); margin-bottom: 12px; overflow: hidden; background: #fff; }
.faq-item summary { padding: 18px 22px; font-weight: 700; font-size: 15px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: "+"; font-size: 22px; color: var(--blue-600); font-weight: 400; }
.faq-item[open] summary::after { content: "–"; }
.faq-item .a { padding: 0 22px 20px; color: var(--ink-700); font-size: 14.5px; }
.faq-group h3 { font-size: 18px; color: var(--blue-700); margin: 34px 0 14px; }
.faq-group:first-child h3 { margin-top: 0; }

/* ---------- Contact ---------- */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: flex-start; }
.form-field { margin-bottom: 16px; }
.form-field label { display: block; font-weight: 700; font-size: 13.5px; margin-bottom: 6px; color: var(--ink-900); }
.form-field input, .form-field select, .form-field textarea {
  width: 100%; padding: 12px 14px; border: 1.5px solid var(--blue-200); border-radius: var(--radius-sm);
  font-size: 14.5px; font-family: inherit; outline: none; background: #fff;
}
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--blue-500); }
.form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.contact-info-card { background: var(--blue-50); border: 1px solid var(--blue-100); border-radius: var(--radius-lg); padding: 26px; margin-bottom: 18px; }
.contact-info-card h4 { font-size: 14px; text-transform: uppercase; letter-spacing: .05em; color: var(--blue-600); margin-bottom: 10px; }
.contact-info-card .val { font-size: 17px; font-weight: 800; color: var(--ink-900); }
.map-embed { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--blue-100); }
.map-embed iframe { width: 100%; height: 320px; border: 0; display: block; }
.form-note { font-size: 12.5px; color: var(--ink-500); margin-top: 10px; }

/* ---------- Blog ---------- */
.blog-card { background: #fff; border: 1px solid var(--blue-100); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
.blog-card .thumb { aspect-ratio: 16/10; background: linear-gradient(135deg, var(--blue-600), var(--blue-300)); display: flex; align-items: center; justify-content: center; }
.blog-card .thumb span { color: #fff; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; opacity: .9; }
.blog-card .body { padding: 20px; }
.blog-card .cat { font-size: 11.5px; font-weight: 800; color: var(--blue-600); text-transform: uppercase; letter-spacing: .05em; }
.blog-card h3 { font-size: 17.5px; margin: 8px 0; }
.blog-card p { font-size: 13.8px; }
.article-body { max-width: 760px; margin: 0 auto; font-size: 16.5px; }
.article-body h2 { font-size: 24px; margin-top: 38px; color: var(--blue-800); }
.article-body h3 { font-size: 19px; margin-top: 26px; }
.article-body ul { margin: 0 0 18px; padding-left: 22px; list-style: disc; }
.article-body li { margin-bottom: 8px; color: var(--ink-700); }
.article-meta { display: flex; gap: 16px; align-items: center; color: var(--ink-500); font-size: 13.5px; margin-bottom: 30px; }

/* ---------- Support ---------- */
.support-card { background: #fff; border: 1px solid var(--blue-100); border-radius: var(--radius-lg); padding: 30px; box-shadow: var(--shadow-sm); text-align: center; }
.support-card .icon { width: 56px; height: 56px; border-radius: 16px; background: var(--blue-100); color: var(--blue-700); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
.support-card .icon svg { width: 26px; height: 26px; }

/* ---------- Timeline (About) ---------- */
.timeline { position: relative; padding-left: 30px; border-left: 3px solid var(--blue-200); }
.timeline-item { position: relative; padding-bottom: 34px; }
.timeline-item::before { content: ""; position: absolute; left: -39px; top: 2px; width: 16px; height: 16px; border-radius: 50%; background: var(--blue-600); border: 3px solid var(--blue-100); }
.timeline-item h4 { font-size: 15.5px; color: var(--blue-700); margin-bottom: 4px; }
.timeline-item p { font-size: 14px; margin: 0; }

/* ---------- Footer ---------- */
.site-footer { background: var(--gradient-deep); color: rgba(255,255,255,.78); padding: 64px 0 0; }
.footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1.2fr; gap: 30px; padding-bottom: 44px; border-bottom: 1px solid rgba(255,255,255,.12); }
.footer-grid h5 { color: #fff; font-size: 13.5px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 16px; }
.footer-grid li { margin-bottom: 10px; font-size: 14px; }
.footer-grid a:hover { color: #fff; }
.footer-brand .logo-mark { color: #fff; border-color: rgba(255,255,255,.5); }
.footer-brand p { color: rgba(255,255,255,.65); font-size: 13.8px; margin-top: 14px; max-width: 280px; }
.footer-social { display: flex; gap: 10px; margin-top: 16px; }
.footer-social a { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.08); display: flex; align-items: center; justify-content: center; }
.footer-social svg { width: 16px; height: 16px; }
.footer-bottom { display: flex; justify-content: space-between; align-items: center; padding: 22px 0; flex-wrap: wrap; gap: 10px; font-size: 12.8px; color: rgba(255,255,255,.55); }
.footer-bottom .legal-links { display: flex; gap: 18px; }

/* ---------- Legal ---------- */
.legal-body { max-width: 800px; margin: 0 auto; }
.legal-body h2 { font-size: 20px; color: var(--blue-800); margin-top: 32px; }
.legal-body p, .legal-body li { color: var(--ink-700); font-size: 14.8px; }
.legal-body ul { padding-left: 20px; list-style: disc; margin-bottom: 16px; }

/* ---------- Utility ---------- */
.mt-0 { margin-top: 0; }
.text-center { text-align: center; }
.tag-list { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
.divider { height: 1px; background: var(--blue-100); margin: 40px 0; }

/* ---------- Responsive ---------- */
@media (max-width: 1080px) {
  .why-grid { grid-template-columns: repeat(2, 1fr); }
  .related-strip { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .fit-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 900px) {
  .main-nav, .header-search-btn { display: none; }
  .hamburger { display: block; }
  .pd-grid, .split-grid, .contact-grid, .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  .steps-row { grid-template-columns: repeat(2, 1fr); }
  /* Hero: content stacks below 900px, so release the one-screen lock and
     let the section take its natural height instead of clipping. */
  .hero { height: auto; min-height: 0; padding: 0 0 40px; }
  /* Stacked layout: the photo moves out of the section background and into
     the stage band itself, so it never sits behind the stacked text. */
  .hero::before { content: none; }
  .hero::after { background: linear-gradient(180deg, rgba(0,26,42,.35) 0%, transparent 40%, rgba(0,22,35,.55) 100%); }
  .hero .container { display: block; height: auto; min-height: 0; }
  /* The stage becomes a plain band showing the photo; the callout lists are
     pushed out below it rather than overlapping it. */
  .hero-stage { display: block; margin: 6px 0 0; padding-top: 60vw; position: relative; min-height: 0; }
  /* The right-hand column unpins and flows under the photo band. The
     sub-line moves to the top of the stage so it still reads directly
     beneath the headline rather than stranded between callouts. */
  .hero-right-col { position: static; display: block; max-height: none; }
  .hero-sub {
    position: absolute; top: 0; left: 0; right: 0; margin: 0;
    text-align: center; width: auto;
  }
  /* Room above the photo band for that line. */
  .hero-stage { padding-top: calc(60vw + 3.4em); }
  .hero-stage::before { top: 3.4em; }
  /* Photo lives on its own layer so the feather mask never touches the
     callout lists that follow it. */
  .hero-stage::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 60vw;
    background: url("../images/Home%20page/hero%20section.png") no-repeat 50% 50% / contain;
    -webkit-mask-image: linear-gradient(to bottom, #000 66%, transparent 98%),
                        linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
            mask-image: linear-gradient(to bottom, #000 66%, transparent 98%),
                        linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
            mask-composite: intersect;
  }
  .hero h1 { font-size: clamp(38px, 9vw, 72px); }
  /* Unpin the overlaid callouts and let them stack under the shot. */
  .hero-feats, .hero-feats-left, .hero-feats-right {
    position: static; transform: none; top: auto; bottom: auto; left: auto; right: auto;
  }
  .hero-feats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 16px; margin-top: 24px; }
  .hero-feats-right { margin-top: 20px; }
  .hero-feats span { max-width: none; }
  /* Callouts now sit below the shot, so the CTA pull-up no longer applies. */
  .hero .hero-cta { margin-top: 28px; }
  .hero-cats { grid-template-columns: 1fr 1fr; gap: 6px 0; }
  .hero-cats > a:nth-child(2n) { border-right: 0; }
  .hero-stats { grid-template-columns: repeat(3, 1fr); gap: 16px 0; }
  .hero-stats > div:nth-child(3n) { border-right: 0; }
  .compare-select-row { grid-template-columns: 1fr; }
  .mobile-bar { display: block; }
  .float-wa { bottom: 76px; }
  body { padding-bottom: 0; }
  .form-row-2 { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .why-grid, .related-strip { grid-template-columns: 1fr 1fr; }
  .feature-list { grid-template-columns: 1fr; }
  .fit-grid { grid-template-columns: repeat(2, 1fr); }
  .section { padding: 48px 0; }
  .footer-grid { grid-template-columns: 1fr; }
  .hero-feats { grid-template-columns: 1fr; gap: 16px; }
  .hero-cats { grid-template-columns: 1fr; }
  .hero-cats > a { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.12); padding: 12px 16px; }
  .hero-cats > a:last-child { border-bottom: 0; }
  .hero-stats { grid-template-columns: 1fr 1fr; }
  .hero-stats > div:nth-child(2n) { border-right: 0; }
}

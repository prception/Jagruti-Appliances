  .menu-items { padding-top: 2em; }
  .link-item_links { padding-left: 2em; }
  .link-item_links .nav-link strong { font-size: 1.25em; }
}
@media (max-width: 600px) {
  /* The label is redundant next to the icon once space is tight, so the bar
     is left as the icon and the centred logo. */
  .menu-btn-wrap .menu-text { display: none; }
  /* Icon + logo + WhatsApp pill share a narrow bar, so the lockup steps down
     rather than squeezing the action off the edge. */
  .logo-img { height: 34px; }
  .icon-36 { width: 1.9em; height: 1.9em; }
  /* Narrower slide so the shifted title still clears the panel edge. */
  .menu-link-heading:hover .menu-link-title,
  .menu-link-heading:focus-visible .menu-link-title,
  .link-item.is-open .menu-link-title { transform: translateX(2.6rem); }
  .link-item_links { padding-left: 1.25em; }
  .link-item_links .nav-link strong { font-size: 1.1em; }
  .menu-items { padding-top: 1.5em; }
  .menu-bottom-links-group { flex-direction: column; align-items: flex-start; gap: 1em; padding-top: 1.5em; }
}
/* Short viewports (landscape phones): the panel scrolls rather than the rows
   compressing into each other. */
@media (max-height: 600px) {
  .menu-items { padding-top: .75em; }
  .menu-link-heading { padding: .3em 0 .35em; }
  .icon-36 { width: 1.75em; height: 1.75em; }
}

@media (prefers-reduced-motion: reduce) {
  /* JS settles on the last scene and adds no further classes; everything
     here just removes the movement and shows that scene's resting state. */
  .js .hero-scene .hl,
  .js .hero-plate,
  .js .hero-copy,
  .js .hero-scene { animation: none !important; }
  .js .hero-plate { transform: none; }
  .js .hero-scene .hl { opacity: 1; }
  .js .hero-leafframe .hlf { animation: none !important; opacity: 1; }
  /* All four corners now settle at the desktop leaf plane's resting 1.10;
     only each plate's own mirror still has to survive. */
  .js .hero-leafframe .hlf-tl { transform: scale(1.10); }
  .js .hero-leafframe .hlf-tr { transform: scaleX(-1) scale(1.10); }
  .js .hero-leafframe .hlf-bl { transform: scaleX(-1) scale(1.10); }
  .js .hero-leafframe .hlf-br { transform: scale(1.10); }
  .js .hero-scene.is-current { visibility: visible; transform: none; }
  .js .hero-copy.is-current { opacity: 1; transform: translateY(-50%); }
  .hero-scrollcue .hs-arrow { animation: none; }
}
/* In the portrait layout the copy is not vertically centred, so the -50%
   above would lift it off its box. */
@media (prefers-reduced-motion: reduce) and (max-aspect-ratio: 1/1) and (max-width: 1024px) {
  .js .hero-copy.is-current { transform: none; }
}

/* Landscape phones and small tablets still crop; nudge the focal point up so
   the juicer and the burst sit inside the frame rather than the floor. */
@media (min-aspect-ratio: 1/1) and (max-width: 900px) {
  .hero-scene .hl { object-position: 50% 42%; }
}


/* ---------- Hero (homepage — layered parallax stage) ----------
   The section is a full-viewport stage holding three layered scenes. Each
   scene is a stack of 1920x1080 PNGs exported on one shared canvas, so
   stacking them at inset:0 with object-fit:cover reproduces the source
   composite exactly. Depth comes from how the layers move, not where they
   sit.                                                                   */
.hero {
  position: relative;
  background: #002032;
  color: #fff;
  overflow: hidden;
  padding: 0 0 18px;
  text-align: left;
  height: 100svh;
  min-height: 620px;
}
.hero .container {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding-top: calc(var(--header-h) * 2 - 24px);
  gap: 0;
}
.hero::before {
  content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
  background: url("../images/Home%20page/page%20background.png") no-repeat 50% 58% / cover;
}
.hero::after {
  content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
  background:
    linear-gradient(90deg, rgba(0,28,45,.80) 0%, rgba(0,28,45,.30) 20%, transparent 32%,
                           transparent 68%, rgba(0,28,45,.30) 80%, rgba(0,28,45,.80) 100%),
    linear-gradient(180deg, rgba(0,30,48,.42) 0%, transparent 24%, transparent 72%, rgba(0,26,42,.48) 100%);
}
.hero .container { position: relative; z-index: 1; }

/* ===================================================================
   HERO PARALLAX STAGE
   =================================================================== */
/* Matched to the average colour along the scene artwork's top and bottom
   edges (~rgb(85,155,205)), not the pale sky. Anything that ever shows
   between or behind the scenes then reads as part of the picture rather
   than as a light gap. */
.hero-parallax { background: #559bcd; }
/* The photographic layers replace the old single background image; only the
   left-column scrim below is kept, and it is redefined further down. */
.hero-parallax::after { content: none; }

.hero-stagewrap {
  position: absolute; inset: 0; z-index: 0;
  /* Not pointer-events:none - the scenes carry real CTA links. The
     decorative layers opt out individually instead (see .hl). */
  overflow: hidden;
  perspective: 1200px;
  transform-style: preserve-3d;
}
/* Layers are deliberately over-scaled (1.03 - 1.10) to hide their edges, so
   a scene PARKED below the frame would poke back up into view as a strip -
   hence the clip. But the clip must not apply to a scene that is on screen:
   while the outgoing scene scales up during a handover, clipping it to its
   own box cropped its over-scaled artwork and let the section ground show
   as a flat band along the top edge. Only parked scenes are clipped. */
.hero-scene { position: absolute; inset: 0; overflow: hidden; }
/* An ENTERING scene must clip: its plate counter-translates upward, so
   without the clip the artwork would spill above the window instead of
   being revealed by it. A current or leaving scene must NOT clip, or its
   deliberately over-scaled layers get cropped and the section ground shows
   through at the edges. */
.hero-scene.is-current,
.hero-scene.is-leaving { overflow: visible; }
.hero-scene.is-entering { overflow: hidden; }
.hero-scene .hl {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: 50% 50%;
  will-change: transform, opacity;
  backface-visibility: hidden;
  /* Decorative artwork must never swallow clicks aimed at the copy's CTA. */
  pointer-events: none;
}

/* Resting scales per plane. Held by each entrance animation's `both` fill;
   there is no ambient drift loop - every scene comes to a complete stop.

   Every plane rests at 1: the layers are exports of ONE shared 1920x1080
   canvas, so they reproduce the art director's full-view composite only when
   none of them is scaled relative to the others. Verified by rendering the
   hero against each scene's `full view` reference across a scale sweep -
   agreement peaks at 1 on all three scenes and falls off either side. */
.hl-bg      { transform: scale(1); }
.hl-leaf    { transform: scale(1); }
.hl-juicer,
.hl-blender,
.hl-grinder { transform: scale(1); }
.hl-fruitL, .hl-fruitR,
.hl-bowlL,  .hl-bowlR,
.hl-spiceL, .hl-spiceR { transform: scale(1); }

/* The portrait-only leaf frame (see index.html). Desktop keeps the leaf
   plane that ships inside each scene's own canvas, so this stays off here. */
.hero-leafframe { display: none; }

/* --- Scene stacking and state ---------------------------------------
   The sequence is driven by JS (initHeroScenes in main.js), not by a fixed
   CSS timeline, so the scene indicator can jump straight to any scene on
   click. JS owns exactly one class per scene:

     .is-current   on screen, holding its landed state
     .is-entering  climbing up from below (scenes reached going forwards)
     .is-leaving   easing back while the next scene covers it
     (no class)    parked out of frame, not painted

   Stacking is set inline by JS as well, so whichever scene is arriving is
   always above the one it replaces - a fixed z-index order cannot express
   that when the user can jump backwards. */
.js .hero-scene { visibility: hidden; }
.js .hero-scene.is-current,
.js .hero-scene.is-entering,
.js .hero-scene.is-leaving { visibility: visible; }

/* Deliberately no opacity interpolation on the climb: animating opacity on
   the scene composites its layers as one translucent group, so the scene
   underneath shows through the incoming scene's own opaque sky and it reads
   as a pane of glass sliding up. Pure transform keeps the group opaque, and
   each background PNG (verified 100% alpha) occludes by itself. */
/* The scene slides up, but the ARTWORK INSIDE IT DOES NOT MOVE.
   The scene box is the window; .hero-plate inside it runs the exact
   opposite translate, cancelling the scene's movement so the picture stays
   pinned to the viewport while the window uncovers it from the bottom up.
   The image is revealed rather than carried along - the incoming scene
   reads as already in place behind the outgoing one, and only the edge
   between them travels. Both must share duration and easing exactly, or
   the artwork visibly drifts. */
.hero-plate { position: absolute; inset: 0; }
.js .hero-scene.is-entering {
  animation: heroSceneUp 1200ms cubic-bezier(.22,.7,.24,1) both;
}
.js .hero-scene.is-entering .hero-plate {
  animation: heroPlateHold 1200ms cubic-bezier(.22,.7,.24,1) both;
}
/* The climb distance is a variable rather than a literal 100%: on portrait
   the stage is SHORTER than the section (it carries the artwork's own 16:9),
   so 100% of the scene box stops the reveal partway up the screen. There it
   is overridden with a distance measured against the section instead. */
:root { --scene-travel: 100%; }
@keyframes heroSceneUp {
  from { transform: translateY(var(--scene-travel)); }
  to   { transform: translateY(0); }
}
@keyframes heroPlateHold {
  from { transform: translateY(calc(-1 * var(--scene-travel))); }
  to   { transform: translateY(0); }
}
/* The outgoing scene pushes AWAY from the viewer rather than shrinking on
   screen. Scaling it below 1 shrank it inside its own box and exposed a
   band of the section's pale ground at the top and bottom edges - visible
   as a light gap for the whole 1.2s climb. Scaling UP keeps it covering the
   frame edge to edge while still reading as receding behind the arriving
   scene, and a small downward drift adds the parallax. */
.js .hero-scene.is-leaving {
  animation: heroSceneOut 1200ms cubic-bezier(.4,0,.2,1) both;
}
@keyframes heroSceneOut {
  from { transform: scale(1)     translateY(0); }
  to   { transform: scale(1.045) translateY(1.5%); }
}
.js .hero-scene.is-current { transform: none; }

/* The first scene on load has nothing to climb over, so it just appears and
   its layers play their own entrance. */
.js .hero-scene.is-current.is-first { animation: none; }

/* --- Layer entrances -------------------------------------------------
   Delays are now relative to the scene becoming active, not to page load,
   so a scene plays the same beat whenever it is reached - on the timer or
   from a click on the indicator. The whole set is keyed off the scene's
   state class, so re-adding that class replays the entrance.

   Per-scene beat:
     +0     background settles its scale
     +320   product rises onto the podium
     +560   foreground leaves sweep in
     +860   left cluster bursts from behind the product
     +1000  right cluster follows                                        */
.js .hero-scene .hl { opacity: 0; }
/* An outgoing scene keeps its layers fully painted at their landed state.
   Without this they fall back to the transparent default the moment the
   scene stops being current, and the section ground shows through the strip
   the arriving scene has not climbed over yet - a flat blue band along the
   top edge for the whole handover. */
.js .hero-scene.is-leaving .hl { opacity: 1; animation: none; }

/* Backgrounds. Scene 1 on first load fades up from nothing; any scene that
   arrives by climbing must NOT fade, or the scene below shows through its
   own sky and the rise reads as a translucent pane. */
@keyframes heroBgIn   { from { opacity: 0; transform: scale(1.08); }
                        to   { opacity: 1; transform: scale(1); } }
@keyframes heroBgHold { from { opacity: 1; transform: scale(1.04); }
                        to   { opacity: 1; transform: scale(1); } }
.js .hero-scene.is-current .hl-bg,
.js .hero-scene.is-entering .hl-bg {
  animation: heroBgHold 1100ms cubic-bezier(.22,.61,.36,1) both;
}
.js .hero-scene.is-first .hl-bg {
  animation: heroBgIn 1100ms cubic-bezier(.22,.61,.36,1) both;
}

/* Products. */
@keyframes heroJuicerIn {
  from { opacity: 0; transform: translateY(9%) scale(.90); }
  to   { opacity: 1; transform: translateY(0)  scale(1); }
}
/* The blender stands rather than sits, so it rises a little further. */
@keyframes heroBlenderIn {
  from { opacity: 0; transform: translateY(11%) scale(.88); }
  to   { opacity: 1; transform: translateY(0)   scale(1); }
}
@keyframes heroGrinderIn {
  from { opacity: 0; transform: translateY(9%) scale(.90); }
  to   { opacity: 1; transform: translateY(0)  scale(1); }
}
.js .hero-scene.is-current .hl-blender,
.js .hero-scene.is-entering .hl-blender {
  animation: heroBlenderIn 1000ms cubic-bezier(.2,.8,.25,1) 320ms both;
}
.js .hero-scene.is-current .hl-juicer,
.js .hero-scene.is-entering .hl-juicer {
  animation: heroJuicerIn 1000ms cubic-bezier(.2,.8,.25,1) 320ms both;
}
.js .hero-scene.is-current .hl-grinder,
.js .hero-scene.is-entering .hl-grinder {
  animation: heroGrinderIn 1000ms cubic-bezier(.2,.8,.25,1) 320ms both;
}

/* Foreground leaves. */
@keyframes heroLeafIn { from { opacity: 0; transform: scale(1.09); }
                        to   { opacity: 1; transform: scale(1); } }
.js .hero-scene.is-current .hl-leaf,
.js .hero-scene.is-entering .hl-leaf {
  animation: heroLeafIn 1200ms cubic-bezier(.22,.61,.36,1) 560ms both;
}

/* --- The burst -------------------------------------------------------
   Cued at 320ms, the same moment the machine begins rising, so the splash
   and the product arrive together rather than the splash trailing it. The
   right cluster keeps a small 80ms offset behind the left purely so the two
   sides do not read as one symmetrical pop.

   Every cluster shares duration, easing and start scale. Only the travel
   distance differs, and it is set per cluster from that artwork's
   visual mass: the bowls carry ~82k opaque px, the fruit ~33k and the
   spices ~24k, so identical percentages would move very different amounts
   of material and read as very different energy. Lighter clusters travel
   further to land with the same weight.

   Scene 1 is the exception: its splash is a single centred plate rather
   than a left/right pair, so it has no side to travel from and expands
   from the centre instead (see heroBowlLeftIn). It still takes the 320ms
   cue, so all three scenes start their burst on the same beat. */
.js .hero-scene.is-current .hl-bowlL,
.js .hero-scene.is-entering .hl-bowlL {
  animation: heroBowlLeftIn 1150ms cubic-bezier(.16,.9,.3,1.06) 320ms both;
}
.js .hero-scene.is-current .hl-bowlR,
.js .hero-scene.is-entering .hl-bowlR {
  animation: heroBowlRightIn 1150ms cubic-bezier(.16,.9,.3,1.06) 400ms both;
}
.js .hero-scene.is-current .hl-fruitL,
.js .hero-scene.is-entering .hl-fruitL {
  animation: heroFruitLeftIn 1150ms cubic-bezier(.16,.9,.3,1.06) 320ms both;
}
.js .hero-scene.is-current .hl-fruitR,
.js .hero-scene.is-entering .hl-fruitR {
  animation: heroFruitRightIn 1150ms cubic-bezier(.16,.9,.3,1.06) 400ms both;
}
.js .hero-scene.is-current .hl-spiceL,
.js .hero-scene.is-entering .hl-spiceL {
  animation: heroSpiceLeftIn 1150ms cubic-bezier(.16,.9,.3,1.06) 320ms both;
}
.js .hero-scene.is-current .hl-spiceR,
.js .hero-scene.is-entering .hl-spiceR {
  animation: heroSpiceRightIn 1150ms cubic-bezier(.16,.9,.3,1.06) 400ms both;
}

/* Burst keyframes. Every cluster shares duration, easing, stagger and start
   scale; only travel distance differs, set per cluster from that artwork's
   visual mass (bowls ~82k opaque px, fruit ~33k, spices ~24k). Identical
   percentages would move very different amounts of material and read as
   very different energy, so lighter clusters travel further. */
/* Scene 1's splash is ONE centred plate, not a left/right pair, so it cannot
   burst sideways the way the fruit and spice clusters do - a lateral travel
   on a centred plate reads as the whole splash sliding in from one side,
   which is what made this scene look unlike the other two. It expands from
   the centre instead: no translate, no rotation, so the material opens
   outward symmetrically around the machine. Duration, easing and the 320ms
   cue are the shared ones, and the start scale sits between the paired
   clusters' .34-.39 so the opening covers the same visual distance. */
@keyframes heroBowlLeftIn {
  0%   { opacity: 0; transform: translate(0, 0) scale(.37); }
  38%  { opacity: 1; }
  100% { opacity: 1; transform: translate(0, 0) scale(1); }
}
@keyframes heroBowlRightIn {
  0%   { opacity: 0; transform: translate(-6.3%, 8%) scale(.39) rotate(7deg); }
  38%  { opacity: 1; }
  100% { opacity: 1; transform: translate(0, 0)      scale(1) rotate(0deg); }
}
@keyframes heroFruitLeftIn {
  0%   { opacity: 0; transform: translate(12.5%, 11%) scale(.34) rotate(-11deg); }
  38%  { opacity: 1; }
  100% { opacity: 1; transform: translate(0, 0)       scale(1) rotate(0deg); }
}
@keyframes heroFruitRightIn {
  0%   { opacity: 0; transform: translate(-11.2%, 10%) scale(.34) rotate(10deg); }
  38%  { opacity: 1; }
  100% { opacity: 1; transform: translate(0, 0)        scale(1) rotate(0deg); }
}
/* Spices are the lightest clusters of the three, so they travel furthest. */
@keyframes heroSpiceLeftIn {
  0%   { opacity: 0; transform: translate(12%, 11%) scale(.34) rotate(-11deg); }
  38%  { opacity: 1; }
  100% { opacity: 1; transform: translate(0, 0)     scale(1) rotate(0deg); }
}
@keyframes heroSpiceRightIn {
  0%   { opacity: 0; transform: translate(-11.3%, 10%) scale(.34) rotate(10deg); }
  38%  { opacity: 1; }
  100% { opacity: 1; transform: translate(0, 0)        scale(1) rotate(0deg); }
}

/* ================= PER-SCENE COPY =================
   Each scene carries its own headline and CTA, pinned to the left column so
   it never crosses the centre band where the product sits and the splash
   animates. Type is kept small deliberately - the artwork is the hero. */
/* Soft vignette behind the left column only. The artwork's sky is bright,
   so without this the accent line and body text wash out. It darkens the
   copy column while leaving the centre band untouched. */
.hero-parallax::before {
  content: ""; position: absolute; inset: 0; z-index: 4;
  pointer-events: none;
  background: linear-gradient(90deg,
    rgba(0,28,46,.72) 0%, rgba(0,28,46,.55) 18%,
    rgba(0,28,46,.22) 34%, transparent 48%);
}
.hero-copy {
  position: absolute; z-index: 5;
  left: var(--gutter);
  top: 50%; transform: translateY(-50%);
  width: min(38%, 430px);
  text-align: left;
  color: #fff;
  text-shadow: 0 1px 16px rgba(0,32,52,.55), 0 1px 3px rgba(0,32,52,.5);
}
.hc-eyebrow {
  margin: 0 0 .5em;
  font-size: var(--fs-label); font-weight: var(--fw-label);
  letter-spacing: var(--ls-label-tight); text-transform: none;
  color: rgba(255,255,255,.86);
}
.hc-title {
  margin: 0 0 .5em;
  font-size: clamp(24px, 2.9vw, 46px);
  /* 700 to match the h1–h6 system. This class sets its own weight rather
     than inheriting it, so it has to be changed here too. */
  font-weight: 700; line-height: 1.08; letter-spacing: -.02em;
  color: #fff;
}
/* Brighter than --blue-400, which vanished against the sky. */
.hc-title .accent { color: #7fd4ff; }
.hc-sub {
  margin: 0 0 1.4em;
  font-size: clamp(13px, 1.05vw, 16px); line-height: 1.5;
  color: rgba(255,255,255,.90);
  max-width: 30em;
}
/* Deliberately smaller than the site's standard .btn so it sits inside the
   scene without competing with the product. */
.hc-cta {
  display: inline-flex; align-items: center; gap: .5em;
  padding: .72em 1.5em; border-radius: 999px;
  background: var(--blue-500); color: #fff;
  /* Keeps its fluid size — this pill sits in the absolutely-positioned
     hero overlay, where it has to track the stage rather than the type
     ramp — but takes the shared CTA weight and tracking so it still reads
     as the same family of button as every other one on the site. */
  font-size: clamp(12.5px, .95vw, 15px);
  font-weight: var(--fw-button);
  line-height: var(--lh-button);
  letter-spacing: var(--ls-button);
  text-decoration: none; white-space: nowrap;
  box-shadow: 0 6px 20px rgba(0,40,66,.34);
  transition: background .18s ease, transform .18s ease, box-shadow .18s ease;
}
.hc-cta:hover {
  background: var(--blue-600);
  transform: translateY(-1px);
  box-shadow: 0 9px 26px rgba(0,40,66,.42);
}
.hc-cta .arw { transition: transform .18s ease; }
.hc-cta:hover .arw { transform: translateX(3px); }

/* ================= SCENE INDICATOR + SCROLL CUE ================= */
.hero-dots {
  position: absolute; z-index: 6;
  left: var(--gutter);
  bottom: clamp(18px, 4vh, 44px);
  display: flex; flex-direction: column; gap: .55em;
  font-size: .8125em;
}
/* The indicator doubles as the scene switcher, so each entry is a real
   button: JS marks the active one and clicking jumps to that scene. */
.hero-dots .hd {
  appearance: none; background: none; border: 0;
  font: inherit; text-align: left;
  display: flex; align-items: center; gap: .7em;
  padding: 3px 2px; cursor: pointer; border-radius: 4px;
  color: rgba(255,255,255,.45);
  transition: color .3s ease;
  text-shadow: 0 1px 10px rgba(0,32,52,.5);
}
.hero-dots .hd i {
  width: 2px; height: 14px; border-radius: 2px;
  background: rgba(255,255,255,.32);
  transition: background .3s ease, height .3s ease;
}
.hero-dots .hd:hover { color: rgba(255,255,255,.85); }
.hero-dots .hd:hover i { background: rgba(255,255,255,.6); }
.hero-dots .hd:focus-visible { outline: 2px solid var(--blue-400); outline-offset: 3px; }
.hero-dots .hd.is-current { color: #fff; }
.hero-dots .hd.is-current i { background: var(--blue-400); height: 20px; }

/* Sits in the bottom-right corner, mirroring the scene indicator opposite
   it on the same gutter and baseline. The homepage has no floating
   WhatsApp button, so nothing crowds this corner. Doubles as the "next
   scene" control. */
.hero-scrollcue {
  position: absolute; z-index: 6;
  right: var(--gutter);
  bottom: clamp(18px, 4vh, 44px);
  appearance: none; background: none; border: 0; font: inherit;
  padding: 4px 2px; cursor: pointer; border-radius: 4px;
  display: flex; align-items: center; gap: .8em;
  color: rgba(255,255,255,.82); font-size: .8125em;
  text-shadow: 0 1px 10px rgba(0,32,52,.5);
  transition: color .2s ease;
}
.hero-scrollcue:hover { color: #fff; }
.hero-scrollcue:hover .hs-arrow {
  border-color: rgba(255,255,255,.85);
  background: rgba(255,255,255,.12);
}
.hero-scrollcue:focus-visible { outline: 2px solid var(--blue-400); outline-offset: 3px; }
/* On the last scene there is nothing to advance to. */
.hero-scrollcue[hidden] { display: none; }
.hero-scrollcue .hs-arrow {
  width: 2.2em; height: 2.2em; border-radius: 50%;
  border: 1px solid rgba(255,255,255,.42);
  display: grid; place-items: center;
  animation: hsBob 2.4s ease-in-out infinite;
  transition: border-color .2s ease, background .2s ease;
}
.hero-scrollcue svg { width: 60%; height: 60%; }
@keyframes hsBob {
  0%,100% { transform: translateY(0); }
  50%     { transform: translateY(4px); }
}

.js .hero-copy { opacity: 0; pointer-events: none; }
/* Copy is state-driven like the scenes: JS marks the active one, so it
   plays the same entrance whether the scene was reached on the timer or by
   clicking the indicator. It rides in a beat after its product lands. */
.js .hero-copy.is-current {
  animation: heroCopyIn 900ms cubic-bezier(.22,.7,.24,1) 1250ms both;
  pointer-events: auto;
}
.js .hero-copy.is-leaving {
  animation: heroCopyOut 500ms cubic-bezier(.4,0,.2,1) both;
}
@keyframes heroCopyIn {
  from { opacity: 0; transform: translateY(calc(-50% + 20px)); }
  to   { opacity: 1; transform: translateY(-50%); }
}
@keyframes heroCopyOut {
  from { opacity: 1; transform: translateY(-50%); }
  to   { opacity: 0; transform: translateY(calc(-50% - 14px)); }
}


.hero-eyebrow {
  flex: none; text-align: center;
  font-size: var(--fs-label); font-weight: var(--fw-label); letter-spacing: var(--ls-label-tight); text-transform: none;
  color: rgba(255,255,255,.72); margin-bottom: 8px;
}
.hero-eyebrow .accent { color: var(--blue-500); }

.hero h1 {
  flex: none;
  color: #fff;
  /* Centred so the wordmark sits directly behind the appliances, which are
     centred in the photograph. Capped against viewport height too. */
  text-align: center;
  font-size: min(10.2vw, 15vh, 165px);
  /* Display-scale wordmark: keeps its viewport sizing, but takes the
     system's 700 weight and display tracking like every other heading. */
  font-weight: 700;
  line-height: .95;
  letter-spacing: -.035em;
  margin: 0 0 -.04em;
}
.hero h1 .accent { color: var(--blue-500); }

/* --- Stage: the open band the background products show through, with the
   three feature callouts pinned down either side. It takes the largest share
   of the section height so the columns always have room to sit apart. --- */
/* Sized by its own content — the taller of the two callout columns — so the
   columns always fit inside it and never spill onto the CTA row below. */
.hero-stage {
  position: relative; flex: 1 1 auto;
  display: flex;
  min-height: 0;
}

/* Right edge of the stage is one flex column: the sub-line sits tight to the
   top, directly beneath the headline, with the callouts spaced below it. */
.hero-right-col {
  position: absolute; top: 0; right: 0; bottom: 0; z-index: 2;
  display: flex; flex-direction: column; align-items: flex-start;
  gap: clamp(26px, 5vh, 64px);
}
/* Never allowed to shrink or be crowded by the callouts beneath it. */
.hero-sub {
  flex: none;
  margin: 0; width: max-content; text-align: left;
  font-size: 1.25em; /* 20px */ line-height: 1.4;
  color: rgba(255,255,255,.95); font-weight: 500;
}

/* Grouped tightly rather than spread, matching the approved composition.
   Both columns are bounded by the stage so they can never overhang the CTA
   row below; the gap collapses first when height is tight. */
.hero-feats {
  display: flex; flex-direction: column; justify-content: flex-start;
  gap: clamp(10px, 2.2vh, 30px); text-align: left; min-height: 0;
}
/* The left column is absolute and sits in the upper part of the stage; the
   right one flows inside .hero-right-col beneath the sub-line. */
.hero-feats-left  { position: absolute; z-index: 2; left: 0; top: 4%; bottom: 0; }
/* Lays out from its top edge so it cannot ride up into the sub-line. */
.hero-feats-right { flex: 1 1 auto; justify-content: flex-start; }
.hero-feats li { display: flex; align-items: center; gap: 11px; }
.hero-feats .ic {
  flex: none; width: clamp(34px, 3.4vw, 44px); height: clamp(34px, 3.4vw, 44px); border-radius: 50%;
  border: 1px solid rgba(255,255,255,.30);
  display: grid; place-items: center; color: #fff;
}
.hero-feats .ic svg { width: 46%; height: 46%; }
.hero-feats div { display: flex; flex-direction: column; line-height: 1.25; }
.hero-feats strong { color: var(--blue-500); font-size: 1em; /* 16px */ font-weight: 500; }
.hero-feats span { color: rgba(255,255,255,.82); font-size: var(--fs-label); max-width: 10em; }

/* --- CTAs: centred in the clear ground beneath the machines --- */
.hero .container > .hero-cta {
  position: relative; z-index: 3; flex: none;
  display: flex; width: 100%; justify-content: center;
  margin-top: clamp(10px, 1.6vh, 20px);
}
.hero .hero-cta .arw { transition: transform .18s ease; }
.hero .hero-cta .btn:hover .arw { transform: translateX(3px); }
/* Same glass treatment as .btn-outline on a dark ground — kept as its own
   name because the hero markup uses it, but the values no longer diverge. */
.btn-hero-ghost {
  background: rgba(255,255,255,.07); color: #fff; border-color: rgba(255,255,255,.22);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
}
.btn-hero-ghost:hover { background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.34); }

/* --- Category strip --- */
/* --- CTA row shared by the hero and inner-page bands --- */
.hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }

/* --- Mobile sticky action bar: hidden until the narrow breakpoint --- */
/* Height of the sticky bar, for anything that must sit clear of it. Zero
   until the breakpoint that actually shows the bar. */
:root { --mobile-bar-h: 0px; }
.mobile-bar { display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 55; }
.mobile-bar .row { display: grid; grid-template-columns: 1fr 1fr; }
.mobile-bar a {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  padding: 14px 8px; font-weight: 500; font-size: .9375em; color: #fff;
}
.mobile-bar svg { width: 20px; height: 20px; }
.call-btn { background: var(--blue-700); }
.wa-btn   { background: var(--whatsapp); }

.hero-cats {
  flex: none;
  /* Narrower than the container and centred, so it reads as a contained
     strip rather than spanning the full width. */
  width: min(100%, 1040px); margin-inline: auto;
  margin-top: clamp(12px, 1.8vh, 24px); padding: clamp(6px, 1vh, 12px) 8px;
  display: grid; grid-template-columns: repeat(4, 1fr);
  border: 1px solid rgba(255,255,255,.14); border-radius: var(--radius-lg);
  background: rgba(255,255,255,.045);
}
.hero-cats > a {
  display: flex; align-items: center; gap: 10px; text-align: left;
  padding: 5px 14px; border-right: 1px solid rgba(255,255,255,.12);
}
.hero-cats > a:last-child { border-right: 0; }
.hero-cats .thumb { flex: none; width: 56px; height: 56px; display: grid; place-items: center; overflow: hidden; }
.hero-cats .thumb img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
.hero-cats .thumb-tile {
  border-radius: var(--radius-sm); background: rgba(19,167,236,.16);
  border: 1px solid rgba(19,167,236,.34); color: var(--blue-400);
}
.hero-cats .thumb-tile svg { width: 26px; height: 26px; }
.hero-cats .txt { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.hero-cats strong { color: var(--blue-500); font-size: var(--fs-label); font-weight: var(--fw-label); letter-spacing: var(--ls-body); }
.hero-cats .txt > span { color: rgba(255,255,255,.80); font-size: var(--fs-caption); line-height: var(--lh-tight); }
.hero-cats .go { color: rgba(255,255,255,.62); font-size: var(--fs-caption); font-weight: var(--fw-body); margin-top: 3px; transition: color .16s ease; }
.hero-cats > a:hover .go { color: var(--blue-400); }

/* --- Closing stat row --- */
/* --- Stats strip: its own band directly below the hero --- */
/* Runs on the page canvas with no band of its own, so the figures read as
   part of the page rather than a separate bar. The colour lift on scroll-in
   is what carries the section instead: each stat rises, and its number
   settles from the light brand blue into full ink. */
.stats-strip {
  background: transparent;
  border-top: 0;
  /* Sits in the gap between the hero and Shop By Need. The hero adds no
     padding below itself, but .need-section already contributes
     --section-pad-y above, so the band takes that same value on top and
     nothing on the bottom — that makes the space above and below the
     figures equal on screen, instead of 42px over ~120px. */
  padding-top: var(--section-pad-y);
  padding-bottom: 0;
  color: var(--ink-900);
}
/* A flat trust row, not five cards: the items spread evenly on the page
   canvas and are separated by a hairline dot, so the band stays quiet
   between two heavy sections. */
.stats-strip .stats-eyebrow {
  text-align: center;
  color: var(--ink-500);
  font-size: var(--fs-stat-label);
  font-weight: var(--fw-label);
  letter-spacing: .14em;
  text-transform: uppercase;
  margin: 0 0 22px;
}
.hero-stats {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px 0;
}
.hero-stats > div {
  position: relative;
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  text-align: left;
  padding: 0 4px;
  background: none;
  border: 0;
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}
/* The separator between stats — a single centred dot on the flex gap. */
.hero-stats > div + div::before {
  content: "";
  position: absolute;
  left: -2px;
  top: 50%;
  width: 4px;
  height: 4px;
  margin-top: -2px;
  border-radius: 50%;
  background: var(--ink-500);
  opacity: .32;
}
.hero-stats .ic { flex: none; color: var(--blue-500); }
.hero-stats .ic svg { width: 26px; height: 26px; }
.hero-stats div div { display: flex; flex-direction: column; line-height: 1.25; }
/* The figure has to out-rank its label by size AND weight, or the strip
   reads as five short sentences. It was 17px/600 over a 12.5px label — a
   gap too small to register as a statistic.

   This strip is a five-across icon+text row, not a stacked stat grid, so
   it takes a contained step — 22px/700 over a 13px/500 label. A 40px
   figure would break the five columns, and two of the five entries are
   words ("ISO 9001:2015", "Pan India") rather than short numerals, so the
   size has to hold those without wrapping too. */
.hero-stats strong {
  color: var(--ink-900);
  font-size: 1.0625em;           /* 17px */
  font-weight: var(--fw-title);
  line-height: var(--lh-tight);
  letter-spacing: var(--ls-title);
}
.hero-stats span {
  color: var(--ink-500);
  font-size: .75rem;
  font-weight: var(--fw-label);
  line-height: var(--lh-tight);
}

/* Reveal: the stat lands in brand blue and resolves to ink a beat later, so
   the eye is pulled to the figure as it arrives. The colour transition is
   deliberately slower than the lift and shares the same stagger delay that
   main.js writes onto [data-reveal-child]. Gated on html.js like every other
   reveal, so with JS off the final colours are what render. */
.js .stats-strip[data-reveal] [data-reveal-child] {
  transition: opacity .7s cubic-bezier(.22, .61, .36, 1),
              transform .7s cubic-bezier(.22, .61, .36, 1);
}
.js .stats-strip[data-reveal] [data-reveal-child] strong,
.js .stats-strip[data-reveal] [data-reveal-child] .ic {
  color: var(--blue-500);
  transition: color .9s ease .25s;
}
.js .stats-strip[data-reveal] [data-reveal-child] span { transition: color .9s ease .25s; }
.js .stats-strip[data-reveal].is-revealed [data-reveal-child] strong { color: var(--ink-900); }
.js .stats-strip[data-reveal].is-revealed [data-reveal-child] .ic { color: var(--blue-600); }

/* page hero (inner pages) */
.page-hero { background: var(--gradient-deep); color: #fff; padding: 58px 0 68px; text-align: center; }
.page-hero h1 { color: #fff; font-size: var(--fs-h1); line-height: var(--lh-title); letter-spacing: var(--ls-title); }
.page-hero p { color: rgba(255,255,255,.9); max-width: 640px; margin: 0 auto 22px; font-size: var(--fs-lead); line-height: var(--lh-body); }
.page-hero .hero-cta { justify-content: center; }

/* ---------- Trust bar ---------- */
.trust-bar { background: var(--gradient-deep); color: #fff; padding: 16px 0; }
.trust-bar .container { display: flex; flex-wrap: wrap; gap: 14px 34px; align-items: center; justify-content: center; font-size: var(--fs-label); font-weight: var(--fw-body); letter-spacing: var(--ls-body); }
.trust-bar .dot { color: var(--blue-300); }

/* ---------- Cards / grids ---------- */
.grid { display: grid; gap: 26px; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.need-card {
  background: var(--white); border: 1px solid var(--blue-100); border-radius: var(--radius-lg);
  padding: 30px 26px; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease;
}
.need-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
.need-card .icon { width: 54px; height: 54px; border-radius: 16px; background: var(--blue-100); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; color: var(--blue-700); }
.need-card .icon svg { width: 26px; height: 26px; }
.need-card h3 { font-size: var(--fs-card-title); line-height: var(--lh-card); }
.need-card a.link { font-weight: var(--fw-button); font-size: var(--fs-button); line-height: var(--lh-button); letter-spacing: var(--ls-button); color: var(--blue-600); display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; }

/* ---------- Scroll reveal ----------
   Elements marked [data-reveal] are hidden, then main.js adds .is-revealed
   the first time they scroll into view. Children marked [data-reveal-child]
   get a stagger delay set inline by the script, so a container animates as
   a sequence rather than all at once.
   The hidden state is gated on html.js — main.js sets that class the moment
   it runs, so with JS off or broken nothing is ever hidden and the section
   renders as plain content. Content must not depend on the animation. */
.js [data-reveal] [data-reveal-child] {
  opacity: 0; transform: translateY(28px);
  transition: opacity .7s cubic-bezier(.22, .61, .36, 1),
              transform .7s cubic-bezier(.22, .61, .36, 1);
}
.js [data-reveal].is-revealed [data-reveal-child] { opacity: 1; transform: none; }

/* The photo un-zooms as the tile rises, so each card assembles itself
   instead of simply fading in. This scales the tile's own overflow box, not
   the media element, because .need-tile:hover img/video owns its transform for the
   hover zoom — driving both from one property would have the (much more
   specific) reveal rule permanently override hover. */
.js .need-strip[data-reveal] .need-tile {
  transition: transform 1.1s cubic-bezier(.22, .61, .36, 1),
              opacity .7s cubic-bezier(.22, .61, .36, 1);
}

/* Two Ranges: each card GROWS out of its own top-left corner — the card box
   starts small and its edges sweep outward into the full frame, while the
   photograph inside is counter-scaled so it holds its final size the whole
   way. That combination is what reads as the frame opening up to uncover the
   picture, rather than a small card being magnified. The right card starts
   tighter and offset toward the left one, so the pair spreads out of the
   section's top-left as a single movement.
   These override the generic [data-reveal-child] translateY above (higher
   specificity), and the script's inline transition-delay supplies the ~110ms
   stagger that gives the left card its lead. Transform and opacity only —
   never width/height — so the reveal stays on the compositor. */
.js .split-grid[data-reveal] .split-card {
  transform-origin: top left;
  opacity: 0;
  transform: scale(.42, .55);
  transition: opacity .6s cubic-bezier(.16, 1, .3, 1),
              transform 1.35s cubic-bezier(.16, 1, .3, 1);
  will-change: transform, opacity;
}
/* The photograph and the copy are counter-scaled against the card's own
   scale, anchored to the same top-left corner, so the picture stays at
   (near) its final size while the card's edge sweeps outward across it:
   the frame opens up to uncover the image instead of a shrunken picture
   being blown up. Keeping the photo still is what makes this read as
   unfolding rather than zooming.
   Note both transitions must share one curve and duration — an eased
   inverse of an eased value is not constant, so any mismatch shows up as
   the photo breathing mid-flight. Same curve, same 1.05s, both here and on
   the card above. */
.js .split-grid[data-reveal] .split-card img,
.js .split-grid[data-reveal] .split-card video,
.js .split-grid[data-reveal] .split-card .content {
  transform-origin: top left;
  transform: scale(2.381, 1.8182);  /* 1/.42, 1/.55 */
  transition: transform 1.35s cubic-bezier(.16, 1, .3, 1);
  will-change: transform;
}
/* The copy fades in over the back half of the open, so it never appears
   stretched while the frame is still travelling. */
.js .split-grid[data-reveal] .split-card .content {
  opacity: 0;
  transition: transform 1.35s cubic-bezier(.16, 1, .3, 1),
              opacity .5s ease .55s;
}
/* The right card opens from the same corner but starts a touch tighter and
   offset toward the left card, so the pair reads as one movement spreading
   out of the top-left of the section. */
.js .split-grid[data-reveal] .split-card:nth-child(2) {
  transform: scale(.38, .5) translate3d(-9%, -6%, 0);
}
.js .split-grid[data-reveal] .split-card:nth-child(2) img,
.js .split-grid[data-reveal] .split-card:nth-child(2) video,
.js .split-grid[data-reveal] .split-card:nth-child(2) .content {
  transform: scale(2.6316, 2);  /* 1/.38, 1/.5 */
}
/* Settled: static, and the compositor hints are dropped so no layer is kept
   alive after the entrance. No looping motion is left behind. */
.js .split-grid[data-reveal].is-revealed .split-card,
.js .split-grid[data-reveal].is-revealed .split-card img,
.js .split-grid[data-reveal].is-revealed .split-card video,
.js .split-grid[data-reveal].is-revealed .split-card .content,
.js .split-grid[data-reveal].is-revealed .split-card:nth-child(2),
.js .split-grid[data-reveal].is-revealed .split-card:nth-child(2) img,
.js .split-grid[data-reveal].is-revealed .split-card:nth-child(2) video,
.js .split-grid[data-reveal].is-revealed .split-card:nth-child(2) .content {
  opacity: 1;
  transform: none;
  will-change: auto;
}

@media (prefers-reduced-motion: reduce) {
  .js [data-reveal] [data-reveal-child] {
    opacity: 1 !important; transform: none !important; transition: none !important;
  }
  .js .split-grid[data-reveal] .split-card,
  .js .split-grid[data-reveal] .split-card:nth-child(2),
  .js .split-grid[data-reveal] .split-card img,
  .js .split-grid[data-reveal] .split-card video,
  .js .split-grid[data-reveal] .split-card .content,
  .js .split-grid[data-reveal] .split-card:nth-child(2) img,
  .js .split-grid[data-reveal] .split-card:nth-child(2) video,
  .js .split-grid[data-reveal] .split-card:nth-child(2) .content {
    opacity: 1 !important; transform: none !important; transition: none !important;
  }
  .js .stats-strip[data-reveal] [data-reveal-child] strong { color: var(--ink-900) !important; }
  .js .stats-strip[data-reveal] [data-reveal-child] .ic { color: var(--blue-600) !important; }
  .js .stats-strip[data-reveal] [data-reveal-child] strong,
  .js .stats-strip[data-reveal] [data-reveal-child] .ic,
  .js .stats-strip[data-reveal] [data-reveal-child] span { transition: none !important; }
}

/* ---------- Shop By Need — full-bleed image tiles ----------
   Four tall photographs run edge-to-edge with the copy sitting on the
   image itself. The shots are already lit dark at the foot, so the text
   reads on them; a brand-blue scrim is layered under the copy anyway so
   contrast holds even if a photo is later swapped for a lighter one. */
.need-section { padding-bottom: 0; }
.need-strip {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
  background: var(--blue-900);
}
.need-tile {
  position: relative; display: block; overflow: hidden;
  aspect-ratio: 3 / 4; color: var(--white); text-decoration: none;
}
.need-tile img,
.need-tile video {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: center bottom;
  transition: transform .5s ease;
}
/* All four tiles are 16:9 clips dropped into a 3/4 frame, so `cover` crops
   them hard on the sides and the vertical framing is all that's left to
   choose. `center bottom` seats the machine on the foot of the card; the
   food-processing shot sits higher in its frame and needs centring instead
   (.need-tile--center), or its subject runs off the bottom edge. */
.need-tile--center video { object-position: center center; }

.need-tile::after {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(to top, rgba(5, 61, 87, .88) 0%, rgba(5, 61, 87, .45) 32%, rgba(5, 61, 87, 0) 58%);
}
.need-tile-body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 34px 30px 30px; }
.need-tile-body h3 {
  margin: 0 0 10px; color: var(--white);
  font-size: 1.75em; line-height: 115%; letter-spacing: -.01em;
  /* A card title, not a label — the HTML writes "My Home" / "My Business"
     and the caps transform was making a heading read as a badge. */
  text-transform: none; font-weight: 700;
}
.need-tile-body h3 em { font-style: normal; color: var(--blue-400); }
.need-tile-body p {
  margin: 0 0 16px; color: rgba(255, 255, 255, .86);
  font-size: .875em; line-height: 1.6; max-width: 22ch;
}
.need-tile-link {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: var(--fs-button); font-weight: var(--fw-button);
  line-height: var(--lh-button);
  letter-spacing: var(--ls-button); text-transform: none; color: var(--blue-400);
}
@media (hover: hover) {
  .need-tile:hover img,
  .need-tile:hover video { transform: scale(1.05); }
  .need-tile:hover .need-tile-link { color: var(--white); }
}
.need-tile:focus-visible { outline: 3px solid var(--blue-300); outline-offset: -3px; }

@media (max-width: 1080px) {
  .need-strip { grid-template-columns: repeat(2, 1fr); }
  .need-tile { aspect-ratio: 4 / 5; }
}
@media (max-width: 600px) {
  .need-strip { grid-template-columns: 1fr; }
  .need-tile { aspect-ratio: 4 / 3; }
  .need-tile-body { padding: 26px 22px 24px; }
  .need-tile-body h3 { font-size: 1.5em; }
  .need-tile-body p { max-width: none; }
}

.product-card {
  background: var(--white); border: 1px solid var(--blue-100); border-radius: var(--radius-lg);
  overflow: hidden; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease; display: flex; flex-direction: column;
}
.product-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
.product-card .thumb { aspect-ratio: 4/3.1; overflow: hidden; background: var(--blue-50); }
.product-card .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
.product-card:hover .thumb img { transform: scale(1.06); }
.product-card .body { padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
.product-card .cat-tag { font-size: var(--fs-tag); font-weight: var(--fw-label); text-transform: none; letter-spacing: var(--ls-label-tight); color: var(--blue-600); margin-bottom: 6px; }
.product-card h3 { font-size: var(--fs-card-title); line-height: var(--lh-card); margin-bottom: 6px; }
.product-card p.desc { font-size: var(--fs-card-desc); line-height: var(--lh-body); color: var(--ink-500); margin-bottom: 14px; flex: 1; }
.spec-chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
.spec-chip { font-size: var(--fs-tag); font-weight: var(--fw-label); background: var(--blue-100); color: var(--blue-700); padding: 5px 10px; border-radius: var(--radius-pill); }
.product-card .card-actions { display: flex; gap: 8px; margin-top: auto; }
/* Card buttons share the .btn-sm geometry so every pill on the site is one
   of exactly two heights. Only the flex behaviour differs.

   DIMENSIONS are context-aware, TYPOGRAPHY is shared: two CTAs sit side by
   side inside a card column ("View Product" + "Get Price"), so they take
   the compact padding and the one-step-down size. Family, weight, leading,
   tracking and case all still come from the .btn base — so they read as
   the same component as the hero CTA, just built for a tighter slot. */
.product-card .card-actions .btn { flex: 1; padding: .625rem 1rem; font-size: var(--fs-button-sm); }

/* feature list */
.feature-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 24px; }
.feature-list li { display: flex; gap: 10px; align-items: flex-start; font-weight: var(--fw-label); font-size: var(--fs-card-desc); color: var(--ink-900); }
.feature-list li .chk { flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--blue-600); color: #fff; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
.feature-list li .chk svg { width: 11px; height: 11px; }

/* ---------- Why Jagruti — cinematic photographic section ----------
   A full-height editorial composition, not a centred feature grid. The
   source frame is ~2:1: clean blue wall across the left, the mill sitting
   right of centre. The layout follows that split — the heading and a full
   4x2 card grid occupy the left ~64%, and the right ~34% is left to the
   machine.

   The photograph is a real <img> inside .why-bg rather than a CSS
   background, so it can be object-fit cropped per breakpoint AND
   transformed for parallax without the section's own layout being
   involved. .why-bg and .why-product are two separate layers over the same
   source: the second is cropped to the machine alone and travels at its own
   rate, which is what gives the composition its depth. */
/* Written as .section.why-section, not .why-section, on purpose. The shared
   responsive blocks at the foot of this file carry their own
   `.section { padding: … }` overrides at 600px and below; those are later in
   source order and at equal specificity, so a bare .why-section rule loses to
   them and the section silently falls back to the generic 48px padding. The
   doubled class outranks them without reaching for !important. Every padding
   rule for this section below is written the same way. */
/* The runway. The sticky child inside is one viewport tall, so the hold lasts
   for this height MINUS that viewport: 200vh gives ~one screen of hold, which
   is the same ratio .range-panel uses. data-why lives HERE, not on the pin —
   initWhyReveal derives its parallax progress from this element's rect, and a
   pinned element's rect stops moving while it is held. Keeping the hook on the
   runway means the observer and the parallax see exactly the travel they saw
   before, so the entrance and the two photographic layers are unchanged. */
.why-runway {
  /* The runway no longer adds scroll distance. It previously ran 175vh so the
     sticky section below could be held for ~75vh of hold; the section is not
     pinned any more, so that surplus height would just be empty page. It stays
     as an element because [data-why] hangs off it and the reveal observer
     measures its rect. */
  height: auto;
  position: relative;
}

.section.why-section {
  /* Scrolls with the page. This was position:sticky/top:0 against a 175vh
     runway, which pinned the composition for about three-quarters of a
     viewport; it now moves with everything else. The one-viewport frame below
     is kept, so the section still reads as a single authored screen — it just
     passes through rather than being held. */
  position: relative;
  overflow: hidden;              /* contains the layer scale overshoot */
  isolation: isolate;            /* keeps the card shadows off the backdrop */
  background: var(--blue-50);    /* what shows for the moment before decode */
  /* Exactly one viewport, pinned at all three so neither content nor the
     global .section padding can grow it. Everything inside is sized to fit
     this box rather than the box growing to fit the content.

     100svh is the unit the hero uses (.hero { height: 100svh }), so the two
     sections measure identically — svh is the stable viewport height, so a
     mobile browser's collapsing toolbar cannot make this box disagree with
     the hero's. */
  height: 100svh;
  /* The hero does not shrink below 620px (.hero { min-height: 620px }), so
     neither can this section: on a short desktop window a plain 100svh box
     would keep shrinking past the hero's floor and the two would stop
     measuring the same. The floor has to win over the 100svh min, hence
     max() rather than a second min-height declaration. */
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
  /* Top padding clears the fixed header. Everything below is distributed by
     the flex column in .why-inner rather than by fixed heights — the
     viewport sets the section height and the grid absorbs whatever is left,
     which is what keeps row two inside the frame at every viewport.

     The top band carries 14px of surplus over the fixed bar it exists to
     clear: --header-h is 76px, the bar measures 62px. On a tall window that
     surplus is just breathing room and the clamp keeps all 76px. On a short
     one the composition needs it — head + grid floor + padding wants 734px
     inside a 700px frame — so the clamp hands it back as the viewport
     shortens, down to a 62px floor that still clears the bar exactly. This
     is the one band that can give without touching a card. */
  padding: clamp(62px, 9.4vh, var(--header-h)) 0 18px;
  margin: 0;
  display: flex;
  align-items: stretch;
}
/* Both photographic layers are stretched past the section edges so the
   parallax always has overhang to travel into — no bare edge is ever pulled
   into frame, and the crop on the mill never changes. */
.why-bg {
  position: absolute;
  inset: -7% 0;
  z-index: 0;
  pointer-events: none;
  will-change: transform;
}
.why-bg img {
  width: 100%; height: 100%;
  object-fit: cover;
  /* Anchored left-of-centre: this layer supplies the blue wall and light,
     while the machine itself is carried by .why-product above. */
  object-position: 34% 50%;
  display: block;
}
/* The two layers are crops of the same photograph at different scales, so
   where .why-bg ends and .why-product begins the wall tone steps — a hard
   vertical seam straight down the composition. Feathering the product layer's
   left edge dissolves that join: the machine keeps its full density and only
   the surplus wall either side of it fades out into the layer below. */
.why-product {
  /* Feathered on THREE edges, not just the left. The left gradient dissolves
     the crop seam against .why-bg as before; the vertical one now also fades
     the top and bottom, which is what stopped the layer reading as a picture
     laid ON the section — a hard horizontal edge top and bottom is exactly
     what makes a photographic layer look like a floating card. The two masks
     are composited with mask-composite:intersect so a pixel survives only
     where BOTH gradients keep it, leaving the machine itself at full density
     in the middle and every boundary dissolving into the wall behind it. */
  -webkit-mask-image:
    linear-gradient(90deg,
      transparent 0%, rgba(0,0,0,.35) 12%, #000 32%, #000 100%),
    linear-gradient(180deg,
      transparent 0%, #000 10%, #000 93%, transparent 100%);
  mask-image:
    linear-gradient(90deg,
      transparent 0%, rgba(0,0,0,.35) 12%, #000 32%, #000 100%),
    linear-gradient(180deg,
      transparent 0%, #000 10%, #000 93%, transparent 100%);
  -webkit-mask-composite: source-in;
  mask-composite: intersect;
}
/* The machine, as its own layer on the right third. Sized in vw so it holds
   its share of the composition at any width, and scaled slightly past its
   box so the parallax drift never exposes the crop seam. */
.why-product {
  position: absolute;
  top: -5%; bottom: -5%;
  right: 0;
  width: 42%;
  z-index: 1;
  pointer-events: none;
  will-change: transform;
}
.why-product img {
  width: 100%; height: 100%;
  object-fit: cover;
  /* Frames the mill itself out of the wide source — the machine sits at
     roughly 78% across the original, so the crop centres there. */
  object-position: 82% 52%;
  display: block;
}
/* Readability wash, left-weighted only. It lifts the copy off the
   photograph without flattening it; the machine side stays clear, which is
   the whole point of the shot. Deliberately stops short of the right edge. */
.why-section::before {
  content: "";
  position: absolute; inset: 0; z-index: 2; pointer-events: none;
  background:
    linear-gradient(100deg,
      rgba(255,255,255,.88) 0%,
      rgba(255,255,255,.70) 30%,
      rgba(233,242,247,.30) 54%,
      rgba(233,242,247,0) 70%);
}
/* Fills the section so the grid has a definite height to take its share of.
   min-height:0 is what lets the grid actually shrink inside this column —
   without it a flex child refuses to go below its content size and the last
   row is pushed past the section edge again. */
.why-inner {
  position: relative;
  z-index: 3;
  width: 100%;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* The head sits upper-left over the clean band, not centred across the
   machine. Capped so it never runs the full width of the section. */
.why-section .section-head {
  max-width: 680px;
  /* Tight: on a 900px-tall viewport every pixel here comes out of the card
     grid, which is what clips the longest card's last line. Pulled in from
     clamp(20px, 2.6vh, 34px) so the heading sits higher over the clean band
     and the reclaimed pixels go to the card track below, which needed them
     to fit its longest copy. */
  margin: 0 0 clamp(12px, 1.5vh, 20px);
  text-align: left;
  /* Never compresses: it keeps its natural height and the grid below takes
     the remainder. Without this the head would shrink under flex pressure
     and the heading would crush before the cards gave up any space. */
  flex: none;
}
.why-section .section-head .eyebrow { margin-bottom: 16px; }
.why-section .section-head h2 {
  color: var(--blue-800);
  /* The section has to hold a heading, eight cards and the machine inside
     one viewport, so the heading stays contained — which the shared step
     already does, more tightly than the old ceiling did.

     Was clamp(1.9rem, 2.6vw, 3.625rem) — a 58px ceiling against the 40px
     every other section heading uses, with its own 1.08 leading and
     -.025em tracking. That made this the one section heading on the site
     that looked custom-built. It now takes the shared step; the section
     still fits because --fs-title is well under the old ceiling. */
  margin-bottom: 0;
}

/* Four across, two down, inside the left band. The right ~34% is left for
   the machine by capping the grid's width rather than by padding it — the
   cards then get their full share of the space instead of being squeezed. */
/* Two rows of equal height, and the grid takes its height from the space the
   section has left rather than declaring one — that is what guarantees the
   second row lands inside the viewport instead of being pushed past it by a
   long card, at any viewport height. */
.why-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
  /* rem, matching the rem track below — a px gap would not scale with the
     rows it separates. 1rem/1.25rem = the old 16px/20px at a 16px root. */
  gap: 1rem 1.25rem;
  width: 66%;
  max-width: 1180px;
  /* Sized in rem, because everything inside the card is.

     The card's type rides the fluid root (html font-size is a clamp tuned to
     16px at 1440px, climbing to a 20px ceiling around 1900px), so h4 at 1rem
     delivers 16px on a 1440px screen and 20px on a wide one — about 25% more.
     The track used to be px/vh, which cannot follow that: past ~1440px the
     type kept growing while the box it sits in stayed put, short headings
     ("Wide Product Range", "After-Sales Support") tipped over to a second
     line, and each wrap pushed a paragraph line out of the glass. That is the
     overflow — not copy length, which is why a long card like "Reliable
     Performance" sat fine while shorter ones spilled.

     In rem the track scales with the text it holds, so the fit is identical at
     every width. 27.9rem was the old 446px at a 16px root: two rows of ~215px
     (48px icon + margin, a two-line heading, a four-line paragraph at the
     narrowest desktop column, 36px padding) plus the 16px row gap.

     That track was still ~4px short for the four longest cards ("Advanced
     Technology", "Reliable Performance", "Designed for Indian Kitchens",
     "Quality-Focused Engineering"), whose last paragraph line sat just past
     the glass — measured at 1280/1440/1600/1920 wide. Raised to 30.4rem, with
     the extra coming from the head's tightened bottom margin and the slack
     that was sitting unused below the grid, so the cards are both larger and
     no longer overflowing without the section growing.

     The vh term is intentionally kept as the middle value so a short window
     still compresses the grid rather than pushing row two into the section's
     overflow:hidden — on a short *and* wide window vh wins and the cards go
     tight again, which is the one case still worth checking in a browser. */
  flex: 0 1 auto;
  height: clamp(30.4rem, 47vh, 31.9rem);
  min-height: 0;
}

/* The glass card. Deliberately under-opaque so the blue behind stays
   readable through the fill — that translucency is what sells the material.
   A fixed min-height keeps the two rows even when copy lengths differ. */
.why-item {
  position: relative;
  text-align: left;
  /* No min-height: the row track sets the height now, and a min-height here
     would fight it and re-introduce the overflow. */
  min-height: 0;
  /* Visible, not hidden: clipping is what disguised the overflow before.
     If the copy ever fails to fit now it must be visible so it can be fixed
     at the source rather than silently cut. */
  overflow: visible;
  /* A column so the paragraph occupies a real box in the card's flow rather
     than spilling past a fixed row height. */
  display: flex;
  flex-direction: column;
  /* rem, for the same reason as the track and the icon: fixed padding around
     rem-scaled copy shrinks the usable box as the root grows. */
  padding: 1.125rem 1.375rem;
  border-radius: 24px;
  background: rgba(255,255,255,.20);
  -webkit-backdrop-filter: blur(20px) saturate(155%);
  backdrop-filter: blur(20px) saturate(155%);
  border: 1px solid rgba(255,255,255,.42);
  box-shadow:
    0 20px 50px rgba(5, 61, 87, .12),
    inset 0 1px 0 rgba(255,255,255,.55);   /* top-edge reflection */
  transition:
    transform .35s cubic-bezier(.22,.61,.36,1),
    box-shadow .35s cubic-bezier(.22,.61,.36,1),
    background .35s ease,
    border-color .35s ease;
}
/* Icon container: a small glass disc, same material as the card. */
.why-item .icon {
  position: relative;
  flex: none;
  /* rem, to match the rem-sized track and type above: a px icon would hold
     its 48px while the copy around it grew with the fluid root, eating the
     card's budget from the top on wide screens. */
  width: 2.375rem; height: 2.375rem; margin: 0 0 .5rem;
  border-radius: 50%;
  background: rgba(255,255,255,.34);
  border: 1px solid rgba(255,255,255,.55);
  display: flex; align-items: center; justify-content: center;
  color: var(--blue-700);
  box-shadow: 0 6px 16px rgba(19,167,236,.16);
  transition: box-shadow .35s ease, color .35s ease;
}
.why-item .icon svg { width: 1.1875rem; height: 1.1875rem; position: relative; z-index: 1; }
/* Sized in rem, not em: the card is a small-typed context and an em-based
   heading would compound down into the hyphenation the old layout showed. */
.why-item h4 {
  font-size: .875rem;        /* 14px */
  font-weight: 600;
  line-height: 1.25;
  margin-bottom: 5px;
  color: var(--blue-800);
  /* The headings are short noun phrases — never break them mid-word. */
  hyphens: none;
  overflow-wrap: normal;
}
.why-item p {
  /* rem, not em: an em here resolved against the card's own font-size and so
     compounded as the fluid root grew, which is what ran the four longest
     cards a line past the glass on wide screens. Fixed rem plus a tighter
     leading keeps every paragraph inside its card. */
  font-size: .8125rem;       /* 13px */
  line-height: 1.45;
  margin: 0;
  color: var(--ink-700);
  hyphens: none;
}

/* Hover: a 6px lift and a touch of scale, a brighter rim, a slightly denser
   fill and more glow on the icon. Nothing here changes layout. */
@media (hover: hover) {
  .why-item:hover {
    transform: translateY(-6px) scale(1.015);
    background: rgba(255,255,255,.30);
    border-color: rgba(255,255,255,.62);
    box-shadow:
      0 28px 60px rgba(5, 61, 87, .18),
      inset 0 1px 0 rgba(255,255,255,.7);
  }
  .why-item:hover .icon {
    box-shadow: 0 8px 22px rgba(19,167,236,.34), 0 0 0 6px rgba(19,167,236,.10);
    color: var(--blue-600);
  }
}

/* ---- Entrance ----
   Gated on html.js so content is never hidden without the script, and driven
   by .is-in, which main.js adds AND removes — so the sequence replays when
   the section is scrolled back into. Per-element delays are custom properties
   written inline by the script (see initWhyReveal), which is what sequences
   the phases: photograph, then eyebrow, then heading lines, then cards.

   Card entry is 3D, so the grid needs a shared perspective for the rotateX
   to read as depth rather than as a squash. */
.js .why-section[data-why] .why-bg,
.js .why-section[data-why] .why-product,
.js .why-section[data-why] .section-head .eyebrow,
.js .why-section[data-why] .why-line > span {
  opacity: 0;
  transition:
    opacity .95s cubic-bezier(.22,.61,.36,1) var(--why-delay, 0ms),
    transform .95s cubic-bezier(.22,.61,.36,1) var(--why-delay, 0ms);
}
/* Phase 1 — the photograph and the machine emerge, the product drifting in
   from the right so it reads as arriving rather than fading up. */
.js .why-section[data-why] .why-bg { transform: scale(1.08); }
.js .why-section[data-why] .why-product { transform: scale(1.08) translateX(40px); }
/* Phase 2 / 3 — eyebrow, then the heading line by line. Each line rides in
   its own overflow-clipped row, so it wipes upward instead of just fading. */
.js .why-section[data-why] .section-head .eyebrow { transform: translateY(30px); }
.js .why-section[data-why] .why-line { display: block; overflow: hidden; }
.js .why-section[data-why] .why-line > span { display: block; transform: translateY(100%); }
/* The cards deliberately have no entrance animation: they are simply present
   from the start, so only the photograph and the heading play on scroll. */

.js .why-section[data-why].is-in .why-bg,
.js .why-section[data-why].is-in .why-product,
.js .why-section[data-why].is-in .section-head .eyebrow,
.js .why-section[data-why].is-in .why-line > span {
  opacity: 1;
  transform: none;
}
/* Previously dropped the transition on both layers once settled, so the
   parallax's per-frame transform writes were not fighting a 950ms ease. The
   parallax is gone and nothing writes to these layers any more, so the rule
   would only strip the entrance transition on a replay. */

/* Stillness: everything at its settled state, no entrance, no parallax.
   initWhyReveal also returns early, so no transform is ever written. */
@media (prefers-reduced-motion: reduce) {
  .js .why-section[data-why] .why-bg,
  .js .why-section[data-why] .why-product,
  .js .why-section[data-why] .section-head .eyebrow,
  .js .why-section[data-why] .why-line > span {
    opacity: 1 !important; transform: none !important; transition: none !important;
  }
}

/* ---- Why Jagruti, narrower ----
   Kept with the section rather than in the shared responsive block at the
   foot of the file: the columns, the crop and the entrance distances all
   have to move together. An older `.why-grid { grid-template-columns }`
   rule in that shared block is exactly what broke the previous layout. */
@media (max-width: 1400px) {
  /* The grid needs a larger share before the cards get tight, so the
     machine's band narrows first. */
  .why-grid { width: 72%; }
  .why-product { width: 36%; }
}
@media (max-width: 1200px) {
  /* Tablet: two columns, four rows. The machine stays a real presence on
     the right rather than being dropped.
     The section is taller than the viewport here, so it no longer centres
     its content — align to the top and carry enough top padding to clear
     the fixed header, or the heading lands underneath it. */
  /* Below 1200px the one-viewport lock is released: eight cards in two
     columns (and one on a phone) cannot fit a 100vh box without crushing the
     copy, so the section becomes content-driven again and the page scrolls
     normally. The desktop height/max-height must be cleared explicitly or
     they keep squeezing the rows. */
  .section.why-section {
    height: auto;
    min-height: 0;
    max-height: none;
    align-items: flex-start;
    padding: calc(var(--header-h) + 48px) 0 80px;
  }
  /* The desktop flex column exists to divide a fixed viewport between head
     and grid. Here there is no fixed height to divide, so it is unwound —
     height:100% against an auto-height parent and a flex:1 grid would both
     fight the content-driven layout this breakpoint wants. */
  .why-inner { height: auto; display: block; }
  .why-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: none;      /* rows size to their content again */
    height: auto;
    /* The desktop rem floor and ceiling must be cleared explicitly too, or
       the ceiling would hold this content-driven grid to one desktop track
       and crush the stacked rows. */
    min-height: 0;
    max-height: none;
    /* Releases the desktop `flex: 1`: with .why-inner unwound to a block
       above this is inert, but left in place it would resurface the moment
       anything re-established a flex column here. */
    flex: none;
    width: 64%;
    gap: 18px;
  }
  .why-item { overflow: visible; }
  .why-product { width: 36%; }
  .why-product img { object-position: 78% 52%; }
  .why-section .section-head { margin-bottom: 44px; }
}
@media (max-width: 900px) {
  /* The two columns now need most of the width to stay readable, so the
     machine moves behind them and the wash carries the contrast. */
  .why-grid { width: 100%; max-width: 640px; }
  .why-product { width: 58%; opacity: .55; }
  .why-section::before {
    background:
      linear-gradient(115deg,
        rgba(255,255,255,.92) 0%,
        rgba(255,255,255,.80) 45%,
        rgba(233,242,247,.50) 75%,
        rgba(233,242,247,.25) 100%);
  }
}
@media (max-width: 760px) {
  /* Phone: a single column over the photograph. The machine is not hidden —
     the section opens with a band of clear photograph at the top, the mill
     sitting in it at full strength, and the cards begin below that. Travel is
     shortened and the script tightens the stagger to match. */
  .section.why-section {
    padding: calc(var(--header-h) + 296px) 0 64px;
    align-items: flex-start;
  }
  .why-bg img { object-position: 40% 50%; }
  /* Held in the opening band rather than washed out behind the cards: full
     opacity, its own crop centred on the mill, and a mask that feathers both
     the left edge and the foot so the band settles into the wash instead of
     ending on a line. Wider and pushed further right than the desktop layer
     so the machine reads at this size rather than becoming a sliver. */
  /* The source is ~2:1, so a short band across a 390px viewport can only ever
     show a slice of the machine. The band is given real height instead and
     sits full-bleed, which is what lets the mill read at this size. */
  .why-product {
    width: 100%; right: 0;
    top: calc(var(--header-h) + 40px); bottom: auto;
    height: 320px;
    opacity: 1;
    -webkit-mask-image:
      linear-gradient(180deg, #000 60%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 22%);
    mask-image:
      linear-gradient(180deg, #000 60%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 22%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  /* Centred on the machine itself (~78% across the source), now that the band
     is full-width and tall enough to hold it. */
  .why-product img { object-position: 78% 45%; }
  /* The head sits in that same opening band, over the clear left of it. */
  .why-section .section-head { margin-bottom: 26px; }
  .why-section::before {
    background:
      linear-gradient(180deg,
        rgba(255,255,255,.42) 0%,
        rgba(255,255,255,.72) 30%,
        rgba(255,255,255,.90) 52%,
        rgba(233,242,247,.92) 100%);
  }
  .why-grid { grid-template-columns: 1fr; gap: 14px; width: 100%; max-width: none; }
  .why-item { min-height: 0; padding: 20px 20px 22px; border-radius: 22px; }
  .why-item .icon { width: 38px; height: 38px; margin-bottom: 10px; }
  .why-item .icon svg { width: 19px; height: 19px; }
  .why-section .section-head { margin-bottom: 32px; }

  .js .why-section[data-why] .why-bg { transform: scale(1.04); }
  .js .why-section[data-why] .why-product { transform: scale(1.04) translateX(20px); }
}

/* split (domestic vs commercial etc.) */
/* ---------- Two Ranges — paired image cards ----------
   Two large photographic cards side by side on a light cool wash. The
   images carry the section, so the cards stay tall and the copy sits on
   the photograph itself, lifted off the bottom-left corner. Height is
   fluid between the desktop bounds so the pair keeps its proportions
   across viewport widths without a step at every breakpoint. */
.split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
.split-card {
  position: relative; border-radius: 14px; overflow: hidden;
  height: clamp(390px, 32vw, 430px);
  display: flex; align-items: flex-end; box-shadow: var(--shadow-md);
}
/* Both source frames are 16:9 and the machine sits right of centre, so a
   default centre crop on the taller card would push the product toward the
   edge and start clipping it. The crop is biased right to follow the
   machine, and a little above centre so the product clears the copy block
   and the deepest part of the scrim at the foot. */
.split-card img,
.split-card video {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: 62% 42%;
}
/* Brand-blue scrim rising from the foot: deep enough under the copy for
   white text, clear of the machine in the upper half of the frame. */
.split-card::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(0deg, rgba(8, 46, 66, .88) 0%, rgba(8, 46, 66, .58) 32%, rgba(8, 46, 66, .12) 62%, rgba(8, 46, 66, 0) 100%);
}
.split-card .content { position: relative; z-index: 2; padding: 34px; color: #fff; }
.split-card h3 { color: #fff; font-size: 1.5em; }  /* 24px */
.split-card p { color: rgba(255,255,255,.85); }

/* ---------- Two Ranges — pinned full-bleed 50/50 panels ----------
   Each panel is a runway; the .range-pin inside it is one viewport tall
   and is held in place by ScrollTrigger while the runway scrolls past, so
   the split stays still and then hands over to the next one. Media and
   copy swap sides between the two panels (--flip), which is what makes the
   pair read as one alternating movement rather than two repeats. */
.ranges-section { padding-bottom: 0; }
.ranges-section .section-head { margin-bottom: 56px; }

/* Every layer in the pinned chain carries the SAME dark ground. A pin is
   engaged and released by taking the element out of flow and putting it
   back, and at each of those boundaries whatever sits behind it paints for
   a frame. With the page's near-white --page-bg behind a near-black panel
   that one frame reads as a white flash. Painting the runway and the
   section itself the same colour means there is nothing lighter to expose,
   whatever the pin does. */
.ranges-section { background: var(--white); }

.range-panel {
  /* The runway. The sticky child inside is one viewport tall, so the hold
     lasts for this height MINUS that viewport — 200vh here gives ~one
     screen of hold per panel. Raise it for a longer hold; at 100vh the
     panel is exactly as tall as its pin and there is no hold at all. */
  height: 200vh;
  position: relative;
  background: var(--white);
}
/* position:sticky, after the reference. The panel above is the runway; this
   child holds the screen while that runway scrolls past, exactly as
   .stage-pin and .services-pin already do in this file. No JS owns the
   hold, so there is no pin engage/release boundary to flash at — which is
   what the ScrollTrigger pin this replaced had to paint around. */
.range-pin {
  position: sticky;
  top: 0;
  height: 100vh;
  /* The visible frame, matched to the hero: same 100svh unit and the same
     620px floor (.hero { height: 100svh; min-height: 620px }), so a short
     window cannot make this pin shorter than the hero. The TRACK height
     above is untouched — scroll duration and animation timing are
     unchanged; only the frame the pin paints into is pinned. */
  height: 100svh;
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
  overflow: hidden;
  background: var(--white);
  isolation: isolate;

  /* The push. --split is the media's width, scrubbed 100vw -> 50vw by
     initTwoRanges while the pin is held: the video fills the view on
     arrival, then is pushed aside as the copy is revealed beside it. On the
     flipped panel the children are ordered the other way, so the same
     single value pushes the video right instead.

     A FLEX row, after the reference (farmminerals.com/promo builds this as
     .numbers-wrap-sticky: sticky, 100vh, overflow hidden, display flex).
     The media is a flex:none item whose width IS --split, scrubbed
     100vw -> 50vw; the copy is a fixed 50vw sibling that simply waits off
     the edge until the video vacates the space. Grid tracks were the wrong
     tool: at --split:100% a companion track still had to resolve against
     leftover space, which is what made the flipped panel slide sideways to
     settle before the push began. Two fixed widths in a row overflowing a
     hidden box have nothing to negotiate, so both panels start genuinely
     full-bleed and the push is the first movement in either direction. */
  --split: 100vw;
  display: flex;
  flex-wrap: nowrap;
}
/* No JS / reduced motion: the split is simply the settled 50/50. */
.range-panel.is-static .range-pin { --split: 50vw; }
/* Flipped panel: copy left, media right — as a REVERSED row, not an order
   swap. The two are not equivalent here. With order:1/order:2 the row still
   lays out from the left edge, so the copy painted at the left from the
   first frame and the 100vw media began 50vw off to the right with only its
   left half on screen — the video slid in past standing copy instead of
   filling the screen and pushing the copy in. row-reverse lays the row out
   from the RIGHT edge instead: the media anchors to the right and fills
   leftward at 100vw, the copy waits clipped off the LEFT edge, and the same
   --split scrub pushes it in from that side. An exact mirror of the
   unflipped panel, driven by the identical tween.

   DOM order stays media-then-copy in both panels (row-reverse flips only
   the visual main axis), so the reading order the order-swap was protecting
   is unchanged. */
.range-panel--flip .range-pin { flex-direction: row-reverse; }

/* flex:none so the width is exactly --split and nothing shrinks it; the
   reference's .numbers-video-new is the same (flex:none, width:50vw). */
.range-media { position: relative; overflow: hidden; flex: none; width: var(--split); }
/* object-fit:cover, matching the reference's .farmer-video. cover is what
   lets the video FILL the screen at the 100vw start with no letterboxing —
   the shrink is carried by the BOX narrowing around it, not by fitting the
   picture inside the box. (contain would letterbox badly at full-bleed,
   since the frame's aspect ratio there is the viewport's, not the video's.)
   The height:120% overspill gives cover somewhere to crop from vertically,
   so the framing tightens rather than the picture sliding. */
.range-media video,
.range-media img {
  position: absolute; left: 0; width: 100%;
  top: 50%; height: 120%; transform: translateY(-50%);
  object-fit: cover; object-position: 50% 42%;
}
/* No wash over the media. A white gradient from the copy side was laying a
   light shade across the video for the whole push; the video is meant to
   read as clean at every width. */

/* Fixed 50vw, flex:none — the settled half. It sits off the right edge
   (clipped by the pin's overflow:hidden) for as long as the media is wider
   than 50vw, so the copy is genuinely PUSHED into view as the video
   retreats, rather than being squeezed open from zero width. Mirrors the
   reference's .numbers-content-new / .carbon-content-new at width:50vw. */
.range-content {
  display: flex; align-items: center;
  flex: none; width: 50vw; min-width: 0;
  padding: 0 clamp(28px, 5vw, 80px);
  background: var(--white); color: var(--ink-900);
}
.range-content-inner { max-width: 30em; }
.range-content-inner .eyebrow {
  color: var(--blue-600); background: var(--blue-50);
}
.range-content-inner h3 {
  margin: 0 0 18px;
  color: var(--ink-900);
  /* An h3 by tag, a SECTION HEADING by role — it sits under an .eyebrow
     with body copy beneath, exactly like a .section-head. It keeps its
     fluid size (the panel is a pinned 50vw column, so it has to track the
     split) but takes the shared heading leading and tracking; the stray
     122% was the last thing making it read looser than its neighbours. */
  font-size: clamp(1.9em, 3.2vw, 2.6em);
  font-weight: var(--fw-title);
  line-height: var(--lh-title);
  letter-spacing: var(--ls-title);
}
.range-content-inner p {
  margin: 0 0 30px;
  color: var(--ink-700);
  font-size: .875em; line-height: 1.6;
}
/* Per-character split: words stay whole so lines break normally. */
.range-word { display: inline-block; white-space: nowrap; }
.range-char { display: inline-block; }

/* The copy starts hidden BEFORE first paint, gated on html.js the same way
   the hero scenes are. Without this the block paints fully visible, then
   GSAP snaps it to opacity 0 on its first frame and animates it back in —
   which is the flash. Anything JS cannot reach stays visible, so the
   no-script and no-GSAP paths are unaffected. */
.js .range-content-inner > * {
  opacity: 0;
  will-change: opacity, transform;
}
/* Once the panel has played, the compositor hint is dropped. */
.js .range-panel.is-revealed .range-content-inner > * { will-change: auto; }
/* No GSAP / reduced motion: never hide it in the first place. */
.js .range-panel.is-static .range-content-inner > * { opacity: 1; will-change: auto; }

@media (prefers-reduced-motion: reduce) {
  .js .range-content-inner > * { opacity: 1 !important; will-change: auto; }
}

/* No GSAP / reduced motion: everything is simply present, and the pin
   becomes an ordinary block (no sticky, nothing to hand over). */
.range-panel.is-static { height: auto; }
.range-panel.is-static .range-pin {
  position: relative; height: auto;
  /* Clears the desktop one-viewport lock; this path is a plain block. */
  min-height: 0;
  max-height: none;
  /* Stacked, like the other two fallback paths: the children carry fixed
     widths off --split, so dropping the pin without turning the row into a
     column would leave a half-width video beside a half-width copy at the
     56vh media height below — not the plain block this path intends. */
  flex-direction: column;
}
.range-panel.is-static .range-media { height: 56vh; min-height: 300px; width: 100%; }
.range-panel.is-static .range-content { width: 100%; }

@media (max-width: 900px) {
  /* Stacked: no pin, no runway — a pinned full-height panel on a phone
     fights the scroll. Media on top, copy beneath, as a normal block. */
  .range-panel { height: auto; }
  /* Stacked as a flex column. Both children carry fixed widths off --split
     (100vw and 50vw), so the direction change has to be joined by width
     resets or the pair would simply sit side by side and overflow. */
  .range-pin,
  .range-panel--flip .range-pin {
    position: relative; height: auto;
    /* Clears the desktop one-viewport lock; this path is a plain block. */
    min-height: 0;
    max-height: none;
    flex-direction: column;
    /* Nothing is pinned here, so keeping a full-screen layer alive costs
       memory for no benefit. */
    will-change: auto;
  }
  .range-media { height: 56vh; min-height: 300px; width: 100%; }
  .range-content { width: 100%; padding: 44px clamp(18px, 6vw, 40px) 52px; }
}

@media (prefers-reduced-motion: reduce) {
  .range-panel { height: auto; }
  /* Both selectors, and the widths reset: --split stays at its 100vw start
     when no scrub runs, so without this the media fills the row and the
     copy is pushed off the edge entirely. Stacked is the right
     reduced-motion shape anyway — the push is the motion being opted out
     of. */
  .range-pin,
  .range-panel--flip .range-pin {
    position: relative; height: auto;
    /* Clears the desktop one-viewport lock; this path is a plain block. */
    min-height: 0;
    max-height: none;
    flex-direction: column;
  }
  .range-media { height: 56vh; min-height: 300px; width: 100%; }
  .range-content { width: 100%; }
}

/* steps */
.steps-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; counter-reset: step; }
.step { text-align: center; padding: 20px; position: relative; }
.step .num { width: 42px; height: 42px; border-radius: 50%; background: var(--blue-600); color: #fff; font-weight: 500; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
.step h4 { font-size: 1em; margin-bottom: 4px; }
.step p { font-size: var(--fs-label); }

/* testimonial */
.testimonial-card { background: var(--white); border: 1px solid var(--blue-100); border-radius: var(--radius-lg); padding: 26px; box-shadow: var(--shadow-sm); }
.testimonial-card .stars { color: var(--gold); font-size: var(--fs-card-desc); margin-bottom: 10px; letter-spacing: 2px; }
.testimonial-card .who { display: flex; align-items: center; gap: 12px; margin-top: 16px; }
.testimonial-card .avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--blue-200); color: var(--blue-800); display: flex; align-items: center; justify-content: center; font-weight: 500; }
.testimonial-card .who strong { display: block; font-size: var(--fs-label); }
.testimonial-card .who span { font-size: var(--fs-caption); color: var(--ink-500); }
.testimonial-empty { text-align: center; padding: 40px 20px; border: 1.5px dashed var(--blue-300); border-radius: var(--radius-lg); color: var(--ink-500); font-size: var(--fs-card-desc); }

/* CTA band */
.cta-band { background: var(--gradient-sheen); color: #fff; border-radius: var(--radius-lg); padding: 56px 40px; text-align: center; }
.cta-band h2 { color: #fff; }
.cta-band p { color: rgba(255,255,255,.88); max-width: 560px; margin: 0 auto 26px; }
.cta-band .hero-cta { justify-content: center; }

/* ---------- Filters / product listing ---------- */
.filter-bar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px; align-items: center; justify-content: space-between; }
.filter-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.filter-pill { padding: 9px 18px; border-radius: var(--radius-pill); border: 1.5px solid var(--blue-200); font-weight: var(--fw-body); font-size: var(--fs-label); color: var(--ink-700); background: var(--white); }
.filter-pill.active, .filter-pill:hover { background: var(--blue-600); color: #fff; border-color: var(--blue-600); }
.search-box { display: flex; align-items: center; gap: 8px; border: 1.5px solid var(--blue-200); border-radius: var(--radius-pill); padding: 9px 16px; min-width: 240px; background: #fff; }
.search-box input { border: none; outline: none; font-size: var(--fs-label); flex: 1; }
.search-box svg { width: 16px; height: 16px; color: var(--ink-500); flex: none; }
.no-results { text-align: center; padding: 60px 20px; color: var(--ink-500); display: none; }

/* ---------- Product Detail Page ---------- */
.pd-top { padding: 42px 0 20px; }
.pd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: flex-start; }
.pd-gallery img { width: 100%; border-radius: var(--radius-lg); border: 1px solid var(--blue-100); box-shadow: var(--shadow-sm); }
/* Transparent PNG/WebP cut-outs have no photographic ground of their own,
   so the bordered card that suits a rectangular photo would draw a box
   around a floating machine. These sit on the section wash instead and
   carry a soft contact shadow, the way the homepage stage handles them. */
.pd-gallery img.is-cutout {
  border: none; box-shadow: none; background: none;
  padding: 10px 0;
  filter: drop-shadow(0 18px 26px rgba(5, 61, 87, .16));
}
/* Cards crop to a landscape window with object-fit: cover, which would
   slice the top and bottom off an upright machine. A cut-out is contained
   and centred on the card wash instead, so the whole product reads. */
.product-card .thumb img.is-cutout {
  object-fit: contain;
  padding: 12px;
  background: var(--blue-50);
}
.pd-gallery .cap { text-align: center; font-size: var(--fs-caption); color: var(--ink-500); margin-top: 10px; }
.pd-info .cat-tag { font-size: var(--fs-tag); font-weight: var(--fw-label); text-transform: none; letter-spacing: var(--ls-label-tight); color: var(--blue-600); }
/* h2 step, not h1: this sits in a half-width column beside the gallery,
   and product names run long ("Food Processing Machinery for Restaurants &
   Food Businesses" is 59 characters). At the h1 step those wrap to four
   lines and push the buy actions below the fold. The page-hero h1 gets the
   full step because it spans the container. */
.pd-info h1 { font-size: var(--fs-h2); line-height: var(--lh-title); letter-spacing: var(--ls-title); margin-top: 8px; }
.pd-info .tagline { font-size: 1em; /* 16px */ color: var(--ink-500); margin-bottom: 18px; }
.pd-info .model-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 22px; }
.model-chip { background: var(--blue-100); color: var(--blue-800); font-weight: var(--fw-label); font-size: var(--fs-label); padding: 8px 14px; border-radius: var(--radius-sm); }
.pd-info .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 22px 0; }
.pd-info .mini-note { font-size: var(--fs-label); color: var(--ink-500); background: var(--blue-50); border: 1px solid var(--blue-100); padding: 12px 16px; border-radius: var(--radius-sm); }

.spec-table { width: 100%; border-collapse: collapse; font-size: var(--fs-card-desc); }
.spec-table th, .spec-table td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--blue-100); }
.spec-table th { background: var(--blue-700); color: #fff; font-weight: 500; }
.spec-table tbody tr:nth-child(even) { background: var(--blue-50); }
.spec-table td:first-child { font-weight: 400; color: var(--ink-900); white-space: nowrap; }
.spec-table-wrap { overflow-x: auto; border-radius: var(--radius-md); border: 1px solid var(--blue-100); }

.fit-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
.fit-pill { background: var(--blue-50); border: 1px solid var(--blue-100); border-radius: var(--radius-md); padding: 16px 12px; text-align: center; font-size: var(--fs-label); font-weight: var(--fw-body); color: var(--blue-800); }

.related-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

/* ---------- Compare ---------- */
.compare-select-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 30px; }
.compare-select { border: 1.5px solid var(--blue-200); border-radius: var(--radius-md); padding: 12px 14px; font-size: var(--fs-card-desc); font-weight: var(--fw-label); background: #fff; width: 100%; }
.compare-table-wrap { overflow-x: auto; }
.compare-table { width: 100%; border-collapse: collapse; min-width: 720px; }
.compare-table th, .compare-table td { padding: 14px 18px; border-bottom: 1px solid var(--blue-100); font-size: var(--fs-label); text-align: left; }
.compare-table th { background: var(--blue-50); position: sticky; top: 0; }
.compare-table th.attr-col { width: 190px; color: var(--ink-500); font-weight: 400; background: #fff; }
.compare-table td.attr { font-weight: 400; color: var(--ink-700); background: var(--blue-50); }
.compare-table .prod-head img { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; margin-bottom: 8px; }
.compare-table .prod-head strong { display: block; font-size: var(--fs-card-desc); }

/* ---------- FAQ ---------- */
.faq-cat-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 34px; }
.faq-item { border: 1px solid var(--blue-100); border-radius: var(--radius-md); margin-bottom: 12px; overflow: hidden; background: #fff; }
.faq-item summary { padding: 18px 22px; font-weight: var(--fw-strong); font-size: 1.0625em; /* 17px */ line-height: var(--lh-card); cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; }
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after { content: "+"; font-size: 1.375em; /* 22px */ color: var(--blue-600); font-weight: 400; }
.faq-item[open] summary::after { content: "–"; }
.faq-item .a { padding: 0 22px 20px; color: var(--ink-700); font-size: var(--fs-card-desc); line-height: var(--lh-body); }
.faq-group h3 { font-size: var(--fs-card-title); line-height: var(--lh-card); color: var(--blue-700); margin: 34px 0 14px; }
.faq-group:first-child h3 { margin-top: 0; }

/* ---------- Contact ---------- */
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: flex-start; }
.form-field { margin-bottom: 16px; }
.form-field label { display: block; font-weight: var(--fw-label); font-size: var(--fs-label); margin-bottom: 6px; color: var(--ink-900); }
.form-field input, .form-field select, .form-field textarea {
  width: 100%; padding: 12px 14px; border: 1.5px solid var(--blue-200); border-radius: var(--radius-sm);
  font-size: var(--fs-card-desc); font-family: inherit; outline: none; background: #fff;
}
.form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--blue-500); }
.form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.contact-info-card { background: var(--blue-50); border: 1px solid var(--blue-100); border-radius: var(--radius-lg); padding: 26px; margin-bottom: 18px; }
.contact-info-card h4 { font-size: .875rem; font-weight: 600; line-height: 1.25; text-transform: none; letter-spacing: var(--ls-label-tight); color: var(--blue-600); margin-bottom: 5px; }
.contact-info-card .val { font-size: .8125rem; line-height: 1.45; font-weight: var(--fw-label); color: var(--ink-900); }
/* The address wraps to several lines, so it sits one step down from the
   single-line phone/email values; the email keeps the root size so a long
   address does not force the whole card's type larger. Both were inline
   style= overrides before. */
.contact-info-card .val-address { font-size: .8125rem; font-weight: var(--fw-strong); line-height: 1.45; }
.contact-info-card .val-email   { font-size: .8125rem; }
.map-embed { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--blue-100); }
.map-embed iframe { width: 100%; height: 320px; border: 0; display: block; }
.form-note { font-size: var(--fs-caption); color: var(--ink-500); margin-top: 10px; }

/* ---------- Blog ---------- */
.blog-card { background: #fff; border: 1px solid var(--blue-100); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
.blog-card .thumb { aspect-ratio: 16/10; background: linear-gradient(135deg, var(--blue-600), var(--blue-300)); display: flex; align-items: center; justify-content: center; }
.blog-card .thumb span { color: #fff; font-size: var(--fs-tag); font-weight: var(--fw-label); text-transform: none; letter-spacing: var(--ls-label-tight); opacity: .9; }
.blog-card .body { padding: 20px; }
.blog-card .cat { font-size: var(--fs-tag); font-weight: var(--fw-label); line-height: var(--lh-tight); color: var(--blue-600); text-transform: none; letter-spacing: var(--ls-label-tight); }
.blog-card h3 { font-size: var(--fs-card-title); line-height: var(--lh-card); margin: 8px 0; }
.blog-card p { font-size: var(--fs-card-desc); line-height: var(--lh-body); }
/* Container stays at the root size so the `em` values on its children
   resolve against 16px instead of compounding. */
.article-body { max-width: 760px; margin: 0 auto; }
/* Article headings run a step below the global h1–h3: a 760px measure
   column does not need 48px display type, and the tighter ramp keeps the
   heading-to-prose contrast the same as everywhere else. This replaces an
   identical inline `font-size:clamp(26px,3.4vw,40px)` that had been
   pasted onto the h1 of all nine article pages. */
.article-body h1 { font-size: var(--fs-h3); line-height: var(--lh-title); letter-spacing: var(--ls-title); margin: 0 0 .4em; }
.article-body p, .article-body li { font-size: var(--fs-body); line-height: var(--lh-body); }
.article-body h2 { font-size: var(--fs-h5); margin-top: 38px; color: var(--blue-800); }
.article-body h3 { font-size: var(--fs-h6); margin-top: 26px; }
/* Article prose headings must not reach into embedded COMPONENTS. Nine
   article pages embed .product-card blocks, and `.article-body h3` (two
   classes + a tag) out-specifies `.product-card h3`, so the same card
   title rendered 19.2px inside an article and 20px everywhere else. These
   put the component back in charge of its own typography. */
.article-body .product-card h3,
.article-body .blog-card h3,
.article-body .need-card h3 {
  font-size: var(--fs-card-title);
  line-height: var(--lh-card);
  margin-top: 0;
}
/* The category label above an article headline. `.cat-tag` previously had
   rules only under .product-card, .pd-info and .stage-copy — so the bare
   one used on all nine article pages matched nothing and rendered as
   unstyled default text. This is the label step of the ramp. */
.article-body .cat-tag,
.cat-tag {
  font-size: var(--fs-tag); font-weight: var(--fw-label);
  line-height: var(--lh-tight); letter-spacing: var(--ls-label-tight);
  text-transform: none; color: var(--blue-600);
  margin-bottom: 10px;
}
.article-body ul { margin: 0 0 18px; padding-left: 22px; list-style: disc; }

/* ---------- Pull quote + attribution (About) ----------
   Was three inline style= blocks, one of which asked for font-weight:800
   — a weight General Sans does not ship, so the browser faked it with a
   synthetic bold. 700 is the real ceiling and is what renders here. */
.quote-copy { font-style: italic; color: var(--ink-900); }
.attribution { margin-top: 18px; font-weight: var(--fw-title); color: var(--blue-700); }
.attribution-role {
  display: inline-block; margin-top: 2px;
  font-size: var(--fs-label); font-weight: var(--fw-label);
  color: var(--ink-500);
}
.footnote { margin-top: 26px; color: var(--ink-500); }
.article-body li { margin-bottom: 8px; color: var(--ink-700); }
.article-meta { display: flex; gap: 16px; align-items: center; color: var(--ink-500); font-size: var(--fs-label); margin-bottom: 30px; }

/* ---------- Support ---------- */
.support-card { background: #fff; border: 1px solid var(--blue-100); border-radius: var(--radius-lg); padding: 30px; box-shadow: var(--shadow-sm); text-align: center; }
.support-card .icon { width: 56px; height: 56px; border-radius: 16px; background: var(--blue-100); color: var(--blue-700); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
.support-card .icon svg { width: 26px; height: 26px; }

/* ---------- Timeline (About) ---------- */
.timeline { position: relative; padding-left: 30px; border-left: 3px solid var(--blue-200); }
.timeline-item { position: relative; padding-bottom: 34px; }
.timeline-item::before { content: ""; position: absolute; left: -39px; top: 2px; width: 16px; height: 16px; border-radius: 50%; background: var(--blue-600); border: 3px solid var(--blue-100); }
.timeline-item h4 { font-size: 1em; color: var(--blue-700); margin-bottom: 4px; }
.timeline-item p { font-size: var(--fs-label); margin: 0; }

/* ---------- Footer ----------
   Full-viewport footer, laid out as three stacked bands: signup + link
   columns on top, the oversized wordmark in the middle, legal/social and
   the copyright line at the base.

   The one-screen lock follows SECTION-HEIGHTS.md. It is safe here because
   the wordmark row is the flexible element — it takes whatever height the
   other two bands leave and scales its own type to fit, so the content
   flexes to the box rather than the box to the content. Released below
   1200px, where the link columns have to stack and one screen stops being
   achievable. */
.site-footer {
  background: var(--gradient-deep);
  color: rgba(255,255,255,.78);
  height: 100svh;
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
  padding: 0;
  overflow: hidden;
}
.site-footer > .container {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding-top: 58px;
  padding-bottom: 26px;
}

/* --- Top band: signup left, link columns right --- */
.footer-top {
  display: grid;
  grid-template-columns: minmax(300px, 1fr) auto;
  gap: 40px 60px;
  align-items: start;
}
.footer-signup h2 {
  color: #fff;
  /* Deliberately below the section step — footer copy stays quieter than
     page content — but on the ramp (--fs-h4) with the shared heading
     leading and tracking rather than three hand-picked values. */
  font-size: var(--fs-h4);
  line-height: var(--lh-title);
  letter-spacing: var(--ls-title);
  margin: 0 0 26px;
  max-width: 460px;
}
/* The underlined inline field: no box, just a rule with the arrow parked
   at its right end. */
.signup-form {
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 460px;
  border-bottom: 1.5px solid rgba(255,255,255,.45);
  padding-bottom: 10px;
  transition: border-color .25s ease;
}
.signup-form:focus-within { border-bottom-color: #fff; }
.signup-form input {
  flex: 1;
  min-width: 0;
  background: none;
  border: 0;
  padding: 4px 0;
  color: #fff;
  font-family: inherit;
  font-size: 1.0625em;  /* 17px */
}
.signup-form input::placeholder { color: rgba(255,255,255,.55); }
.signup-form input:focus { outline: none; }
.signup-form button {
  flex: none;
  width: 34px; height: 34px;
  display: grid; place-items: center;
  background: none; border: 0; cursor: pointer;
  color: #fff;
  transition: transform .25s cubic-bezier(.34,1.56,.64,1);
}
.signup-form button:hover { transform: translateX(3px); }
.signup-form svg { width: 22px; height: 22px; }

.footer-nav {
  display: grid;
  grid-template-columns: repeat(4, minmax(120px, max-content));
  gap: 30px 44px;
}
.footer-nav h5 {
  color: #fff;
  font-size: var(--fs-label);
  font-weight: var(--fw-label);
  text-transform: none;
  letter-spacing: var(--ls-label-tight);
  margin-bottom: 16px;
}
.footer-nav li { margin-bottom: 9px; font-size: var(--fs-label); font-weight: var(--fw-body); }
.footer-nav a { color: rgba(255,255,255,.78); transition: color .2s ease; }
.footer-nav a:hover { color: #fff; }
.footer-addr {
  color: rgba(255,255,255,.6);
  max-width: 230px;
  /* Sized explicitly: as a <p> it inherited the 18px prose step, which
     made the address the loudest thing in the footer — a step ABOVE the
     column heads it sits under. Footer copy is chrome, so it matches the
     link size beside it. */
  font-size: var(--fs-label);
  line-height: var(--lh-body);
  margin-top: 14px;
}
.footer-addr p { font-size: inherit; line-height: inherit; color: inherit; }

/* --- Middle band: the oversized wordmark ---
   flex:1 hands it the leftover height; the clamp keeps the glyphs filling
   the container width across desktop sizes without ever outgrowing the
   band it sits in. */
.footer-wordmark {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28px 0;
  user-select: none;
}
.footer-wordmark span {
  display: block;
  width: 100%;
  text-align: center;
  font-weight: 700;
  font-size: clamp(4rem, 19.5vw, 19rem);
  line-height: .82;
  letter-spacing: .01em;
  color: #fff;
  white-space: nowrap;
}

/* --- Base band: legal links left, social right, then the copyright --- */
.footer-base {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px 24px;
  padding-bottom: 18px;
}
.footer-base .legal-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 26px;
  font-size: .8125em;  /* 13px */
}
.footer-base .legal-links a { color: rgba(255,255,255,.8); }
.footer-base .legal-links a:hover { color: #fff; text-decoration: underline; }
.footer-social { display: flex; gap: 10px; }
.footer-social a {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
  display: flex; align-items: center; justify-content: center;
  color: #fff;
  transition: background .2s ease, transform .2s ease;
}
.footer-social a:hover { background: rgba(255,255,255,.18); transform: translateY(-2px); }
.footer-social svg { width: 16px; height: 16px; }
.footer-copy {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 6px 24px;
  border-top: 1px solid rgba(255,255,255,.14);
  padding-top: 16px;
  font-size: var(--fs-caption);
  color: rgba(255,255,255,.55);
}

/* ---------- Legal ---------- */
.legal-body { max-width: 800px; margin: 0 auto; }
.legal-body h2 { font-size: var(--fs-h5); line-height: var(--lh-title); color: var(--blue-800); margin-top: 32px; }
.legal-body p, .legal-body li { color: var(--ink-700); font-size: var(--fs-card-desc); line-height: var(--lh-body); }
.legal-body ul { padding-left: 20px; list-style: disc; margin-bottom: 16px; }

/* ---------- Utility ---------- */
.mt-0 { margin-top: 0; }
.text-center { text-align: center; }
.tag-list { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
.divider { height: 1px; background: var(--blue-100); margin: 40px 0; }

/* ---------- Responsive ---------- */
/* The footer's one-screen lock is released here, at 1200px, not at the
   1080px breakpoint below. SECTION-HEIGHTS.md sets the release at 1200px,
   and the two must agree: between 1201px and 1081px the layout has already
   reflowed while the lock would still be pinning the box to 100svh, and
   `overflow: hidden` then clips everything below the fold — the whole
   footer renders as an empty band with only the middle of the wordmark
   showing. Keep this block above the 1080px one and do not fold it in. */
@media (max-width: 1200px) {
  .site-footer {
    height: auto;
    min-height: 0;
    max-height: none;
    overflow: visible;
  }
  .site-footer > .container { padding-top: 52px; padding-bottom: 24px; }
  .footer-top { grid-template-columns: 1fr; gap: 40px; }
  .footer-nav { grid-template-columns: repeat(4, minmax(120px, 1fr)); }
  .footer-wordmark { padding: 34px 0; }
  .footer-wordmark span { font-size: clamp(3.5rem, 20vw, 13rem); }
}
@media (max-width: 1080px) {
  /* The four link columns fall to two once the signup has stacked above
     them and there is no longer width to keep them side by side. */
  .footer-nav { grid-template-columns: repeat(2, minmax(140px, 1fr)); }
  /* .why-grid deliberately has no rule here. Its columns, width, crop and
     entrance distances all move together and live in the Why Jagruti block
     above — an override at this breakpoint is what previously collapsed
     that grid into a narrow strip. */
  .related-strip { grid-template-columns: repeat(2, 1fr); }
  .fit-grid { grid-template-columns: repeat(3, 1fr); }
  /* Tablet keeps the two columns — there is still width for them — with the
     cards and gutter stepped down proportionally. */
  .split-grid { gap: 20px; }
  .split-card { height: clamp(320px, 38vw, 390px); }
  .split-card .content { padding: 26px; }
}
@media (max-width: 900px) {
  /* Gutter tightens with the viewport; every .container follows. */
  :root { --gutter: 24px; }

  /* Tablet type step. Without this, headings held their full desktop size
     all the way down to the 600px phone breakpoint and then dropped in one
     jump — so the worst heading wrapping on the whole site happened in the
     600-900px band, where a 40px h2 met a single-column layout. The root's
     fluid clamp narrows the gap but does not close it, because the ratio
     between heading and body is fixed in the ramp.

     One deliberate step between desktop and phone, sized so the two-line
     h2s in this band stay two lines. Body copy is NOT stepped: it is
     already near its comfortable floor and the single column gives it more
     measure, not less. */
  h1 { font-size: 2.5em; }   /* 40px */
  h2 { font-size: 2.1em; }   /* 34px */
  h3 { font-size: 1.8em; }   /* 29px */
  h4 { font-size: 1.6em; }   /* 26px */
  h5 { font-size: 1.35em; }  /* 22px */
  .page-hero h1    { font-size: 2.5em; }
  .pd-info h1      { font-size: 2.1em; }
  .u-display { font-size: 3em; }
  .u-title   { font-size: 2.1em; }
  .pd-grid, .split-grid, .contact-grid, .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  /* Stacked: each card takes the full column width and keeps its own
     top-left-anchored open, but shorter and with no sideways travel — the
     diagonal offset only makes sense against a neighbouring column. */
  .split-grid { gap: 18px; }
  .split-card { height: clamp(280px, 56vw, 340px); border-radius: 12px; }
  .split-card .content { padding: 24px; }
  /* Same corner-opening gesture, shorter and less extreme: a stacked card is
     already full-width, so it only needs to open from half height. */
  .js .split-grid[data-reveal] .split-card,
  .js .split-grid[data-reveal] .split-card:nth-child(2) {
    transform: scale(.55, .5);
    transition: opacity .45s cubic-bezier(.16, 1, .3, 1),
                transform .95s cubic-bezier(.16, 1, .3, 1);
  }
  .js .split-grid[data-reveal] .split-card img,
  .js .split-grid[data-reveal] .split-card video,
  .js .split-grid[data-reveal] .split-card .content,
  .js .split-grid[data-reveal] .split-card:nth-child(2) img,
  .js .split-grid[data-reveal] .split-card:nth-child(2) video,
  .js .split-grid[data-reveal] .split-card:nth-child(2) .content {
    transform: scale(1.8182, 2);  /* 1/.55, 1/.5 */
    transition: transform .95s cubic-bezier(.16, 1, .3, 1);
  }
  .js .split-grid[data-reveal] .split-card .content {
    transition: transform .95s cubic-bezier(.16, 1, .3, 1),
                opacity .4s ease .4s;
  }
  .steps-row { grid-template-columns: repeat(2, 1fr); }
  /* Hero: content stacks below 900px, so release the one-screen lock and
     let the section take its natural height instead of clipping. */
  .hero { height: auto; min-height: 0; padding: 0 0 40px; }
  /* The parallax hero has no flowing content to give it height (the copy is
     commented out), so it keeps an explicit one-screen box of its own. */
  .hero-parallax { height: 100svh; min-height: 460px; padding: 0; }
  /* Stacked layout: the photo moves out of the section background and into
     the stage band itself, so it never sits behind the stacked text. */
  .hero::before { content: none; }
  .hero::after { background: linear-gradient(180deg, rgba(0,26,42,.35) 0%, transparent 40%, rgba(0,22,35,.55) 100%); }
  .hero .container { display: block; height: auto; min-height: 0; }
  /* The stage becomes a plain band showing the photo; the callout lists are
     pushed out below it rather than overlapping it. */
  .hero-stage { display: block; margin: 6px 0 0; padding-top: 60vw; position: relative; min-height: 0; }
  /* The right-hand column unpins and flows under the photo band. The
     sub-line moves to the top of the stage so it still reads directly
     beneath the headline rather than stranded between callouts. */
  .hero-right-col { position: static; display: block; max-height: none; }
  .hero-sub {
    position: absolute; top: 0; left: 0; right: 0; margin: 0;
    text-align: center; width: auto;
  }
  /* Room above the photo band for that line. */
  .hero-stage { padding-top: calc(60vw + 3.4em); }
  .hero-stage::before { top: 3.4em; }
  /* Photo lives on its own layer so the feather mask never touches the
     callout lists that follow it. */
  .hero-stage::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 60vw;
    background: url("../images/Home%20page/page%20background.png") no-repeat 50% 50% / contain;
    -webkit-mask-image: linear-gradient(to bottom, #000 66%, transparent 98%),
                        linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-composite: source-in;
            mask-image: linear-gradient(to bottom, #000 66%, transparent 98%),
                        linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
            mask-composite: intersect;
  }
  .hero h1 { font-size: clamp(38px, 9vw, 72px); }
  /* Unpin the overlaid callouts and let them stack under the shot. */
  .hero-feats, .hero-feats-left, .hero-feats-right {
    position: static; transform: none; top: auto; bottom: auto; left: auto; right: auto;
  }
  .hero-feats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 16px; margin-top: 24px; }
  .hero-feats-right { margin-top: 20px; }
  .hero-feats span { max-width: none; }
  /* Callouts now sit below the shot, so the CTA pull-up no longer applies. */
  .hero .hero-cta { margin-top: 28px; }
  .hero-cats { grid-template-columns: 1fr 1fr; gap: 6px 0; }
  .hero-cats > a:nth-child(2n) { border-right: 0; }
  /* Stats on tablets: five items never split evenly across a row, so the
     dividers are dropped for a tile grid - 2 up, with the fifth stat
     spanning the full width so no orphan is left dangling. */
  .hero-stats { flex-wrap: wrap; justify-content: center; gap: 16px 0; }
  .hero-stats > div { flex: 0 0 50%; }
  .hero-stats > div + div::before { display: none; }
  .hero-stats > div {
    justify-content: flex-start;
    gap: 14px;
    padding: 16px 18px;
  }
  .hero-stats > div:last-child { flex: 0 0 100%; justify-content: center; }
  .compare-select-row { grid-template-columns: 1fr; }
  .mobile-bar { display: block; }
  :root { --mobile-bar-h: 50px; }
  /* The home page drops the sticky call/WhatsApp bar, so the hero cue and
     dots sit against the true viewport bottom there.

     Hidden in CSS rather than deleted from the markup on purpose: the footer
     is a shared partial, and assets/js/build-partials.js rewrites every
     page's FOOTER block from footer.html, so any markup removed here is put
     straight back the next time that script runs. Editing footer.html would
     instead drop the bar from every page, which is not what is wanted. */
  :root:has(.hero-parallax) { --mobile-bar-h: 0px; }
  :root:has(.hero-parallax) .mobile-bar { display: none; }
  /* On tablet and mobile the header's "Get Price" action is dropped from the
     bar and carried by the sticky mobile action bar instead, so the narrow
     header holds only MENU and the wordmark.

     Hidden in CSS rather than removed from the markup: navbar.html is a
     shared partial and build-partials.js rewrites each page's NAVBAR block,
     so deleted markup comes straight back the next time it runs. */
  .header-actions { display: none; }

  body { padding-bottom: 0; }
  .form-row-2 { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  :root { --gutter: 18px; }
  /* Mobile type scale. The reference only overrode h1/h3/h5 and left h2
     at full desktop size on phones — that gap is closed here. */
  h1 { font-size: 2.1em; }   /* 34px */
  h2 { font-size: 1.8em; }   /* 29px */
  /* These three now take ramp steps rather than bespoke desktop sizes
     (--fs-h1 / --fs-h2), so they only need to be re-pointed at the mobile
     step here — not given a third set of hand-picked numbers. The product
     h1 stays one notch below the page-hero h1 because it shares its row
     with the gallery even on a phone. */
  .page-hero h1 { font-size: 2.1em; }
  .pd-info h1   { font-size: 1.8em; }
  h3 { font-size: 1.6em; }   /* 26px */
  h4 { font-size: 1.45em; }  /* 23px */
  h5 { font-size: 1.3em; }   /* 21px */
  h6 { font-size: 1.1em; }   /* 18px */
  /* The root is already at its 14px floor here, so body copy keeps its
     1.13em rather than stepping down again — a second reduction would
     land prose at 14px, below comfortable reading size on a phone. */
  p, li, blockquote { font-size: 1.13em; }  /* ~15.8px at the 14px floor */
  .section-head p  { font-size: 1.13em; }
  .need-section .section-head p,
  .ranges-section .section-head p { font-size: var(--fs-small); }

  /* Display steps down hard on a phone — 60px would overflow a narrow
     screen. The rest of the ramp rides the root's 14px floor and needs
     no override. */
  .u-display { font-size: 2.4em; }
  .u-title   { font-size: 1.8em; }

  .related-strip { grid-template-columns: 1fr 1fr; }
  .feature-list { grid-template-columns: 1fr; }
  .fit-grid { grid-template-columns: repeat(2, 1fr); }
  /* The token's own clamp floor already lands near this on a phone, but
     it is stated here because the vh term can still drift on a tall narrow
     device; this keeps phone sections compact and content-driven. */
  .section { padding-block: clamp(44px, 5.5vh, 64px); }
  .footer-signup h2 { font-size: 1.5em; }
  .footer-nav { grid-template-columns: 1fr 1fr; gap: 26px 20px; }
  .footer-addr { max-width: none; }
  .footer-base { justify-content: flex-start; }
  .footer-wordmark { padding: 26px 0; }
  .footer-copy { font-size: var(--fs-caption); }
  .hero-feats { grid-template-columns: 1fr; gap: 16px; }
  .hero-cats { grid-template-columns: 1fr; }
  .hero-cats > a { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.12); padding: 12px 16px; }
  .hero-cats > a:last-child { border-bottom: 0; }
  /* Phones: the same tile grid, tightened - icon above the figure so each
     tile is a compact square block, and the fifth stat runs full width as a
     wide footer tile rather than sitting alone in a half-empty row. */
  .hero-stats { flex-wrap: wrap; justify-content: center; gap: 14px 0; }
  .hero-stats > div { flex: 0 0 50%; }
  .hero-stats > div + div::before { display: none; }
  .hero-stats > div {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 16px 12px;
  }
  .hero-stats div div { align-items: center; }
  .hero-stats .ic svg { width: 28px; height: 28px; }
  .hero-stats strong { font-size: 1em; }
  .hero-stats > div:last-child {
    flex: 0 0 100%;
    flex-direction: row;
    gap: 12px;
    padding: 14px 16px;
  }
  .hero-stats > div:last-child div { align-items: flex-start; text-align: left; }
}

/* --- FULL-BLEED PORTRAIT HERO (phones + portrait tablets) ----------------
   The scene art is a 16:9 export; a portrait phone is roughly 9:19. The old
   treatment letterboxed it into a 16:9 band with the copy stacked below on
   a white ground, which read as a banner rather than a hero.

   Here the artwork instead FILLS the section edge to edge (100svh, cover)
   and the copy sits on top of it, in the upper third, where the artwork's
   own sky is empty. That works because `cover` on a tall viewport crops the
   16:9 horizontally, and the composition's subject - product on its podium,
   with the leaf frame hugging the corners - is centred, so the crop keeps
   exactly what matters. `object-position` is pulled slightly below centre so
   the podium and its reflection stay in frame while the sky, which the copy
   covers anyway, is what gets trimmed off the top.

   Every layer keeps its own entrance transform, so the full parallax
   animation still plays; only the framing changes. */
@media (max-aspect-ratio: 1/1) and (max-width: 1024px) {

  /* Back to a true viewport-height hero. The scene wrapper is the section's
     own absolute overlay again (base rule), so nothing here re-stacks it. */
  .hero-parallax {
    --hero-h: 100svh;
    display: block;
    /* Full-viewport hero on portrait, same as desktop. Shrinking the SECTION
       was once how the subject was scaled down, but that bought a smaller
       machine at the cost of a hero that no longer filled the screen and let
       the next section peek in. --stage-over on the stage below now does
       that job on its own - it zooms the artwork out WITHIN a full-height
       section - so the height is free to go back to the full viewport. */
    height: var(--hero-h); min-height: 460px;
    aspect-ratio: auto;
    padding-top: 0;
    background: #559bcd;
  }
  /* --- Subject size ----------------------------------------------------
     The artwork is a 16:9 canvas and the viewport is portrait, so `cover`
     scales it until the HEIGHT fits and crops the sides away. The machine
     and its burst then fill far more of the frame than in the reference.

     Two approaches that do NOT work, for the record: widening the stage
     (past 16:9 the height drives the scale again, so nothing changes), and
     scaling the layers individually (every layer is an export of one shared
     canvas and they only stay registered while they transform together -
     shrink the machine alone and it lifts off the podium it stands on).

     What works is giving the stage MORE HEIGHT than the section and letting
     the section clip it. `cover` fits that taller box, so the composition
     renders smaller relative to the viewport, and the surplus is cropped off
     the top and bottom - sky and water, the parts there is most to spare of
     - while the artwork still bleeds to all four edges. */
  .hero-parallax { overflow: hidden; }
  /* --- How the composition is scaled ---------------------------------
     `cover` magnifies the 16:9 artwork until it fills the box on BOTH axes,
     so on a tall portrait box the height drives the scale and the machine is
     blown up far past the reference. Simply making the stage taller does not
     help - it makes the box even more extreme and magnifies further.

     Instead the stage is given the artwork's OWN aspect ratio and sized by
     WIDTH. `cover` then has nothing left to make up: the composition renders
     at its natural proportions, the full podium and arches stay in frame,
     and the machine reads at the size it does in the reference. --stage-w
     is the zoom control - above 100% the art is wider than the viewport and
     crops in slightly; below 100% it pulls further back. */
  .hero-parallax .hero-stagewrap {
    --stage-w: 215%;
    /* Zoomed out, the stage is well short of the section's height and the
       leftover ground splits evenly above and below. The copy occupies the
       top, so the scene is nudged DOWN off centre - that spends the surplus
       where the copy already covers it and keeps the podium clear of the
       scroll cue, rather than leaving a wide empty band under the water. */
    --stage-y: 62%;
    position: absolute; left: 50%; right: auto;
    top: var(--stage-y); bottom: auto;
    width: var(--stage-w); height: auto;
    aspect-ratio: 16 / 9;
    transform: translate(-50%, -50%);
  }
  /* Sized by width, the 16:9 stage is SHORTER than a portrait section, so a
     band of section ground is left above and below it. Filling those bands
     with the artwork's own edge colours - sampled from the scene plates,
     sky at the top and water at the bottom - makes them read as more sky and
     more water rather than as empty margins, and the soft stops let the
     stage's real edges dissolve instead of showing as seams. */
  .hero-parallax {
    background:
      linear-gradient(180deg,
        #5e9ccb 0%, #5e9ccb 18%,
        #5b9dce 32%, #4fa0d0 62%,
        #4d9fd0 82%, #4d9fd0 100%);
  }
  /* The stage's top and bottom edges meet that ground on a straight line,
     which reads as a seam however well the colours match. Fading the artwork
     out over a short distance at each edge dissolves the join, so the sky and
     water simply continue into the band. */
  .hero-parallax .hero-stagewrap {
    /* The top edge is open sky, so it can take a long fade without losing
       anything. The bottom is water whose own colour already matches the
       ground beneath it, and a long fade there would wash out the podium's
       reflection - so it gets only a short one, just enough to kill the
       line. */
    -webkit-mask-image: linear-gradient(180deg,
      transparent 0, #000 16%, #000 96%, transparent 100%);
            mask-image: linear-gradient(180deg,
      transparent 0, #000 16%, #000 96%, transparent 100%);
  }
  .hero-scene .hl {
    /* The stage now matches the art's ratio, so `contain` and `cover` agree;
       `cover` is kept so any rounding is absorbed rather than letting the
       section ground show as a hairline. */
    object-fit: cover;
    object-position: 50% 50%;
  }
  /* --- Making the handover sweep the whole hero ------------------------
     The stage carries the artwork's 16:9 ratio, so it - and every scene box
     inside it - is SHORTER than the section. The reveal is the top edge of
     the entering scene's box, so it could only ever uncover that short box:
     the handover visibly stopped partway up the screen.

     So each scene is stretched beyond the stage, far enough to reach the
     section's edges (--scene-bleed), while .hero-plate inside it stays put.
     The reveal edge now starts below the fold and travels past the top of
     the section, sweeping the entire hero, and because the plate is not
     stretched with it the artwork itself is unchanged.

     The climb distance has to grow to match, or the scene would stop short
     of covering its own taller box. */
  .hero-scene {
    --scene-bleed: 100svh;
    top: calc(-1 * var(--scene-bleed));
    bottom: calc(-1 * var(--scene-bleed));
  }
  .hero-scene .hero-plate {
    /* Puts the artwork back exactly where the stage had it, undoing the
       bleed for the layers only. */
    top: var(--scene-bleed);
    bottom: var(--scene-bleed);
  }
  :root { --scene-travel: 100svh; }
  /* Every layer is an export of ONE shared canvas, so they only compose
     correctly while they share an identical fit AND object-position - an
     exception for any single plane slides it off the others. Scaling the
     canvas leaf plane up on its own therefore is not an option, and once
     the stage is zoomed out its fronds sit well inside the frame instead of
     hugging the corners. So it is dropped here and replaced by the two
     dedicated corner plates, which are independent of the canvas. */
  .hl-leaf { display: none; }

  /* Above the ::before scrim (z-index 4), not below it. The scrim is a dark
     blue wash whose densest band is along the TOP edge - exactly where the
     two upper leaf clusters sit - so painting it over the foliage drained
     the greens and read as the leaves being washed out. It is there to keep
     the white copy legible against the bright sky, which only requires it to
     sit over the SKY; the copy is lifted to z-index 6 and so clears both.
     Putting the frame above it lets the foliage keep its own colour while
     the scrim goes on doing its job behind it. */
  .hero-leafframe {
    display: block;
    position: absolute; inset: 0; z-index: 5;
    pointer-events: none;
    overflow: hidden;
  }
  /* Each plate is a 16:9 export whose foliage sits against transparency in
     one corner region. Sized by WIDTH the art keeps its natural proportions
     and a sane on-screen scale (stretching it to the frame's full height
     with `cover` blows the fronds up until they swallow the machine).

     One instance is then anchored per corner, the bottom pair mirrored
     vertically so their fronds reach up and in rather than down and out.
     --leaf-w tunes how far into the frame the foliage reaches. */
  .hero-leafframe {
    /* How far each plate reaches in from its corner. Wider plates put more
       foliage over the frame rather than clinging to the very edge. */
    --leaf-w: 72%;
  }
  .hero-leafframe .hlf {
    position: absolute;
    width: var(--leaf-w); height: auto;
    object-fit: contain;
    /* The plates are 16:9 rectangles laid over the scene, and their PNG
       ground is not perfectly clear where it meets the section's scrim - the
       plate's own bottom edge showed as a straight line across the hero.
       Fading each one out towards its inner edge removes that boundary.

       The ramp is deliberately LATE and SHORT. It only has to hide the
       plate's own edge, so it stays fully opaque across the whole foliage
       region and does its fading in the last stretch of empty ground. The
       earlier 55%->100% ramp spread the falloff over most of the plate,
       which washed the fronds out and drained their colour - the leaves
       were being masked, not just their edge. */
    -webkit-mask-image: linear-gradient(180deg, #000 88%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 88%, transparent 100%);
  }
  /* The bottom pair carries its foliage in the LOWER half of the plate, so
     the top-down fade above would erase exactly the part that shows. Theirs
     runs the other way: solid at the bottom, fading out towards the centre
     of the frame. */
  .hlf-bl, .hlf-br {
    -webkit-mask-image: linear-gradient(0deg, #000 88%, transparent 100%);
            mask-image: linear-gradient(0deg, #000 88%, transparent 100%);
  }
  /* Page1R1 carries one cluster, bottom-right, so the two BOTTOM corners use
     it directly with the left one mirrored. The top pair uses Page1L1top - a
     variant of Page1L1 with its lower half cleared. The full L plate carries
     clusters top-left AND bottom-left, and since a plate spans the whole
     frame, that second cluster landed a third of the way down the hero as a
     stray leaf under each top corner. Cropping to the top cluster leaves one
     piece of foliage per corner, which is all the frame wants. */
  .hlf-tl { top: 0; left: 0;  transform: scale(1.10); transform-origin: center; }
  .hlf-tr { top: 0; right: 0; transform: scaleX(-1) scale(1.10); transform-origin: center; }
  /* scaleY(-1) mirrors the mask along with the image, so the bottom pair
     fades towards the centre too without needing its own gradient. */
  /* Mirrors reflect about the box's own CENTRE. With the origin on an edge
     instead, the flip threw the plate clean out of the frame - which is why
     only the top pair was showing. */
  .hlf-bl { bottom: 0; left: 0;  transform: scaleX(-1) scale(1.10); transform-origin: center; }
  .hlf-br { bottom: 0; right: 0; transform: scale(1.10); transform-origin: center; }

  /* --- Entrance: the desktop leaf plane's move, exactly ---------------
     The portrait corner plates play the SAME entrance as the desktop canvas
     leaf plane: heroLeafIn - fade up from an over-scaled 1.20 and settle to
     the resting 1.10, no travel and no rotation, 1200ms on
     cubic-bezier(.22,.61,.36,1) cued at +560ms so the foliage sweeps in
     after the machine has begun rising, just as it does on desktop.

     It is keyed off the state classes the same way too. The frame lives
     outside the scenes, so JS mirrors .is-current / .is-entering / .is-first
     onto it (see initHeroScenes) - which is what makes the plates replay
     their entrance on EVERY scene change rather than only once on load.

     Each corner still needs its own keyframes: an animated `transform`
     replaces the property outright, so a single shared track would drop the
     corner's scaleX(-1) and flip the plate back mid-animation. The move
     inside each is identical - only the mirror differs. */
  .js .hero-leafframe .hlf { opacity: 0; }
  .js .hero-leafframe.is-current .hlf,
  .js .hero-leafframe.is-entering .hlf {
    animation-duration: 1200ms;
    animation-timing-function: cubic-bezier(.22,.61,.36,1);
    animation-delay: 560ms;
    animation-fill-mode: both;
  }
  .js .hero-leafframe.is-current .hlf-tl,
  .js .hero-leafframe.is-entering .hlf-tl { animation-name: heroLeafFrameTL; }
  .js .hero-leafframe.is-current .hlf-tr,
  .js .hero-leafframe.is-entering .hlf-tr { animation-name: heroLeafFrameTR; }
  .js .hero-leafframe.is-current .hlf-bl,
  .js .hero-leafframe.is-entering .hlf-bl { animation-name: heroLeafFrameBL; }
  .js .hero-leafframe.is-current .hlf-br,
  .js .hero-leafframe.is-entering .hlf-br { animation-name: heroLeafFrameBR; }

  /* Desktop's heroLeafIn, once per corner so each keeps its own mirror. */
  @keyframes heroLeafFrameTL {
    from { opacity: 0; transform: scale(1.20); }
    to   { opacity: 1; transform: scale(1.10); }
  }
  @keyframes heroLeafFrameTR {
    from { opacity: 0; transform: scaleX(-1) scale(1.20); }
    to   { opacity: 1; transform: scaleX(-1) scale(1.10); }
  }
  @keyframes heroLeafFrameBL {
    from { opacity: 0; transform: scaleX(-1) scale(1.20); }
    to   { opacity: 1; transform: scaleX(-1) scale(1.10); }
  }
  @keyframes heroLeafFrameBR {
    from { opacity: 0; transform: scale(1.20); }
    to   { opacity: 1; transform: scale(1.10); }
  }

  /* Legibility for white copy over the bright sky: a soft top-down scrim
     rather than the desktop's left-column vignette. */
  .hero-parallax::before {
    content: ""; position: absolute; inset: 0; z-index: 4;
    pointer-events: none;
    background: linear-gradient(180deg,
      rgba(0,34,56,.52) 0%, rgba(0,34,56,.30) 26%,
      rgba(0,34,56,.06) 46%, transparent 62%);
  }

  /* --- Copy: centred, in the upper band, over the artwork --------------- */
  .hero-parallax .hero-copywrap {
    position: absolute; z-index: 6;
    left: 0; right: 0; top: calc(var(--header-h) + 4svh);
    display: grid;                 /* all three copies share one cell */
    pointer-events: none;
  }
  .hero-copy {
    grid-area: 1 / 1;
    position: static; transform: none;
    width: auto; max-width: min(90vw, 34rem);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 40px);
    text-align: center;
    color: #fff;
    text-shadow: 0 1px 18px rgba(0,32,52,.55), 0 1px 3px rgba(0,32,52,.5);
  }
  /* Portrait type runs a step smaller than desktop: the artwork is the hero
     and the copy has to clear the machine below it, so the block is kept
     short - a compact eyebrow, a two-line title, and a sub held to roughly
     two lines by a wider measure at a smaller size rather than by wrapping
     more often. */
  /* Intentional exception to --ls-label: at 9.5-11px, the standard .12em
     is not enough to keep uppercase letterforms apart on a phone. Tracking
     opens as size drops — an optical correction, not drift. */
  .hc-eyebrow {
    font-size: clamp(9.5px, 2.4vw, 11px);
    letter-spacing: .18em;
    color: rgba(255,255,255,.9);
    margin-bottom: .6em;
  }
  .hc-title {
    font-size: clamp(23px, 5.6vw, 34px);
    line-height: 1.1;
    text-wrap: balance;
    color: #fff;
    margin-bottom: .42em;
  }
  .hc-title .accent { color: #9fdfff; }
  .hc-sub {
    font-size: clamp(12px, 2.7vw, 14px);
    line-height: 1.45;
    color: rgba(255,255,255,.92);
    /* A wider measure at the smaller size, so the sentence lands in about
       two lines instead of three or four and the block stops rather than
       creeping down over the product. */
    max-width: 25em; margin: 0 auto 1.1em;
    text-wrap: pretty;
  }
  .hc-cta {
    font-size: clamp(12px, 2.9vw, 14px);
    padding: .7em 1.4em;
    pointer-events: auto;
  }

  /* Slide-up entrance, since the copy is no longer vertically centred. */
  .js .hero-copy.is-current {
    animation: heroCopyInFlat 900ms cubic-bezier(.22,.7,.24,1) 1250ms both;
    pointer-events: auto;
  }
  .js .hero-copy.is-leaving { animation: heroCopyOutFlat 400ms ease both; }
  @keyframes heroCopyInFlat {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroCopyOutFlat { from { opacity: 1; } to { opacity: 0; } }

  /* --- Scroll cue: centred at the bottom, as in the reference ----------- */
  .hero-scrollcue {
    position: absolute; z-index: 6;
    left: 50%; right: auto;
    transform: translateX(-50%);
    bottom: calc(var(--mobile-bar-h) + max(14px, 2.4svh));
    flex-direction: column-reverse;   /* pill above, label below */
    gap: .5em;
    color: rgba(255,255,255,.9);
    font-size: clamp(11px, 3.2vw, 13px);
  }
  .hero-scrollcue .hs-arrow {
    /* A mouse-shaped pill rather than a circle, matching the reference. */
    width: 1.5em; height: 2.5em; border-radius: 999px;
    border-color: rgba(255,255,255,.65);
  }
  .hero-scrollcue svg { width: 45%; height: 45%; }

  /* --- Scene indicator: horizontal, clear of the centred cue ------------ */
  .hero-dots {
    left: 50%; transform: translateX(-50%);
    bottom: calc(var(--mobile-bar-h) + max(14px, 2.4svh) + 5.2em);
    flex-direction: row; gap: 1.1em;
    font-size: clamp(10px, 2.8vw, 12px);
  }
  .hero-dots .hd { gap: .5em; }
  .hero-dots .hd i { width: 14px; height: 2px; }
  .hero-dots .hd.is-current i { width: 20px; height: 2px; }
}

/* A portrait tablet is far closer to the artwork's own 16:9 than a phone is,
   so `cover` magnifies less there and less surplus stage height is needed to
   bring the composition down to the same visual weight. */
@media (max-aspect-ratio: 1/1) and (min-width: 561px) and (max-width: 1024px) {
  .hero-parallax .hero-stagewrap { --stage-w: 138%; }
}

/* Phones are too narrow for three scene labels on one row - the indicator
   drops to bare ticks there and the label is carried by the copy's eyebrow. */
@media (max-aspect-ratio: 1/1) and (max-width: 560px) {
  .hero-dots .hd { font-size: 0; gap: 0; padding: 6px 3px; }
  .hero-dots { gap: .5em; }
  .hero-dots .hd i { width: 18px; }
  .hero-dots .hd.is-current i { width: 26px; }
}

/* Short landscape phones: the copy and the cue would collide in a ~380px
   tall viewport, so the cue steps out and the copy tightens. */
@media (min-aspect-ratio: 1/1) and (max-height: 520px) {
  .hero-scrollcue { display: none; }
  .hero-copy .hc-sub { display: none; }
}

/* The hero copy lives in .hero-copywrap, so .hero-parallax > .container is an
   empty box that still carries position:relative and z-index:1 from the base
   hero and paints over the artwork. Declared last so the responsive
   `.hero .container { display: block }` cannot resurrect it. */
.hero-parallax > .container { display: none !important; }

/* The portrait hero is full-bleed artwork again, so the header sits over the
   photo exactly as it does on desktop - the on-light override that the old
   stacked layout needed is gone. */

/* ==========================================================================
   PRELOADER
   The homepage hero paints its layers from opacity:0 and its artwork is a
   stack of large PNGs, so the first frame of the page is an empty coloured
   band. This overlay covers that window: it is painted immediately (the
   .preloading class is set by an inline script in <head>, before first
   paint) and main.js removes it once the first scene's images have decoded
   — or after a hard cap, so a slow connection never traps the visitor.
   ========================================================================== */
.preloader {
  position: fixed; inset: 0; z-index: 999;
  display: grid; place-items: center;
  /* Lighter than the deep cut this replaced, at the cost of separation: the
     logo keeps the artwork's exact #0d8ac4, so lifting the ground toward that
     same blue puts the mark at roughly 3:1 where it sits. Chosen deliberately
     over re-tinting the logo — colour fidelity to the mark wins here. */
  background: linear-gradient(160deg, #032533 0%, #053d57 55%, #064459 100%), #053d57;
  /* No transition here: the fade is driven by .is-done so the overlay never
     animates on the way IN. */
}
/* Without JS the class is never set, so the overlay must not exist as a
   permanent blocker. But this must NOT hide the overlay during the handover:
   finish() drops html.preloading and adds .is-done in the same frame, and a
   plain html:not(.preloading) rule would snap the element to display:none
   instantly, skipping the fade entirely. Excluding .is-done lets the exit
   transition play, after which JS removes the node outright. */
html:not(.preloading) .preloader:not(.is-done) { display: none; }

/* The page underneath must not scroll behind the overlay, and must not be
   read out by assistive tech while it is still assembling. */
html.preloading, html.preloading body { overflow: hidden; }

.pl-inner {
  text-align: center;
  color: var(--brand-primary);
  padding: 0 var(--gutter);
  /* The logo no longer scales on entry — the frame drawing itself IS the
     entrance. The inner block only fades, so the traced line starts at its
     final size and the stroke reads at a constant weight while it travels. */
  transform-origin: 50% 50%;
  will-change: opacity;
  animation: plFadeIn .4s ease both;
}
@keyframes plFadeIn { from { opacity: 0; } to { opacity: 1; } }

/* The frame and the wordmark are stacked in the same box at the same aspect
   ratio, so the drawn outline lands exactly on the artwork's own border. */
.pl-logo {
  position: relative;
  width: min(52vw, 260px);
  aspect-ratio: 986 / 256;
  margin-inline: auto;
}
.pl-frame,
.pl-wordmark {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* THE DRAW.
   pathLength="100" on the rect normalises its perimeter, so the dash values
   are plain percentages and no measuring is needed at runtime. The dash is
   one full-length segment pushed entirely out of view by the offset; easing
   the offset to 0 pulls the line around the path. overflow:visible keeps the
   stroke's outer half from being clipped at the viewBox edge. */
.pl-frame {
  overflow: visible;
  /* The logo's own blue — --brand-primary is already exactly the artwork's
     rgb(13,138,196), so the drawn line and the wordmark it hands off to are
     the same colour by definition rather than by a copied hex. */
  color: var(--brand-primary);
  stroke-dasharray: 100 100;
  stroke-dashoffset: 100;
  animation: plDraw 1.5s cubic-bezier(.65, 0, .35, 1) .15s both;
}
@keyframes plDraw {
  from { stroke-dashoffset: 100; }
  to   { stroke-dashoffset: 0; }
}

/* The letterforms are raster and cannot be traced, so they resolve inside the
   frame once it has closed — the delay is the draw's duration plus its own
   delay, which is what makes the two read as one gesture rather than two
   things happening at once. Blue artwork on the blue overlay would be
   invisible, so it is knocked out to pure white. */
.pl-wordmark {
  object-fit: contain;
  animation: plWordIn .7s cubic-bezier(.16, .84, .32, 1) 1.5s both;
}
@keyframes plWordIn {
  from { opacity: 0; transform: scale(.94); }
  to   { opacity: 1; transform: scale(1); }
}

/* Once the logo is whole, it breathes. Without this the screen is frozen for
   the rest of the wait — which is exactly the complaint this replaces. The
   loop starts after the wordmark has landed and runs until handover. */
.pl-logo {
  animation: plBreathe 2.8s ease-in-out 2.2s infinite both;
}
@keyframes plBreathe {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.035); }
}

/* Handover: the mark retreats exactly the way it arrived — back down to the
   same .35 it grew from, so the intro closes on itself. Its own fade is
   slower than the overlay's, which is what makes the shrink legible rather
   than lost behind the curtain. main.js removes the node when it finishes. */
.preloader.is-done {
  opacity: 0;
  /* Slightly longer than the mark's .55s retreat, and eased so the ground
     lingers early on: the wordmark must finish shrinking before the overlay
     is gone, or the gesture gets cut off mid-way. */
  transition: opacity .6s cubic-bezier(.6, 0, .9, .5);
  pointer-events: none;
}
/* Handover: the logo lifts and fades as one piece. The breathe loop lives on
   .pl-logo and holds its frame via `both`, so the exit has to be declared
   there too or the idle animation would win over a plain transform. */
.preloader.is-done .pl-inner {
  animation: plLogoOut .55s cubic-bezier(.55, 0, .85, .4) both;
}
.preloader.is-done .pl-logo {
  animation: plLogoOut .55s cubic-bezier(.55, 0, .85, .4) both;
}
@keyframes plLogoOut {
  0%   { opacity: 1; transform: scale(1); }
  /* Opacity is held most of the way so the lift is actually seen — fading in
     step with the scale would blank the logo while it is still near full
     size, and the gesture would never register. */
  55%  { opacity: .55; }
  100% { opacity: 0; transform: scale(1.08); }
}

@media (prefers-reduced-motion: reduce) {
  /* No drawing, no breathing for visitors who ask for stillness: the frame is
     simply whole and the logo simply present. The overlay still fades on
     handover, which is a change of state rather than a motion effect. */
  .pl-inner { animation: none; }
  .pl-frame { animation: none; stroke-dashoffset: 0; }
  .pl-wordmark { animation: none; }
  .pl-logo { animation: none; }
  .preloader.is-done .pl-inner,
  .preloader.is-done .pl-logo { animation: none; opacity: 0; transition: opacity .3s ease; }
}

/* ==========================================================================
   Featured — Popular Jagruti Machines
   A pinned, fullscreen poster sequence: one machine owns the screen at a
   time, its name set enormous behind it, cut-out props floating around it,
   and the existing copy set small at the lower left.

   There is no card here by design — no border, no panel, no thumbnail box.
   The machines are alpha cut-outs (assets/images/showcase/) so they sit
   directly on the ground the way an object sits in a photograph.

   Colour is entirely the tokens at the top of this file: the blue scale,
   the ink scale and --page-bg. Nothing new is introduced.
   ========================================================================== */

/* Doubled class for the same reason .section.why-section is doubled — the
   responsive blocks at the foot of this file re-declare .section padding at
   equal specificity and later in source order. The poster is pinned to a full
   viewport and the Why section that follows is its own full viewport, so any
   section padding here shows as a bare band of page background between the
   two. They are meant to meet edge to edge. */
.section.stage {
  position: relative;
  padding: 0;
  background: var(--page-bg);
  /* The pinned child would otherwise be clipped by any ancestor that
     establishes a scroll container. */
  overflow: visible;

  /* --- The showcase grid ---------------------------------------------
     Every layer in this section used to carry its own edge value: the
     copy and the tagline sat on var(--gutter) (40px), the callout row on
     clamp(20px,2.2vw,34px) (~31px) and the arrows on clamp(10px,1.6vw,22px)
     (22px). Three different rails on one poster, so nothing read as
     deliberately aligned to anything else. The four tokens below are now
     the ONLY source of position for the whole section — change one and
     every layer that answers to it moves together.

     --stage-rail   the outer rail. The arrows sit ON it, so it is the true
                    viewport margin and both arrows get the same one.
     --stage-inset  the text rail, one arrow-width plus a gap further in.
                    The tagline, the copy column and the callout row all
                    start here, so left-edge text and right-edge text are
                    equidistant from their own side and neither runs under
                    an arrow.
     --stage-top    the top band. The header and the tagline share it.
     --stage-base   the bottom baseline. The copy/CTA column and the
                    callout row share it, so the bottom of the poster is
                    one bar rather than two blocks at similar heights. */
  --stage-rail: clamp(20px, 2.6vw, 44px);
  --stage-arrow: 42px;
  --stage-inset: calc(var(--stage-rail) + var(--stage-arrow) + clamp(10px, 1.4vw, 24px));
  --stage-top: clamp(16px, 3.6vh, 34px);
  /* The callout row's own right boundary, one step outside the text rail:
     far enough out to give the row the width it wants, still clear of the
     arrow on the right edge. The last tile sits exactly here. */
  --stage-feat-rail: calc(var(--stage-rail) + clamp(6px, 0.9vw, 16px));
  /* One chip's horizontal padding (.spec-chip is padding: 5px 10px). The
     chip row is pulled left by this so the chip's LABEL lands on the same
     rail as the plain-text lines above and the buttons below. */
  --stage-chip-pad: 10px;
  /* Lower than the 8vh the copy and the callouts each used to carry, so
     both bottom blocks sit further down the poster — together, by exactly
     the same amount, which is the whole point of them sharing the token.
     The floor keeps the row clear of the viewport edge on a short window;
     the ceiling stops a tall one from stranding it mid-screen. */
  --stage-base: clamp(34px, 5.4vh, 68px);
}
/* Height is written by JS from the product count — one viewport of travel
   per machine plus the intro and the release. */
.stage-track { position: relative; }

.stage-pin {
  position: sticky;
  top: 0;
  height: 100vh;
  /* The visible frame, matched to the hero: same 100svh unit and the same
     620px floor (.hero { height: 100svh; min-height: 620px }), so a short
     window cannot make this pin shorter than the hero. The TRACK height
     above is untouched — scroll duration and animation timing are
     unchanged; only the frame the pin paints into is pinned. */
  height: 100svh;
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
  overflow: hidden;
  /* A soft blue-into-white wash rather than the flat page background. It
     lives on the PIN, not on .section.stage: the section's track is many
     viewports tall, so a gradient there would only ever show one thin
     slice at a time. On the pin the full blend is visible in every frame.
     Blue is heaviest at the top, passes through a paler mid tone and
     resolves to white at the bottom, so the machines still stand on a
     near-white ground. */
  background:
    linear-gradient(180deg,
      #6aa8e2 0%,
      #93c4ef 34%,
      #c2dcf8 70%,
      #eaf3fd 100%);
  /* The whole poster is centred in this box; every layer inside is
     absolutely placed against it. */
  isolation: isolate;
}

/* --- The two section states -------------------------------------------
   The section is either INTRO or PRODUCTS, never both. The mode is written
   on .stage by the engine (is-intro / is-products) and every layer below
   derives from it, so there is no state in which the section identity and
   a machine are on screen together.

   Both stages are gated symmetrically: whichever one is not the current
   mode is opacity:0 + visibility:hidden + pointer-events:none, so it
   neither paints nor takes part in the stacking of the other. */
/* --- The section header ------------------------------------------------
   The identity is NOT a state any more. It is a small standing header in
   the top band of the stage, on screen the whole time the section is, with
   the machines running underneath it. There is no longer a moment where
   the section stops being itself to become the showcase.

   The top band is free by construction: the giant name sits at top:46%,
   the machine below that and the copy block lower still, so nothing the
   scenes draw reaches up here. */
/* --- The section identity --------------------------------------------
   Lives INSIDE .stage-scenes as its first child, not in a panel of its
   own: it is the top of the showcase rather than a separate thing that
   has to hand over to it. It therefore rides up with the sheet when the
   scenes slide in, which is the point — one object arriving, not two.

   The top band is free by construction: the giant name sits at top:46%,
   the machine below it and the copy block lower still, so nothing the
   scenes draw reaches up here. Above the scene layers (wash 0, word 1,
   props 2, machine 3, copy 5) so it is never covered. */
.stage-head {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  /* Shares --stage-top with the tagline, so the header baseline and the
     top of the stacked eyebrow belong to one top band. */
  padding: var(--stage-top) var(--stage-inset) 0;
  pointer-events: none;
}
/* The section's heading. It carries no size of its own: the shared
   section-heading step and the shared responsive steps below own it, the
   same as every other H2 on the site.

   It previously took a bespoke clamp so it would stay small against
   .stage-word (the viewport-spanning product name below it). That kept it
   visibly out of the system — 31.7px against the 40px every other section
   heading uses at 1440px, and the gap widened at every breakpoint
   (22.5 vs 36.4 at 1024, 16.1 vs 25.2 at 390). .stage-word is low-opacity
   background artwork, so there is no real competition to design around. */
.stage-head h2 {
  margin: 0;
  color: var(--heading-color);
}


/* The showcase does not travel. It fills the pin from the start, so there
   is never a frame in which the section shows empty behind a sheet that
   has not arrived yet — the machines are simply what this section IS. */
.stage.is-intro .stage-nav {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .3s ease, visibility 0s linear .3s;
}

/* PRODUCT STATE — the machines arrive under the header, which stays put. */
.stage.is-products .stage-nav {
  opacity: 1;
  visibility: visible;
  transition: opacity .3s ease, visibility 0s linear 0s;
}
.stage.is-products .stage-nav { pointer-events: auto; }

/* No entrance animation: the header is simply THERE, the way a section
   heading is there. It is part of the showcase, so it arrives with the
   sheet and needs no reveal of its own on top of that. */

/* --- Scenes ----------------------------------------------------------- */
/* Above the intro's z-index:8, so the showcase slides up OVER the identity
   and covers it, rather than passing beneath it where the travel would not
   be visible at all. The scenes carry an opaque wash, so once the sheet is
   home the intro underneath is fully hidden. */
.stage-scenes { position: absolute; inset: 0; z-index: 9; }
.stage-scene {
  position: absolute;
  inset: 0;
  visibility: hidden;
  will-change: opacity;
}
.stage-scene.is-live { visibility: visible; }

/* LAYER 1 — a wash that tints the ground behind the current machine.
   Built from the existing blue scale only, so each scene can feel distinct
   without the section ever leaving the palette. */
.stage-wash {
  position: absolute;
  inset: 0;
  z-index: 0;
  opacity: 1;
  /* A product-studio ground, not a white page with a wash over it. The
     base is a real blue field; the centre only LIFTS that field (it is
     still blue-tinted, never paper white) so a white machine reads against
     it. The rim sits deeper so the frame closes. Tokens only. */
  background:
    /* lit pool behind the machine — blue-tinted, not white */
    radial-gradient(52% 50% at 50% 46%, var(--blue-100) 0%, rgba(235,245,250,0) 68%),
    /* deeper rim, closing the frame on all four sides */
    radial-gradient(118% 108% at 50% 44%, rgba(13,138,196,0) 42%, rgba(13,138,196,.20) 78%, rgba(9,101,144,.32) 100%),
    /* the field itself */
    linear-gradient(168deg, var(--blue-300) 0%, var(--blue-200) 30%, var(--blue-100) 62%, var(--blue-200) 100%);
}
/* A soft floor under the machine so it reads as standing on something
   rather than floating on a flat panel. */
.stage-wash::after {
  content: "";
  position: absolute;
  left: 50%; bottom: 14%;
  width: min(760px, 62vw); height: 16vh;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(50% 50% at 50% 50%, rgba(5, 61, 87, .22) 0%, rgba(5, 61, 87, 0) 70%);
}

/* LAYER 2 — the giant product name. This is artwork, not a heading: it
   spans the viewport, and the machine is deliberately allowed to cover its
   middle. Sized in vw so it always reaches edge to edge. */
.stage-word {
  position: absolute;
  left: 50%;
  top: 46%;
  z-index: 1;
  margin: 0;
  width: max-content;
  max-width: none;
  white-space: nowrap;
  font-weight: 700;
  /* --fit is written per scene by initMachinePosters: it measures the name
     and solves for the size that lands it at --fit-target of the viewport.
     A name can therefore be any length and still span the screen without
     ever reaching the edge. The clamp is only a pre-JS floor/ceiling. */
  --fit: 14vw;
  /* The fitter's solved size is what makes every name span the section
     identically, so the ceiling must not clip it — a short name needs a
     much larger size than a long one to cover the same width. The bounds
     stay only as a pre-JS floor and a runaway guard. */
  font-size: clamp(2.6rem, var(--fit), 60rem);
  line-height: .78;
  letter-spacing: -.055em;
  text-transform: uppercase;
  /* A deep blue from the existing scale at low opacity, so the name reads
     as a large background GRAPHIC on the light field rather than washing
     out against it. Near-white (--blue-50) disappeared here; --blue-700 at
     this strength stays clearly legible while still sitting behind the
     machine. No new colour is introduced. */
  color: var(--blue-700);
  opacity: .18;
  pointer-events: none;
  user-select: none;
  transform: translate3d(-50%, -50%, 0);
}
/* Per-letter placement: each glyph carries its own drift so the name
   assembles rather than sliding in as one block. */
.stage-word span {
  display: inline-block;
  will-change: transform, opacity;
}

/* LAYER 4 — the machine. Centred, large, and free-standing: the cut-outs
   carry their own shadow instead of a box. */
.stage-machine {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  height: clamp(280px, 62vh, 680px);
  width: auto;
  max-width: 82vw;
  object-fit: contain;
  /* A grounded contact shadow, not a card shadow — it follows the alpha
     silhouette, so the machine reads as an object standing in the scene. */
  filter: drop-shadow(0 34px 42px rgba(5, 61, 87, .26));
  will-change: transform, opacity, filter;
  /* Centred on the machine's INK, not on its file box.
     Some cut-outs carry uneven transparent padding in the source art, so
     box-centring leaves the visible machine off centre and the giant name
     behind it then reads as shifted the other way. Measured alpha-bounds
     offsets (ink centre vs box centre, as a share of file width):
        aura-plus       +2.87%      eco-pulverizer  +5.30%
        sugarcane       +2.68%      all others       ~0%
     --ink-off is that correction, set per scene below and defaulting to
     zero, so a machine whose art is already centred is untouched. It only
     shifts placement — the image file, its size and its aspect are as they
     were. */
  --ink-off: 0%;
  transform: translate3d(calc(-50% - var(--ink-off)), -50%, 0);
}
/* Per-machine ink corrections. The value is the measured offset expressed
   against the RENDERED width, which is what translate percentages resolve
   against, so it holds at every size the machine is drawn at. */
.stage-scene[data-name="Jagruti Aura Plus Domestic Flour Mill"] .stage-machine { --ink-off: 2.87%; }
.stage-scene[data-name="Jagruti Eco Pulverizer"] .stage-machine { --ink-off: 5.30%; }
.stage-scene[data-name="Jagruti Sugarcane Juicer"] .stage-machine { --ink-off: 2.68%; }
/* Feathers a machine that ships as a hard rectangle (a photograph carrying
   its own background) into the ground, rather than letting its edges cut.
   Nothing uses this at present — every stage machine now has a real alpha
   cut-out, Aura Plus included — but it is kept for the next product whose
   only source art is a background photo. Never put it on a cut-out: the
   radial mask would eat the machine's own edges. */
.stage-machine.is-masked {
  -webkit-mask-image: radial-gradient(62% 62% at 50% 50%, #000 58%, transparent 92%);
          mask-image: radial-gradient(62% 62% at 50% 50%, #000 58%, transparent 92%);
  border-radius: var(--radius-lg);
}

/* LAYER 5 — the existing copy, set small at the lower left, directly on the
   scene. No panel, no card, no white rectangle. */
.stage-copy {
  position: absolute;
  left: var(--stage-inset);
  /* The shared bottom baseline. Lowering --stage-base moves this column
     and the callout row down by the SAME amount, which is what keeps the
     bottom of the poster level. */
  bottom: var(--stage-base);
  z-index: 5;
  /* Wide enough for the longest spec string (the 58-character Supreme 900
     one), but held to under a third of the viewport so it stops short of
     the centred CTA block at EVERY width, not just at 1440px. The CTA is
     centred and at most 42vw wide, so its left edge never falls below
     29vw — this column therefore cannot reach it. */
  width: min(420px, 27vw);
  max-width: calc(100vw - var(--gutter) * 2);
  text-align: left;
}
.stage-copy .cat-tag {
  font-size: var(--fs-tag);
  font-weight: var(--fw-label);
  text-transform: none;
  letter-spacing: var(--ls-label-tight);
  color: var(--blue-600);
  margin-bottom: 8px;
}
.stage-copy h3 {
  margin: 0 0 8px;
  font-size: 1.5em;
  line-height: 120%;
  color: var(--heading-color);
}
.stage-copy h3 a { color: inherit; text-decoration: none; }
.stage-copy h3 a:hover { color: var(--blue-600); }
.stage-copy .desc {
  margin: 0 0 12px;
  font-size: .94em;
  line-height: 145%;
  color: var(--ink-700);
  /* Long descriptions wrap rather than truncating. */
  overflow-wrap: break-word;
}
/* Chips wrap onto as many rows as they need; the 58-character Supreme 900
   spec is the worst case and must not push anything off screen.

   The row is pulled left by exactly one chip's horizontal padding so the
   chip's TEXT — not its faint pill outline — lands on the column rail. The
   cat-tag, the h3, the desc and the buttons are all plain text boxes whose
   ink starts at the rail; the chip is the only item here with a filled
   background, and at 10px of padding its label sat 10px inside that line
   while everything above and below it sat on it. Aligning the box made the
   ink disagree, which is what read as "slightly inward". */
.stage-copy .spec-chip-row {
  margin-bottom: 0;
  flex-wrap: wrap;
  margin-left: calc(var(--stage-chip-pad) * -1);
  max-width: calc(100% + var(--stage-chip-pad));
}
.stage-copy .spec-chip {
  white-space: normal;
  text-align: left;
  line-height: 135%;
}
/* Each line lifts in on its own beat once the machine has settled. */
.stage-copy > *,
.stage-actions { will-change: transform, opacity; }

/* LAYER 6 — the existing CTAs, unchanged in wording and destination.
   The pair is the main action area of the scene, so it sits in the LOWER
   CENTRE. It is centred against the whole section (left:0/right:0 with the
   group centred inside), not against the space left over by the copy — so
   the centre stays true however long the product name on the left runs. */
.stage-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8vh;
  z-index: 6;
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  /* The box hugs the two buttons rather than being a wide block that
     merely CENTRES them: a 42vw-wide box would start at 29vw and collide
     with the copy column below ~1400px even though the buttons themselves
     sit nowhere near it. At max-content the centred region is only as wide
     as the pills, so both side columns get real clearance. */
  width: max-content;
  max-width: min(42vw, 460px);
  margin: 0 auto;
  /* Only the active scene accepts clicks — see .is-active below. */
  pointer-events: none;
}
.stage-scene.is-active .stage-actions { pointer-events: auto; }
/* Same rule for the product link in the copy block. */
.stage-copy { pointer-events: none; }
.stage-scene.is-active .stage-copy { pointer-events: auto; }

/* LAYER 8 — previous/next product controls, one on each edge.
   These are the actual navigation. Small and refined rather than
   carousel-sized, in the existing blue/ink tokens. The row spans the full
   stage and pushes the two arrows to the far left and far right edges,
   vertically centred on the section, so neither ever sits over the copy,
   the CTAs or the callouts. The row itself is inert; only the buttons take
   the pointer. */
.stage-nav {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  /* Above .stage-scenes (z-index: 9). In the old lower-right corner the
     arrows sat outside anything the scene painted, but centred on the edge
     they cross the full-bleed wash, which would otherwise swallow the
     click. */
  z-index: 11;
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* The arrows sit ON the outer rail: this is the section's true viewport
     margin, and because the row is left:0/right:0 with space-between both
     arrows get exactly the same margin from their own edge. */
  padding: 0 var(--stage-rail);
  pointer-events: none;
}
.stage-nav button { pointer-events: auto; }
.stage-nav button {
  /* --stage-arrow feeds --stage-inset, so the text rail is always exactly
     one arrow plus a gap inside the outer rail. Change the size here and
     the copy/callout columns re-clear it automatically. */
  width: var(--stage-arrow);
  height: var(--stage-arrow);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1px solid var(--blue-300);
  border-radius: 50%;
  background: rgba(255, 255, 255, .55);
  color: var(--blue-600);
  cursor: pointer;
  transition: background .25s ease, border-color .25s ease, color .25s ease, transform .25s ease;
}
.stage-nav button:hover {
  background: var(--blue-600);
  border-color: var(--blue-600);
  color: #fff;
  transform: translateY(-2px);
}
.stage-nav button:focus-visible { outline: 3px solid var(--blue-300); outline-offset: 4px; }
/* At the ends of the sequence the control has nowhere to go. */
.stage-nav button[disabled] { opacity: .38; cursor: default; transform: none; }
.stage-nav button[disabled]:hover {
  background: rgba(255, 255, 255, .55);
  border-color: var(--blue-300);
  color: var(--blue-600);
}
.stage-nav svg { width: 17px; height: 17px; display: block; }

/* --- Mobile ----------------------------------------------------------
   The same poster, re-composed for portrait: the copy moves under the
   machine, the CTAs sit beneath it, and only two props survive. */
@media (max-width: 860px) {
  /* Portrait re-states the SAME four tokens rather than each layer picking
     its own number again: the rail tightens, the text rail collapses onto
     it (nothing is beside an arrow any more once the copy is centred), and
     the baseline shortens for the taller stack. */
  .section.stage {
    --stage-rail: clamp(12px, 3vw, 22px);
    --stage-arrow: 38px;
    --stage-inset: var(--stage-rail);
    --stage-top: clamp(14px, 2.6vh, 26px);
    --stage-base: clamp(22px, 4vh, 40px);
    /* Portrait stacks the copy directly UNDER the machine, so the stack
       cannot be positioned by guessed viewport fractions the way the
       side-by-side desktop layout could: at 390x844 a 25vh guess put the
       product name straight across the machine's base. These two tokens
       describe the machine's real geometry, and the blocks below are
       measured from the edge they produce. */
    /* 40vh left the machine too tall for the stack that now sits under it:
       at 390x844 the copy, the CTA pair and the callout row together need
       more room than the floor-to-machine gap 40vh left over, so the copy
       ran into the callouts. The machine gives that room back — it is the
       one element here with slack, and at 34vh it still dominates the
       portrait poster. */
    --stage-mach-h: clamp(190px, 34vh, 420px);
    --stage-mach-top: 39%;
    /* Where the machine actually ends, in px from the top of the pin. */
    --stage-mach-bottom: calc(var(--stage-mach-top) + var(--stage-mach-h) / 2);
  }
  /* Size still comes from the fitter (--fit); only the floor changes. */
  .stage-word { font-size: clamp(2rem, var(--fit), 40rem); top: 36%; }
  .stage-machine { height: var(--stage-mach-h); max-width: 86vw; top: var(--stage-mach-top); }
  /* Below this width a prop cannot sit clear of the machine, the copy and
     the dots at a size where it still reads — so it is hidden outright
     rather than shrunk to a smudge or cropped. */
  /* Stacked from the shared baseline upward: callouts, then the CTA pair,
     then the copy. Each step is one measured offset from the token, so the
     three blocks are evenly spaced instead of sitting at 3vh / 11vh / 15vh
     — three unrelated values that only happened not to collide. */
  .stage-copy {
    left: 0; right: 0;
    width: auto;
    /* The base rule caps this column at calc(100vw - --gutter * 2) for the
       left-anchored desktop layout. Here the column is a full-bleed band
       that does its own insetting with --stage-rail, so that cap has to be
       released — left over, it shaved a gutter off the band and pushed the
       whole "centred" stack off-centre by half of it. */
    max-width: none;
    padding: 0 var(--stage-rail);
    /* Anchored to the machine, not to the floor: the block starts one
       clear gap below where the machine actually ends, so it can never
       ride up over the product however short the window is. The CTA row
       and the callouts then follow it in normal order. */
    top: calc(var(--stage-mach-bottom) + clamp(10px, 2vh, 22px));
    bottom: auto;
    text-align: center;
  }
  .stage-copy h3 { font-size: 1.22em; }
  .stage-copy .desc { font-size: .9em; }
  .stage-copy .spec-chip-row { justify-content: center; }
  /* Portrait keeps the same hierarchy, stacked: copy, then the centred CTA
     pair, then the arrows beneath them. The arrows sit at the LEFT edge. */
  .stage-actions {
    left: 0; right: 0;
    bottom: calc(var(--stage-base) + clamp(92px, 15vh, 150px));
    /* No rail of its own: on mobile this row is a static child inside
       .stage-copy, which has already applied the rail. Padding it again
       inset the buttons a second time and left them narrower than the
       copy they sit under. */
    padding: 0;
    /* Back to a full-width band here: the desktop rule hugs its buttons to
       keep the centre column narrow, which would otherwise stop the pills
       from going full width when they stack below. */
    width: auto;
    max-width: none;
    justify-content: center;
  }
  .stage-actions .btn { min-height: 44px; flex: 0 1 auto; }
  .stage-nav {
    left: 0;
    right: 0;
    padding: 0 var(--stage-rail);
  }

}

@media (max-width: 430px) {
  /* Two pills side by side get tight here, so they stack and go full width. */
  .stage-actions { flex-direction: column; gap: 8px; align-items: stretch; }
  .stage-actions .btn { width: 100%; }
  /* The pills stack here, making the copy column taller. It is anchored to
     the machine's bottom edge (see the 860px block), so it needs no bottom
     value of its own — the stack simply grows downward from that edge and
     the callout row below it gets out of the way instead. */
  .stage-copy .desc { font-size: .88em; }
}

/* --- Stillness -------------------------------------------------------
   Reduced motion, or no JS: the section stops being a pinned animation and
   becomes a plain vertical run of posters, every image, spec and CTA
   present. Nothing stays hidden behind an animation that will not run. */
@media (prefers-reduced-motion: reduce) {
  .stage-track { height: auto !important; }
  .stage-pin { position: static; height: auto; min-height: 0; max-height: none; overflow: visible; }
  /* The column layout has no pinned scene for the intro to cover, so both
     stages simply stay. The mode classes are neutralised here: there is no
     showcase to enter, so neither stage may be gated away. */
  .stage-head,
  .stage.is-intro .stage-head,
  .stage.is-products .stage-head {
    position: static;
    padding: 56px var(--gutter) 10px;
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
    transition: none !important;
  }
  /* The glide-up is off here, and its resting state is opacity:0 — so the
     children must be restored explicitly. The rules above only neutralise
     the block, not the lines inside it, which would otherwise leave the
     section identity blank for anyone who asked for stillness. */
  .stage-head > *,
  .stage.is-intro .stage-head > *,
  .stage.is-products .stage-head > * {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    transition-delay: 0s !important;
  }
  .stage.is-intro .stage-scenes,
  .stage.is-products .stage-scenes {
    opacity: 1 !important;
    visibility: visible !important;
  }
  /* The slide-up is off here, and its parked state is one viewport DOWN —
     so the sheet must be put back, or the whole column of posters would
     start a screen below where it belongs. z-index goes too: with nothing
     sliding over anything, the scenes are simply the next block in flow. */
  .stage-scenes,
  .stage.is-intro .stage-scenes,
  .stage.is-products .stage-scenes {
    position: static;
    z-index: auto;
    transform: none !important;
    transition: none !important;
  }
  .stage-scene {
    position: static;
    visibility: visible;
    opacity: 1 !important;
    min-height: 78vh;
    padding: 40px 0 56px;
  }
  .stage-wash { display: none; }
  .stage-word {
    position: static;
    transform: none;
    font-size: clamp(2rem, 9vw, 4rem);
    text-align: center;
    margin: 0 auto 10px;
    width: auto;
    white-space: normal;
  }
  .stage-word span { opacity: 1 !important; transform: none !important; }
  .stage-machine {
    position: static;
    display: block;
    margin: 0 auto;
    transform: none !important;
    filter: none !important;
    opacity: 1 !important;
    height: auto;
    max-height: 46vh;
  }
  .stage-copy,
  .stage-actions {
    position: static;
    width: auto;
    max-width: 620px;
    margin: 18px auto 0;
    padding: 0 var(--gutter);
    text-align: center;
    opacity: 1 !important;
    transform: none !important;
  }
  .stage-copy > * { opacity: 1 !important; transform: none !important; }
  .stage-copy .spec-chip-row { justify-content: center; }
  .stage-actions { justify-content: center; }
  /* The section is a plain column here — there is no timeline left to
     scrub, so neither control has anything to drive. */
  .stage-nav { display: none; }
}
html:not(.js) .stage-track { height: auto; }
html:not(.js) .stage-pin { position: static; height: auto; min-height: 0; max-height: none; overflow: visible; }
html:not(.js) .stage-head {
  position: static; padding: 56px var(--gutter) 10px;
  opacity: 1; visibility: visible; transform: none;
}
html:not(.js) .stage-head > * { opacity: 1; transform: none; }
html:not(.js) .stage-scenes { position: static; opacity: 1; visibility: visible; }
html:not(.js) .stage-scene { position: static; visibility: visible; min-height: 0; padding: 40px 0 56px; }
html:not(.js) .stage-wash,
html:not(.js) .stage-nav { display: none; }
html:not(.js) .stage-word {
  position: static; transform: none; width: auto; white-space: normal;
  font-size: clamp(2rem, 9vw, 4rem); text-align: center; margin: 0 auto 10px;
}
html:not(.js) .stage-machine {
  position: static; display: block; margin: 0 auto; transform: none;
  height: auto; max-height: 46vh; filter: none;
}
html:not(.js) .stage-copy,
html:not(.js) .stage-actions {
  position: static; width: auto; max-width: 620px; margin: 18px auto 0;
  padding: 0 var(--gutter); text-align: center;
}
html:not(.js) .stage-actions { justify-content: center; }

/* ==========================================================================
   Journey — "From Grain to Fresh Flour"
   --------------------------------------------------------------------------
   An editorial mosaic rather than a diagram. The header is a two-column
   band: an oversized display title on the left, the lead and its call to
   action on the right. Below it a staggered grid alternates photography
   with the four operating steps, the columns offset from one another so
   nothing lines up into a plain table of cards.

   Each photo's CARD opens FROM ITS TOP-LEFT CORNER as it enters view: the
   tile is clipped from nothing to its full size, holding that corner fixed
   while the opening grows right and down. The photograph inside does not
   move at all — it is laid out at its final size from the start and the
   frame simply uncovers it.
   ========================================================================== */
.journey-section {
  /* Inherits --section-pad-y from .section; the clamp that used to live
     here is what that token was taken from. */
  overflow: hidden;
  /* One viewport frame, the same three-way lock the hero uses
     (.hero { height: 100svh; min-height: 620px }) so the two sections
     measure identically at every viewport. svh is the stable unit, and the
     620px floor has to beat the 100svh min — hence max() rather than a
     second min-height declaration. Padding, type and the mosaic's own
     composition are untouched: only the outer box is pinned, and the
     mosaic's --journey-h below absorbs whatever height is left. */
  height: 100svh;
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
}
.journey-shell {
  display: flex;
  flex-direction: column;
  gap: clamp(36px, 6vh, 72px);
  /* Distributes the now-fixed section height: the head keeps its natural
     size and the mosaic takes the remainder. No child heights are set. */
  height: 100%;
}

/* ---- Header band ---- */
.journey-head {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: clamp(24px, 5vw, 80px);
  align-items: end;
}
/* The same type as every other section title on the site — the tokens,
   not a one-off clamp, so this heading stays in step with the rest. */
.journey-head h2 {
  margin: 0;
}

.journey-head-aside {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 22px;
  padding-bottom: 6px;
}
/* Held a step below --fs-lead: this sits beside the title rather than
   under it, so it reads as supporting copy and must not rival the h2. */
.journey-head-aside p {
  margin: 0;
  max-width: 38ch;
  font-size: .875em;
  font-weight: var(--fw-body);
  line-height: var(--lh-body);
  color: var(--ink-500);
}

/* ---- Step flow ----
   Four identical step cards in a row, linked by a dotted connector. Each
   card is an arch-topped photograph with a floating number medallion at
   its top-left and a small circular icon badge straddling the seam
   between the picture and the copy beneath it. */
.journey-flow {
  display: grid;
  grid-template-columns:
    minmax(0, 1fr) clamp(36px, 5.2vw, 88px)
    minmax(0, 1fr) clamp(36px, 5.2vw, 88px)
    minmax(0, 1fr) clamp(36px, 5.2vw, 88px)
    minmax(0, 1fr);
  align-items: start;
  gap: 0;
  flex: 1;
  min-height: 0;
}
/* The dotted rule between two cards, with a solid dot at its middle. */
.journey-link {
  align-self: start;
  position: relative;
  /* The cards are narrower than their columns, so the arc is pulled out
     into the slack on either side to actually bridge the two. */
  width: auto;
  margin-inline: clamp(-46px, -4vw, -18px);
  margin-top: clamp(88px, 11vw, 150px);
  height: clamp(22px, 2.4vw, 34px);
  color: var(--blue-400, #4eb8e9);
  opacity: .9;
  /* The arc is pulled out over its neighbours by the negative margins
     above, so it has to sit behind them rather than across their faces. */
  z-index: 0;
}
/* The arc bows upward between the two cards; preserveAspectRatio is off so the
   curve stretches to whatever gutter width the grid gives it, while
   vector-effect keeps the dashes an even weight however far it stretches. */
.journey-link svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}
/* A solid dot pinned to the highest point of the curve. */
.journey-link-dot {
  position: absolute;
  left: 50%;
  top: clamp(5px, .6vw, 8px);
  width: 9px; height: 9px;
  margin: -4.5px 0 0 -4.5px;
  border-radius: 50%;
  background: var(--blue-600);
}

.journey-card {
  position: relative;
  /* Above the connector arcs, which reach under the cards from either side. */
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  /* Held to a narrower measure than its column so the dotted connectors
     have room to read between neighbouring cards. */
  max-width: clamp(190px, 17vw, 250px);
  margin-inline: auto;
  padding: clamp(10px, 1vw, 14px) clamp(10px, 1.1vw, 16px) clamp(14px, 1.4vw, 20px);
  /* The card echoes the photograph's soft arch — a generously rounded head
     over a gently rounded foot, so frame and picture read as one shape. */
  border-radius: clamp(80px, 8vw, 118px) clamp(80px, 8vw, 118px) clamp(20px, 2vw, 28px) clamp(20px, 2vw, 28px);
  background: linear-gradient(180deg, rgba(255,255,255,.72) 0%, rgba(255,255,255,.28) 55%, rgba(255,255,255,0) 100%);
  border: 1px solid rgba(255, 255, 255, .7);
  box-shadow: 0 18px 40px -28px rgba(7, 81, 116, .35);
}

/* Arch-topped photograph — fully rounded head, gently rounded foot. */
.journey-card-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / .94;
  /* Held in a variable so the reveal's clip-path can round its opening to
     exactly the same arch — an unrounded clip would square the corners off
     for the length of the animation. */
  --media-r: clamp(72px, 7.2vw, 106px) clamp(72px, 7.2vw, 106px) clamp(16px, 1.6vw, 24px) clamp(16px, 1.6vw, 24px);
  border-radius: var(--media-r);
  overflow: visible;
  margin-bottom: clamp(20px, 1.9vw, 28px);
}
.journey-card-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: inherit;
}

/* Number medallion — floats off the top-left corner of the arch. */
.journey-num {
  position: absolute;
  top: clamp(-30px, -2.4vw, -18px);
  left: clamp(-26px, -2.1vw, -14px);
  z-index: 2;
  width: clamp(48px, 4.6vw, 68px);
  height: clamp(48px, 4.6vw, 68px);
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #fff;
  border: 1.5px solid rgba(168, 214, 236, .85);
  box-shadow: 0 8px 20px -12px rgba(7, 81, 116, .35);
  font-size: clamp(1.15rem, 1.6vw, 1.6rem);
  font-weight: var(--fw-title);
  line-height: 1;
  letter-spacing: -.02em;
  color: var(--blue-800);
  font-variant-numeric: tabular-nums;
  margin: 0;
}

/* Icon badge — straddles the bottom edge of the photograph. */
.journey-icon {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: clamp(-26px, -2vw, -18px);
  transform: translateX(-50%);
  width: clamp(40px, 3.6vw, 52px);
  height: clamp(40px, 3.6vw, 52px);
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #fff;
  border: 1px solid rgba(188, 224, 240, .9);
  box-shadow: 0 10px 22px -14px rgba(7, 81, 116, .45);
  color: var(--blue-600);
}
.journey-icon svg {
  width: 52%;
  height: 52%;
  display: block;
}

.journey-card-body h4 {
  font-size: 1.0625em;
  font-weight: 700;
  letter-spacing: -.01em;
  margin: 0 0 8px;
  color: var(--blue-800);
}
.journey-card-body p {
  margin: 0 auto;
  max-width: 26ch;
  font-size: .875em;
  line-height: 1.6;
  color: var(--blue-700);
}

/* ---- Reveal ----
   The section animates the way the process itself reads: step 01 arrives,
   its arc travels across to step 02, and so on down the line, so the
   entrance traces the same left-to-right path the diagram describes.

   Everything runs on one easing family — a long, decelerating
   cubic-bezier(.16, 1, .3, 1) — and every element inside a card is
   delayed against that card rather than against the page, so each step
   assembles as its own small composition. main.js writes .is-open on the
   cards and .is-drawn on the arcs.  --d is the per-card base delay it
   also sets, which every child below offsets from. */
.js .journey-card {
  --d: 0ms;
  opacity: 0;
  /* The card rises AND grows very slightly out of its own base — the
     transform-origin at the bottom keeps it planted while it settles,
     which is what stops the lift reading as a slide. */
  transform: translateY(34px) scale(.965);
  transform-origin: 50% 100%;
  filter: blur(6px);
  transition:
    opacity .9s cubic-bezier(.16, 1, .3, 1) var(--d),
    transform 1.05s cubic-bezier(.16, 1, .3, 1) var(--d),
    filter .8s cubic-bezier(.16, 1, .3, 1) var(--d);
  will-change: opacity, transform, filter;
}
.js .journey-card.is-open {
  opacity: 1;
  transform: none;
  filter: none;
}

/* The photograph is UNCOVERED by its own arch rather than faded in: the
   frame's clip opens from the bottom up while the picture inside drifts
   down from a small over-scale. The two run at different speeds, so the
   image looks like it settles into the frame instead of arriving with it. */
/* The clip rides on the IMAGE, not on .journey-card-media: a clip-path on
   the media box would also cut the number medallion and the icon badge,
   which deliberately hang outside its edges. */
.js .journey-card-media img {
  clip-path: inset(0 0 100% 0 round var(--media-r, 0));
  transform: scale(1.14);
  transition:
    clip-path 1.15s cubic-bezier(.16, 1, .3, 1) calc(var(--d) + 60ms),
    transform 1.6s cubic-bezier(.16, 1, .3, 1) calc(var(--d) + 60ms);
}
.js .journey-card.is-open .journey-card-media img {
  clip-path: inset(0 0 0 0 round var(--media-r, 0));
  transform: none;
}

/* Number medallion — swings in on a soft overshoot once the frame is up. */
.js .journey-num {
  opacity: 0;
  transform: translateY(10px) scale(.6);
  transition:
    opacity .5s cubic-bezier(.16, 1, .3, 1) calc(var(--d) + 420ms),
    transform .75s cubic-bezier(.34, 1.4, .5, 1) calc(var(--d) + 420ms);
}
.js .journey-card.is-open .journey-num { opacity: 1; transform: none; }

/* Icon badge — same beat, a touch later, keeping its centring transform. */
.js .journey-icon {
  opacity: 0;
  transform: translateX(-50%) scale(.5);
  transition:
    opacity .5s cubic-bezier(.16, 1, .3, 1) calc(var(--d) + 560ms),
    transform .75s cubic-bezier(.34, 1.4, .5, 1) calc(var(--d) + 560ms);
}
.js .journey-card.is-open .journey-icon { opacity: 1; transform: translateX(-50%); }

/* Title and copy lift in turn, so the card resolves top to bottom. */
.js .journey-t {
  opacity: 0;
  transform: translateY(14px);
  filter: blur(4px);
  transition:
    opacity .75s cubic-bezier(.16, 1, .3, 1) var(--td, 0ms),
    transform .75s cubic-bezier(.16, 1, .3, 1) var(--td, 0ms),
    filter .75s cubic-bezier(.16, 1, .3, 1) var(--td, 0ms);
}
.js .journey-card h4.journey-t { --td: calc(var(--d) + 520ms); }
.js .journey-card p.journey-t  { --td: calc(var(--d) + 620ms); }
.js .journey-card.is-open .journey-t {
  opacity: 1;
  transform: none;
  filter: none;
}

/* ---- The travelling arc ----
   The dotted curve DRAWS ITSELF from the left card to the right one. The
   dashes are the visible pattern, so the draw cannot also use dashoffset;
   instead a second, solid copy of the path is used as a mask that sweeps
   open along the curve. A plain horizontal wipe would reveal the arc in a
   straight line and fight its shape — this follows the curve itself. */
.js .journey-link svg { overflow: visible; }
.js .journey-link .journey-arc {
  /* The path is ~104 units long in its own viewBox; pathLength normalises
     that to 100 so the dash maths is independent of the geometry. */
  stroke-dasharray: 2.6 3.6;
}
.js .journey-link .journey-arc-mask {
  stroke-dasharray: 100;
  stroke-dashoffset: 100;
  transition: stroke-dashoffset 1s cubic-bezier(.16, 1, .3, 1) var(--d, 0ms);
}
.js .journey-link.is-drawn .journey-arc-mask { stroke-dashoffset: 0; }

/* The dot arrives as the arc reaches the crest. */
.js .journey-link-dot {
  opacity: 0;
  transform: scale(.3);
  transition:
    opacity .45s cubic-bezier(.16, 1, .3, 1) calc(var(--d, 0ms) + 620ms),
    transform .7s cubic-bezier(.34, 1.5, .5, 1) calc(var(--d, 0ms) + 620ms);
}
.js .journey-link.is-drawn .journey-link-dot { opacity: 1; transform: none; }

@media (max-width: 1024px) {
  /* Two columns and content-driven height — the one-viewport lock is
     released, as .why-section does at its own breakpoint. */
  .journey-section {
    height: auto;
    min-height: 0;
    max-height: none;
  }
  .journey-shell { height: auto; }
  .journey-flow {
    flex: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 40px) 0;
  }
  .journey-link { display: none; }
}

@media (max-width: 600px) {
  .journey-flow { grid-template-columns: 1fr; }
  .journey-card-media { aspect-ratio: 4 / 3; }
}

@media (max-width: 720px) {
  .journey-head {
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: start;
  }

  .journey-head-aside p { max-width: none; font-size: .875em; }
}

@media (prefers-reduced-motion: reduce) {
  .js .journey-card,
  .js .journey-num,
  .js .journey-icon,
  .js .journey-t,
  .js .journey-link-dot {
    opacity: 1;
    transform: none;
    filter: none;
    transition: none;
  }
  .js .journey-icon { transform: translateX(-50%); }
  .js .journey-card-media img { clip-path: none; transform: none; transition: none; }
  .js .journey-link .journey-arc-mask { stroke-dashoffset: 0; transition: none; }
}
/* ==========================================================================
   Service showcase  (index.html — .services)
   --------------------------------------------------------------------------
   A PINNED HORIZONTAL RUN, after the reference site's Chapter III.

   The shape of it: .services-track is a tall block that gives the section
   its scroll travel. .services-pin is a sticky child one viewport tall, so
   it holds the screen while the track scrolls past underneath. Inside,
   .services-rail is a flex row wider than the screen, and initServices()
   translates it LEFT in step with the track's progress — which is what
   brings each card in from the RIGHT as the visitor scrolls DOWN.

   Nothing here steals the wheel. The rail is a pure function of scroll
   position, so Lenis keeps the scroll and the section cannot trap anyone
   the way an input-capturing pin can.

   Per card, the reveal is the reference's: a wash-and-image layer masked by
   clip-path inset(100% 0 0 0) — fully closed from the bottom — opening to
   inset(0) while the image counter-moves a few percent against it. The
   picture reads as uncovered in place rather than slid in.

   Below 768px, and under reduced motion, the rail is a plain vertical
   stack with every shot already open: no pin, no travel, nothing hidden
   behind an animation that will not run.

   Every colour is an existing token. No new palette.
   ========================================================================== */

.services {
  position: relative;
  background: var(--blue-700);
  color: var(--white);
  /* The pinned child is clipped by any ancestor that establishes a scroll
     container, so this one must not become one. */
  overflow: visible;
}

/* Height is written by JS from the rail's overflow — one screen to hold,
   plus the travel itself. This fallback keeps the section usable in the
   moment before JS runs. */
.services-track {
  position: relative;
  height: 300vh;
}

.services-pin {
  position: sticky;
  top: 0;
  height: 100vh;
  /* The visible frame, matched to the hero: same 100svh unit and the same
     620px floor (.hero { height: 100svh; min-height: 620px }), so a short
     window cannot make this pin shorter than the hero. The TRACK height
     above is untouched — scroll duration and animation timing are
     unchanged; only the frame the pin paints into is pinned. */
  height: 100svh;
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
  overflow: hidden;
  display: flex;
  align-items: stretch;
  isolation: isolate;
}

/* The rail is wider than the screen; JS moves it. will-change keeps the
   transform on its own layer — without it the four cover images repaint
   the whole rail on every frame. */
.services-rail {
  display: flex;
  align-items: stretch;
  height: 100%;
  padding-right: var(--gutter);
  transform: translate3d(0, 0, 0);
  will-change: transform;
}

/* ---- The heading, first panel on the rail -----------------------------
   It travels with the cards rather than sitting above them, so the run
   reads as one continuous band the way the reference's does. */
.services-intro {
  flex: 0 0 auto;
  /* Half the viewport, so the first card's left edge lands on the same
     line as the Two Ranges video's left edge above — that split is driven
     by --split:50vw, so the same unit is what matches it. (A percentage
     would resolve against .services-rail, whose width is content-driven,
     not against the pin.) initServices derives travel from
     rail.scrollWidth, so the run adapts on its own. */
  width: 50vw;
  display: flex;
  flex-direction: column;
  /* Label at the top, title block at the foot, the middle deliberately
     empty — the reference's proportion. */
  justify-content: space-between;
  padding: calc(var(--header-h) + clamp(18px, 3vh, 40px)) clamp(32px, 4vw, 80px) clamp(28px, 5vh, 64px) var(--gutter);
}
.services-intro-foot { display: block; }
.services-intro .eyebrow {
  margin: 0;
  align-self: flex-start;
  color: var(--blue-200);
  background: rgba(255, 255, 255, .10);
}
/* INTENTIONAL EXCEPTION — display, not a section heading.
   This is the first panel of a full-viewport pinned horizontal rail: it
   occupies a whole screen and travels with the cards, so it plays the
   hero's role in its own section rather than labelling a block of copy.
   It is therefore tuned to the HERO (700, near-1 leading, -.035em
   tracking), which is exactly the benchmark this pass works from — the
   same design language at display scale, not a fourth H2 treatment. */
.services-intro h2 {
  margin: 0;
  font-size: clamp(2.5rem, 1.1rem + 5.2vw, 6rem);
  font-weight: var(--fw-title);
  line-height: 96%;
  letter-spacing: var(--ls-display);
  color: var(--white);
}
.services-intro p {
  margin: clamp(12px, 2vh, 20px) 0 0;
  max-width: 44ch;
  font-size: .875em;
  line-height: 1.6;
  color: rgba(255, 255, 255, .72);
}

/* ---- A card -----------------------------------------------------------
   Portrait panels, square-cornered: each is a window cut into the band,
   not a card floating on it. */
.service-card {
  position: relative;
  flex: 0 0 auto;
  width: clamp(300px, 30vw, 440px);
  display: grid;
  /* number / spring / title / spring / copy — the two springs are what put
     the title on the card's middle and hold the copy at its foot. */
  grid-template-rows: auto 1fr auto 1fr auto;
  padding: calc(var(--header-h) + clamp(14px, 2.4vh, 30px)) clamp(22px, 2.2vw, 38px) clamp(24px, 4vh, 48px);
  border-left: 1px solid rgba(255, 255, 255, .22);
  text-decoration: none;
  color: var(--white);
  background: var(--blue-700);
  overflow: hidden;
  isolation: isolate;
}

/* The masked layer. Closed from the bottom at rest — inset(100% 0 0 0)
   leaves nothing visible — and opened by the hover/focus rules below. */
.service-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  clip-path: inset(100% 0% 0% 0%);
  transition: clip-path .8s cubic-bezier(.16, 1, .3, 1);
}
/* A wash over the photograph: the number and title sit on top of it and
   have to stay legible against whatever the shot happens to be. */
.service-wash {
  position: absolute;
  inset: 0;
  z-index: 1;
  /* Sits over the photograph once the mask opens, so the number, title and
     copy stay legible on top of whatever the shot happens to be. It is a
     constant: the MASK is what reveals, exactly as the reference does it. */
  background: rgba(15, 13, 12, .55);
}
/* Counter-moves against the mask. The image is oversized (scale 1.1) so
   the movement never walks a hard edge into view. */
.service-media {
  display: block;
  width: 100%;
  height: 100%;
  transform: translate3d(0, 6%, 0);
  transition: transform .8s cubic-bezier(.16, 1, .3, 1);
}
.service-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50% 42%;
  display: block;
  transform: scale(1.1);
}

.service-card:hover .service-bg,
.service-card:focus-visible .service-bg { clip-path: inset(0% 0% 0% 0%); }
.service-card:hover .service-media,
.service-card:focus-visible .service-media { transform: translate3d(0, -3%, 0); }

.service-num {
  font-size: clamp(2rem, 1.2rem + 2.4vw, 3.4rem);
  font-weight: var(--fw-title);
  line-height: 1;
  letter-spacing: -.024em;
  color: rgba(255, 255, 255, .55);
  transition: color .5s ease;
}
.service-card:hover .service-num,
.service-card:focus-visible .service-num { color: var(--white); }

.service-num   { grid-row: 1; }
.service-title { grid-row: 3; }
.service-copy  { grid-row: 5; }
.service-title {
  display: block;
  font-size: clamp(1.25rem, .95rem + 1.1vw, 1.9rem);
  font-weight: var(--fw-title);
  line-height: 118%;
  letter-spacing: -.02em;
  color: var(--white);
}
.service-copy {
  display: block;
  font-size: .9em;
  line-height: 145%;
  color: rgba(255, 255, 255, .74);
}

.service-card:focus-visible {
  outline: 2px solid var(--white);
  outline-offset: -6px;
}

/* ---- Entrance ---------------------------------------------------------
   Each panel also fades and lifts as it arrives, so the run has some depth
   rather than four rigid panels sliding by. .is-in is written by JS; with
   no JS the .js guard never applies and every panel is simply present. */
.js .service-card,
.js .services-intro {
  opacity: 0;
  transform: translate3d(40px, 0, 0);
  transition: opacity .7s cubic-bezier(.16, 1, .3, 1),
              transform .7s cubic-bezier(.16, 1, .3, 1);
}
.js .service-card.is-in,
.js .services-intro.is-in {
  opacity: 1;
  transform: none;
}

/* ---- Phone ------------------------------------------------------------
   No pin and no rail: a vertical stack, each shot already uncovered. A
   horizontal run on a phone would be a second scroll direction competing
   with the page's own. */
@media (max-width: 767px) {
  .services-track { height: auto; }
  .services-pin {
    position: static;
    height: auto;
    /* The desktop one-viewport lock must be cleared explicitly here, or it
       would hold the stacked cards to a single screen and clip them. */
    min-height: 0;
    max-height: none;
    display: block;
    overflow: visible;
  }
  .services-rail {
    display: block;
    height: auto;
    padding: 0;
    transform: none !important;
    will-change: auto;
  }
  .services-intro {
    width: auto;
    padding: 48px var(--gutter) 28px;
  }
  .services-intro h2 { margin-top: 10px; font-size: clamp(2.25rem, 1.4rem + 4vw, 3rem); }

  .service-card {
    width: auto;
    min-height: 54vh;
    padding-top: 32px;
    border-left: 0;
    border-top: 1px solid rgba(255, 255, 255, .22);
    padding: 32px var(--gutter);
  }
  /* Open, and staying open: there is no hover to reveal it with. */
  .service-bg { clip-path: inset(0% 0% 0% 0%); }
  .service-wash { background: rgba(5, 61, 87, .66); }
  .service-media { transform: none; }
  .js .service-card,
  .js .services-intro { opacity: 1; transform: none; }
}

/* ---- Stillness --------------------------------------------------------
   Reduced motion: no pin, no travel, no masking. The same vertical stack
   the phone gets, with every transition off. initServices() returns early,
   so no transform is ever written to the rail. */
@media (prefers-reduced-motion: reduce) {
  .services-track { height: auto; }
  .services-pin {
    position: static;
    height: auto;
    /* The desktop one-viewport lock must be cleared explicitly here, or it
       would hold the stacked cards to a single screen and clip them. */
    min-height: 0;
    max-height: none;
    display: block;
    overflow: visible;
  }
  .services-rail {
    display: block;
    height: auto;
    padding: 0;
    transform: none !important;
  }
  .services-intro { width: auto; padding: 48px var(--gutter) 28px; }
  .service-card {
    width: auto;
    border-left: 0;
    border-top: 1px solid rgba(255, 255, 255, .22);
  }
  .service-bg,
  .service-media,
  .service-num,
  .js .service-card,
  .js .services-intro { transition: none !important; }
  .service-bg { clip-path: inset(0% 0% 0% 0%); }
  .service-media { transform: none; }
  .js .service-card,
  .js .services-intro { opacity: 1; transform: none; }
}

/* --- LAYER 5b — the reference poster furniture -------------------------
   Two additions that complete the Eco Pulverizer reference composition on
   every scene: the stacked tagline at the top left, and the row of four
   feature callouts at the lower right. Both are built from the existing
   blue/ink tokens only — no new colour enters the palette. */

/* The small stacked eyebrow at the top left. It is artwork rather than
   content (the section already has a real heading in .stage-head), so it
   is aria-hidden in the markup and never picked up as a heading. */
.stage-tagline {
  position: absolute;
  /* The same left rail as the copy column directly below it: the two
     left-hand blocks now share one edge instead of the tagline sitting on
     --gutter while the copy sat on its own value. */
  left: var(--stage-inset);
  /* One step below the shared top band — far enough to clear the header,
     close enough that it still reads as part of the same top row. */
  top: calc(var(--stage-top) + clamp(58px, 9vh, 104px));
  z-index: 5;
  margin: 0;
  font-size: var(--fs-tag);
  font-weight: var(--fw-label);
  line-height: 190%;
  letter-spacing: var(--ls-label-loose);
  text-transform: uppercase;
  color: var(--ink-500);
  pointer-events: none;
  user-select: none;
  will-change: transform, opacity;
}

/* The four icon + label callouts, lower right. They share the CTA/copy
   baseline so the bottom of the poster reads as one bar: copy+CTA on the
   left, callouts on the right. The arrows now sit vertically centred on
   the side edges instead of this corner, so the row no longer has to stop
   short of them and runs out to the right edge itself. */
.stage-feats {
  position: absolute;
  /* The callout row gets its own right boundary, one step OUTSIDE the text
     rail the copy column uses. The two blocks are no longer mirror images:
     the left column is a reading column that wants the text rail, while
     this row is a band of small centred tiles that reads better carried
     out toward the edge. --stage-feat-rail is that boundary, and the last
     tile ("Air-Cooled Filter") sits exactly on it. */
  right: var(--stage-feat-rail);
  bottom: var(--stage-base);
  z-index: 5;
  display: flex;
  gap: clamp(18px, 2.6vw, 42px);
  margin: 0;
  padding: 0;
  list-style: none;
  text-align: center;
  pointer-events: none;
}
.stage-feats li {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  width: clamp(64px, 7vw, 92px);
  font-size: .6875em;
  font-weight: 500;
  line-height: 145%;
  color: var(--ink-700);
  will-change: transform, opacity;
}
.stage-feats svg {
  width: 26px;
  height: 26px;
  display: block;
  color: var(--blue-600);
}
/* A hairline divider between callouts, as in the reference. */
.stage-feats li + li { position: relative; }
.stage-feats li + li::before {
  content: "";
  position: absolute;
  left: calc(clamp(18px, 2.6vw, 42px) / -2);
  top: 6%;
  height: 88%;
  border-left: 1px solid var(--blue-200);
}

/* The CTA pair now sits in the left copy column, directly under the spec
   chips, instead of being centred at the bottom of the section. It is a
   normal block in that column, so the old absolute centring — and the
   collision rules that existed only to keep a centred box clear of this
   very column — no longer apply. */
.stage-copy .stage-actions {
  position: static;
  width: auto;
  max-width: none;
  margin: 18px 0 0;
  justify-content: flex-start;
}

/* The left column now carries the buttons too, so it needs more room than
   the 27vw the text alone was held to. */
.stage-copy { width: min(460px, 34vw); }

@media (min-width: 861px) and (max-width: 1180px) {
  /* Four callouts plus the arrows no longer fit beside the copy column
     here, so the row drops under the machine and centres. It keeps
     answering to the grid: it clears the copy column by exactly one
     --stage-base step, and the copy column lifts by the same step, so the
     two blocks stay evenly spaced instead of one crowding the other. */
  .stage-feats {
    left: 0; right: 0;
    bottom: var(--stage-base);
    justify-content: center;
    gap: clamp(14px, 2.4vw, 30px);
    padding: 0 var(--stage-rail);
  }
  .stage-copy { bottom: calc(var(--stage-base) + clamp(96px, 15vh, 150px)); }
}

@media (max-width: 860px) {
  /* Portrait: the tagline would crowd the machine, and the callouts become
     a centred two-up grid beneath the stacked copy. */
  .stage-tagline { display: none; }
  .stage-copy { width: auto; }
  .stage-copy .stage-actions { justify-content: center; }
  /* Held to the floor on the shared baseline. The copy column above now
     grows downward from the machine, so the guard below keeps this row
     from being reached on the shortest windows. */
  .stage-feats {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: center;
    gap: 14px;
    /* Full-bleed band, centred. The base rule anchors this row to the
       right rail for the desktop layout; portrait centres it under the
       machine instead, so that anchor has to be released explicitly —
       left over, it held the row against the right edge and only the
       padding kept it on screen. */
    left: 0;
    right: 0;
    bottom: var(--stage-base);
    padding: 0 var(--stage-rail);
  }
  .stage-feats li { width: clamp(58px, 20vw, 78px); font-size: .625em; }
  .stage-feats svg { width: 21px; height: 21px; }
  /* The divider reads as clutter once the row is this tight. */
  .stage-feats li + li::before { display: none; }
}

@media (max-width: 430px) {
  /* The four-across row is KEPT here. Folding it to 2x2 doubled its height
     at exactly the width where the CTA pills also stack, and the two
     together were what pushed the copy column down into this row. The
     labels stay readable across four columns at this size because the
     tile width and font step down with the viewport. */
  /* justify-self is what centres a grid whose columns are narrower than
     the track; without it the auto-columns hug the start and the row sat
     off to the left of the poster it is supposed to be centred under. */
  .stage-feats { gap: 10px 8px; justify-content: center; justify-items: center; }
  .stage-feats li { width: clamp(52px, 21vw, 72px); font-size: .5875em; gap: 6px; }
  .stage-feats svg { width: 19px; height: 19px; }
}

/* Stillness: the column layout has no pinned scene, so these simply sit in
   flow with everything else rather than being absolutely placed. */
@media (prefers-reduced-motion: reduce) {
  .stage-tagline { display: none; }
  .stage-feats {
    position: static;
    justify-content: center;
    flex-wrap: wrap;
    margin: 18px auto 0;
  }
  /* The entrance beats never run here, so the callouts must not be left
     sitting at the opacity the animation would otherwise have lifted. */
  .stage-feats li { opacity: 1 !important; transform: none !important; }
}

/* ==========================================================================
   Connect band — merged social-proof + enquiry CTA (homepage)
   One editorial slab on the sky-tint ground: compact form on the left,
   oversized condensed headline on the right, social row pinned bottom-left.
   Replaces the old separate "Social Proof" and .cta-band sections.
   ========================================================================== */
.connect-band-section {
  /* Plain full-screen band. It does NOT pin and it does NOT move on its own
     — the reveal is done entirely by the footer sitting behind it, so this
     stays one ordinary screen in normal flow (see .site-footer below). */
  position: relative;
  z-index: 1;
  padding: 0;
  height: 100svh;
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
  background: var(--blue-900);
}
.connect-pin {
  height: 100%;
  display: flex;
  align-items: center;
  overflow: hidden;
  isolation: isolate;
}

/* ---- The footer reveal -----------------------------------------------
   Matches the reference exactly: the FOOTER is stuck to the bottom of the
   viewport at a NEGATIVE z-index, so it sits behind the page rather than
   after it. It is therefore already in place, held at the bottom of the
   screen, while the content above scrolls; the connect band simply slides
   up off the top and uncovers it. Nothing pins, nothing transforms, and
   there is no gap to close — the band ends exactly where it ends and the
   footer was always underneath it.

   z-index: -1 is what puts it behind, so every ancestor between it and the
   root must stay transparent or the footer is painted over. body already
   carries the page background, so the footer is given its own painted
   ground and body is made transparent over the footer's own height. */
/* SCOPED TO THIS PAGE ONLY. Every rule below hangs off a body:has() test
   for the connect band being the last thing in <main> — which is true on
   the homepage and nowhere else. An unscoped .site-footer here would make
   the footer sticky and transparent-backed on every page of the site. */
body:has(> main > .connect-band-section:last-child) .site-footer {
  position: sticky;
  bottom: 0;
  z-index: -1;
}
/* A z-index:-1 element is painted behind its stacking context, so the page
   background would cover the footer. The background is moved off body onto
   the content above it, leaving body transparent for the footer to show
   through — this is the one rule the reveal depends on. */
body:has(> main > .connect-band-section:last-child) { background: transparent; }
body:has(> main > .connect-band-section:last-child) > main { background: var(--page-bg); position: relative; z-index: 0; }

/* Full-bleed photographic ground. It settles from a slight over-scale as the
   band enters view — enough to feel alive behind the slab, not enough to
   read as a parallax gimmick. */
.connect-bg {
  position: absolute; inset: 0; z-index: -1;
  overflow: hidden;
}
.connect-bg img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  transform: scale(1.08);
  transition: transform 1.4s cubic-bezier(.22,.61,.36,1);
}
.connect-pin:has(.connect-band.is-revealed) .connect-bg img { transform: scale(1); }
.connect-pin::after {
  /* Keeps the slab legible whatever the photo does underneath. */
  content: ""; position: absolute; inset: 0; z-index: -1;
  background: linear-gradient(180deg, rgba(5,61,87,.28) 0%, rgba(5,61,87,.46) 100%);
  pointer-events: none;
}
.connect-pin .container { width: 100%; }

/* ---- The slab -------------------------------------------------------- */
.connect-band {
  position: relative;
  /* Deliberately narrower than the page container and centred in it, so the
     photograph reads as a frame around the card rather than a thin margin. */
  max-width: 660px;
  margin: 0 auto;
  padding: 0 clamp(16px, 2vw, 26px) clamp(16px, 2vw, 24px);
  border-radius: var(--radius-md);
  color: #fff;
  background: rgba(5, 61, 87, .46);
  backdrop-filter: blur(14px) saturate(120%);
  -webkit-backdrop-filter: blur(14px) saturate(120%);
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 30px 80px rgba(3, 26, 38, .32);
  /* Arriving: the card lifts slightly into place — a settle, not an
     entrance. Duration and curve are the reference's own motion tokens,
     read off their stylesheet: --duration-extra-long (.6s) paired with
     --ease-out-slow, cubic-bezier(0,0,.3,1). That curve leaves its start
     immediately and decelerates the whole way, which is what makes the
     movement read as settling rather than sliding in. */
  opacity: 0;
  transform: translateY(18px);
  transition: opacity .6s cubic-bezier(0, 0, .3, 1), transform .6s cubic-bezier(0, 0, .3, 1);
}
.connect-band.is-revealed { opacity: 1; transform: none; }

/* Children stagger in behind the slab itself. */
.connect-band [data-reveal-child] {
  opacity: 0;
  transform: translateY(12px);
  transition: opacity .6s cubic-bezier(0, 0, .3, 1), transform .6s cubic-bezier(0, 0, .3, 1);
}
.connect-band.is-revealed [data-reveal-child] { opacity: 1; transform: none; }
.connect-band.is-revealed .connect-band-head    { transition-delay: .12s; }
.connect-band.is-revealed .connect-sub          { transition-delay: .20s; }
.connect-band.is-revealed .connect-band-actions { transition-delay: .28s; }
.connect-band.is-revealed .connect-band-foot    { transition-delay: .36s; }

/* ---- Top meta rail --------------------------------------------------- */
.connect-band-top {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
  padding: 12px 0 11px;
  border-bottom: 1px solid rgba(255,255,255,.16);
}
.connect-band-tag {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: var(--fs-button-sm);
  letter-spacing: .10em;
  text-transform: uppercase;
  color: rgba(255,255,255,.82);
}
.connect-band-tag-mid { justify-self: center; }
.connect-band-tag-end { justify-self: end; }
.connect-band-tag svg { width: 15px; height: 15px; flex: none; }

/* ---- Headline row ---------------------------------------------------- */
.connect-band-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: clamp(24px, 4vw, 64px);
  padding: clamp(20px, 2.8vw, 30px) 0 clamp(16px, 2vw, 22px);
  border-bottom: 1px solid rgba(255,255,255,.16);
}
.connect-headline {
  color: #fff;
  margin: 0;
  font-size: clamp(1.625rem, 3.2vw, 2.375rem);
  line-height: 1.02;
  letter-spacing: -.02em;
  font-weight: var(--fw-title);
}
/* The headline CTA is the site's standard pill (.btn.btn-primary.btn-sm);
   only its flex behaviour belongs here, so it keeps the shared radius,
   padding, case and hover along with every other CTA on the site. */
.connect-band-cta { flex: none; }
.connect-band-cta svg { width: 14px; height: 14px; }

/* ---- Body ------------------------------------------------------------ */
.connect-band-body { padding-top: clamp(16px, 2vw, 22px); }
.connect-sub {
  color: rgba(255,255,255,.80);
  max-width: 46ch;
  margin: 0 0 14px;
  font-size: var(--fs-small);
  line-height: 1.55;
}

/* Two enquiry rows standing where the reference puts its email field: a
   dark inset bar with the label on the left and a solid button on the right. */
.connect-band-actions { display: grid; gap: 10px; }
.connect-band-action {
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  background: rgba(3, 26, 38, .55);
  border: 1px solid rgba(255,255,255,.08);
  /* The site's input/surface radius, so these read as fields in the same
     system as every other form control on the site. */
  border-radius: var(--radius-sm);
  padding: 7px 7px 7px 16px;
  color: rgba(255,255,255,.86);
  transition: background .2s ease, border-color .2s ease;
}
.connect-band-action:hover { background: rgba(3, 26, 38, .72); border-color: rgba(255,255,255,.18); }
.connect-band-action-label { font-size: var(--fs-small); }
/* Both row buttons are the site's standard small pills (.btn.btn-sm), so
   only their flex behaviour is set here. */
.connect-band-action-btn { flex: none; }

.connect-band-foot {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 16px;
  margin-top: 14px;
}
.connect-band-note { font-size: var(--fs-small); color: rgba(255,255,255,.62); }

.connect-social-icons { display: flex; gap: 8px; }
.connect-social-icons a {
  width: 32px; height: 32px; border-radius: var(--radius-pill);
  display: inline-flex; align-items: center; justify-content: center;
  border: 1.5px solid rgba(255,255,255,.35); color: #fff;
  transition: background .18s ease, color .18s ease, border-color .18s ease;
}
.connect-social-icons a:hover { background: #fff; color: var(--blue-900); border-color: #fff; }
.connect-social-icons svg { width: 15px; height: 15px; }

@media (max-width: 900px) {
  /* Below the two-column break the slab no longer fits one viewport, so the
     height lock AND the pin are both released and the section flows. */
  /* Below the break the card no longer fits one viewport, so the band stops
     being a fixed screen and simply flows at its own height. The footer
     reveal is dropped with it: a footer taller than the viewport cannot be
     held behind a shorter band, so it returns to normal flow after it. */
  .connect-band-section {
    height: auto; min-height: 0; max-height: none;
  }
  .connect-pin {
    height: auto;
    display: block;
    padding: 56px 0;
  }
  body:has(> main > .connect-band-section:last-child) .site-footer { position: relative; bottom: auto; z-index: 0; }
  body:has(> main > .connect-band-section:last-child) { background: var(--page-bg); }
  .connect-band-top { grid-template-columns: 1fr auto; }
  .connect-band-tag-mid { display: none; }
  .connect-band-head { flex-direction: column; align-items: flex-start; gap: 24px; }
  .connect-band-cta { width: 100%; }
  .connect-band-action { flex-direction: column; align-items: stretch; gap: 12px; padding: 18px; text-align: center; }
  .connect-band-action-btn { text-align: center; }
  .connect-band-foot { flex-direction: column; align-items: flex-start; }
}

@media (prefers-reduced-motion: reduce) {
  .connect-band,
  .connect-band [data-reveal-child] { opacity: 1; transform: none; transition: none; }
  .connect-bg img { transform: none; transition: none; }
  /* The rise is motion for its own sake, so it is dropped entirely here —
     the plain sticky release still uncovers the footer. */
}

/* ==========================================================================
   THE NORMAL SECTION HEADING SYSTEM
   ==========================================================================
   One rule owns the typography of every NORMAL section heading on the site.

   Why this exists: the same four token values were previously restated by
   five separate component rules (.section-head h2, .stage-head h2,
   .why-section .section-head h2, .cta-band h2, .journey-head h2), and their
   responsive steps were duplicated in six more places. Nothing linked them,
   so each new section re-declared the set from scratch and any one of them
   could drift without the others noticing — which is exactly how the stage
   heading ended up at 25px while its neighbours sat at 40px, twice.

   Now there is one list. To bring a new section heading into the system,
   add its selector here and give it NO typography of its own. To change
   every section heading, edit the tokens.

   Placed at the end of the file deliberately: several of these components
   are defined late (.stage-head at ~4086, .journey-head at ~4654),
   and a shared rule declared earlier would
   lose to them on source order. This is the one place a single rule can
   win for all of them without inflating specificity.

   LAYOUT IS NOT TYPOGRAPHY: width, alignment, margin, colour and position
   stay with each component. Only family/size/weight/leading/tracking/case
   are shared, so sections keep their own composition.

   NOT in this system (genuine display headlines, documented in §8):
     .hero h1 / .hc-title     — the hero, the site's display benchmark
     .services-intro h2       — a full-viewport pinned rail panel that
                                plays the hero's role in its own section
     .stage-word              — decorative artwork, not a heading at all
     .connect-headline        — the closing band is now a full-viewport
                                pinned slab over a photograph, playing the
                                hero's role at the end of the page
     .article-body / .legal-body h2 — prose headings inside a 760px
                                measure column, deliberately a step down
     .footer-signup h2        — footer chrome, deliberately quieter
   ========================================================================== */
.section-head h2,
.why-section .section-head h2,
.stage-head h2,
.journey-head h2,
.cta-band h2 {
  font-family: var(--font-sans);
  font-size: var(--fs-title);
  font-weight: var(--fw-title);
  line-height: var(--lh-title);
  letter-spacing: var(--ls-title);
  text-transform: none;
}

/* The shared responsive steps, in ONE place rather than repeated per
   selector. Same values the system already used. */
@media (max-width: 900px) {
  .section-head h2,
  .why-section .section-head h2,
  .stage-head h2,
  .journey-head h2,
  .cta-band h2 { font-size: 2.1em; }
}
@media (max-width: 600px) {
  .section-head h2,
  .why-section .section-head h2,
  .stage-head h2,
  .journey-head h2,
  .cta-band h2 { font-size: 1.8em; }
}

/* ==========================================================================
   Contact hero — split layout (image left / enquiry form right)
   Replaces the centred .page-hero band on contact.html. The image column is
   a full-bleed portrait that sets the row height; the form column scrolls
   its own content if the viewport is short.
   ========================================================================== */
.contact-hero {
  background: var(--blue-50);
  padding: 0;
  overflow: hidden;
}
.contact-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: stretch;
  min-height: 640px;
}
.contact-hero-media {
  position: relative;
  min-height: 100%;
  background: var(--blue-200);
}
.contact-hero-media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.contact-hero-form {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(40px, 5vw, 72px) clamp(24px, 5vw, 80px);
  background: #fff;
}
.contact-hero-form .eyebrow { align-self: flex-start; margin-bottom: 12px; }
.contact-hero-form h1 {
  font-size: clamp(1.9em, 3.2vw, 2.5em);
  line-height: var(--lh-title);
  letter-spacing: var(--ls-title);
  margin: 0 0 12px;
}
.contact-hero-form .contact-hero-lead {
  color: var(--ink-700);
  font-size: var(--fs-card-desc);
  line-height: var(--lh-body);
  max-width: 48ch;
  margin: 0 0 26px;
}

@media (max-width: 900px) {
  .contact-hero-grid { grid-template-columns: 1fr; min-height: 0; }
  .contact-hero-media { min-height: 380px; }
  .contact-hero-media img { position: static; height: 380px; }
}

/* Info cards below the split hero: a 4-up row rather than a stacked
   sidebar, since the form no longer shares that column. */
.contact-info-grid .contact-info-card { margin-bottom: 0; height: 100%; }

/* The contact hero runs under the fixed header the same way the homepage hero
   does: the body drops its offset and the form column pads itself clear of the
   bar, so the photo fills the full frame including the strip behind the nav. */
body:has(> main > .contact-hero:first-child) { padding-top: 0; }
body:has(> main > .contact-hero:first-child) .contact-hero-form {
  padding-top: calc(var(--header-h) + clamp(24px, 3vw, 48px));
}
/* Dark scrim across the header band only, so the logo reads against the photo
   in the left column. Same treatment as the homepage hero. */
body:has(> main > .contact-hero:first-child) .site-header:not(.is-scrolled)::before {
  content: "";
  position: absolute; left: 0; right: 50%; top: 0;
  height: calc(var(--header-h) + 46px);
  pointer-events: none;
  z-index: 0;
  background: linear-gradient(180deg,
    rgba(0,22,36,.72) 0%,
    rgba(0,22,36,.52) 50%,
    rgba(0,22,36,.20) 80%,
    transparent 100%);
}
body:has(> main > .contact-hero:first-child) .site-header .nav-wrap { position: relative; z-index: 1; }

@media (max-width: 900px) {
  body:has(> main > .contact-hero:first-child) .contact-hero-form { padding-top: clamp(32px, 6vw, 48px); }
  body:has(> main > .contact-hero:first-child) .contact-hero-media { padding-top: 0; }
  body:has(> main > .contact-hero:first-child) .site-header:not(.is-scrolled)::before { right: 0; }
}

/* ---------- Contact hero form — reference styling ----------
   Underline-only fields: no boxes, no fills, labels hidden and carried by the
   placeholder instead, with a hairline rule under each field. Matches the
   .contact-hero-form is now the only user of this treatment — the homepage
   connect band it was modelled on no longer carries a form. */
.contact-hero-form form { display: block; }
.contact-hero-form .form-field { margin-bottom: 0; }
.contact-hero-form .form-field label {
  position: absolute; width: 1px; height: 1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
}
.contact-hero-form .form-field input,
.contact-hero-form .form-field select,
.contact-hero-form .form-field textarea {
  width: 100%;
  border: 0;
  border-bottom: 1.5px solid rgba(23, 32, 38, .22);
  border-radius: 0;
  background: transparent;
  padding: 16px 2px;
  font-size: var(--fs-card-desc);
  font-family: inherit;
  color: var(--ink-900);
  outline: none;
  transition: border-color .18s ease;
}
.contact-hero-form .form-field input::placeholder,
.contact-hero-form .form-field textarea::placeholder { color: var(--ink-500); }
.contact-hero-form .form-field select {
  color: var(--ink-500);
  appearance: none; -webkit-appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23607685' stroke-width='2'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E");
  background-repeat: no-repeat; background-position: right 2px center;
  background-size: 18px; padding-right: 26px;
}
.contact-hero-form .form-field input:focus,
.contact-hero-form .form-field select:focus,
.contact-hero-form .form-field textarea:focus { border-bottom-color: var(--blue-700); }
.contact-hero-form .form-field textarea { resize: none; }
.contact-hero-form .form-row-2 { gap: 0 28px; }

/* Compact pill submit sized to its label, not the column. */
.contact-hero-form form .btn {
  width: auto;
  display: inline-flex;
  margin-top: 28px;
  border-radius: var(--radius-pill);
}
.contact-hero-form .form-note { margin-top: 14px; }

/* ===================================================================
   EDITORIAL CATEGORY HERO  (.cat-hero)
   -------------------------------------------------------------------
   A full-bleed photographic band used at the top of a category page in
   place of the centred .page-hero gradient. The picture carries the
   section; type sits on it rather than beside it — headline and CTAs
   pinned bottom-left, a short positioning line bottom-right, both on the
   same baseline. Typography is the site ramp (General Sans via
   --font-sans, inherited) so it reads as the same family as the homepage
   hero: the eyebrow takes the label scale, the headline the
   h1 scale at the shared title weight and tracking.
   =================================================================== */
/* One screen tall, pinned three ways — the full-viewport contract from
   SECTION-HEIGHTS.md, the same box the homepage .hero declares. The three
   declarations are all required: 100svh sets the box in the stable unit a
   collapsing mobile toolbar cannot change, and the max(…, 620px) floor stops
   it shrinking past the hero's own floor on a short window. This section
   qualifies for the lock because its content is authored to fit — the copy
   row is ~260px and flexes into whatever height is left, so the box never
   clips it. */
.cat-hero {
  position: relative;
  height: 100svh;
  min-height: max(100svh, 620px);
  max-height: max(100svh, 620px);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--header-h) 0 clamp(34px, 5vh, 62px);
  background: #1b1512;
  color: #fff;
  overflow: hidden;
}
.cat-hero .ch-img {
  position: absolute; inset: 0; z-index: 0;
  width: 100%; height: 100%;
  object-fit: cover; object-position: 50% 45%;
}
/* Two scrims, not one: a left-to-right wash that keeps the headline column
   readable over the bright part of the picture, and a bottom gradient that
   anchors both text blocks on the same baseline. */
.cat-hero::after {
  content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background:
    linear-gradient(90deg, rgba(14,10,8,.62) 0%, rgba(14,10,8,.30) 34%, rgba(14,10,8,.06) 56%, transparent 72%),
    linear-gradient(180deg, rgba(14,10,8,.46) 0%, transparent 26%, transparent 52%, rgba(14,10,8,.60) 100%);
}
.cat-hero .container { position: relative; z-index: 2; width: 100%; }

/* The headline row: copy left, positioning line right, sharing a baseline.
   It collapses to a single stacked column on narrow screens. */
.cat-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 23em);
  align-items: end;
  gap: 30px clamp(28px, 5vw, 80px);
}
.cat-hero-eyebrow {
  margin: 0 0 .75em;
  font-size: var(--fs-label); font-weight: var(--fw-label);
  letter-spacing: var(--ls-label-tight);
  color: rgba(255,255,255,.86);
}
/* The headline runs larger than the flat --fs-h1 the centred .page-hero uses:
   on a full-bleed photograph the type has a whole screen to hold, and the
   reference sets it at display scale. It stays on the ramp by taking --fs-h1
   as its floor and the shared title line-height and tracking, so it is the
   same typeface and proportions, just one step up the scale. */
.cat-hero h1 {
  margin: 0;
  color: #fff;
  font-size: clamp(var(--fs-h1), 5.2vw, 76px);
  line-height: var(--lh-title);
  letter-spacing: var(--ls-title);
  max-width: 12em;
  text-wrap: balance;
  text-shadow: 0 2px 22px rgba(12,8,6,.42);
}
.cat-hero .hero-cta {
  justify-content: flex-start;
  margin-top: clamp(22px, 3vh, 34px);
}
/* The reference's buttons are square, but every CTA on this site is a pill
   (.btn takes --radius-pill, as does the homepage hero's .hc-cta), so these
   keep the site's radius rather than the reference's — consistency with the
   rest of the site wins over copying that one detail. */
.cat-hero .hero-cta .btn {
  min-width: 11em;
  justify-content: center;
}
/* Deliberately the small print of the pair — the label scale against the
   headline's display scale, so the row reads with one clear focal point. */
.cat-hero-note {
  margin: 0;
  font-size: var(--fs-label);
  line-height: var(--lh-body);
  color: rgba(255,255,255,.88);
  max-width: 30em;
  margin-left: auto;
  text-shadow: 0 1px 14px rgba(12,8,6,.5);
}

/* Below 900px the lock is released, matching .hero, which goes height:auto at
   the same breakpoint. A section matched to the hero on desktop is
   deliberately not matched here. */
@media (max-width: 900px) {
  .cat-hero {
    height: auto;
    min-height: min(70svh, 560px);
    max-height: none;
    padding: calc(var(--header-h) + 40px) 0 48px;
  }
  .cat-hero-grid { grid-template-columns: 1fr; align-items: start; }
  .cat-hero h1 { max-width: none; }
  .cat-hero-note { max-width: 34em; }
}
@media (max-width: 560px) {
  .cat-hero .hero-cta .btn { min-width: 0; flex: 1 1 auto; }
}

/* ===================================================================
   EDITORIAL PRODUCT GRID  (.grid-editorial)
   -------------------------------------------------------------------
   A gallery-style range listing: the photograph carries each tile and the
   only type is a name/price row beneath it. No card chrome, no per-card
   buttons — the whole tile is one link, the way a lookbook grid works.

   Scoped to the grid with a modifier rather than restyling .product-card,
   which 43 pages share. Everything here overrides the base card inside
   .grid-editorial only; the same markup on every other page is untouched.
   =================================================================== */
.grid.grid-editorial {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 26px clamp(16px, 1.8vw, 26px);
}
/* Strip the card: no ground, no border, no radius, no shadow, no lift. */
.grid-editorial .product-card {
  background: none;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}
.grid-editorial .product-card:hover {
  transform: none;
  box-shadow: none;
}
/* A tile is HALF a panel row: two of them stacked fill the panel's height
   exactly, which is what makes the reference's rows square off. So the thumb
   takes whatever height is left after the name/price line rather than an
   aspect-ratio of its own — an intrinsic ratio would size the image from its
   own width and leave the card short, which is what left dead space under
   the tiles beside the panel. */
/* In the reference the tiles are SHORTER than the panel beside them, not
   stretched to match it: they take their own near-square ratio, sit at the
   top of the row and leave the space below empty. That is what keeps the
   panel reading as the feature and the tiles as the supporting row. */
.grid-editorial .product-card { align-self: start; }
/* rgb(224,226,230) — the value sampled from the reference's own product
   tiles, where it is the photography's studio backdrop rather than a CSS
   colour. Very slightly cool (blue one step above red), which is what keeps
   it sitting naturally next to this page's blue-tinted ground. */
.grid-editorial .product-card .thumb {
  display: block;
  aspect-ratio: 450/560;
  border-radius: 0;
  background: #e0e2e6;
}
/* The product sits INSIDE the tile with air around it rather than being
   cropped to fill it: `contain` keeps the whole machine visible and the
   padding holds it off the edges, so the tile reads as a product shot on a
   ground — the reference's treatment — instead of a bleed crop. */
.grid-editorial .product-card .thumb img {
  object-fit: contain;
  padding: 6%;
}
/* The site-wide `.product-card .thumb img.is-cutout` rule paints --blue-50 on
   the IMAGE, which covers the tile's own ground — so a cut-out rendered a
   different colour from the tiles beside it. In this grid the ground belongs
   to .thumb, so the image stays transparent and its padding comes from the
   rule above. */
.grid-editorial .product-card .thumb img.is-cutout {
  background: none;
  padding: 6%;
}
/* A slower, smaller push than the base card's .35s/1.06 — at this size the
   image is the whole tile, so the movement wants to be barely there. */
.grid-editorial .product-card .thumb img { transition: transform .6s cubic-bezier(.22,.61,.36,1); }
.grid-editorial .product-card:hover .thumb img { transform: scale(1.03); }

/* The one type row: name left, action right, on a single baseline under the
   picture. Everything the base card stacks inside a padded body is either
   hidden below or laid out on this line. */
/* flex-direction must be stated: the base .product-card .body sets `column`
   at equal specificity and later in the file, so omitting it here leaves the
   row stacked. */
.grid-editorial .product-card .body {
  padding: 14px 2px 0;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  flex: none;
}
/* The category tag, the description and the spec chip all repeat what the
   section head already says, and the reference's row carries neither. */
.grid-editorial .product-card .cat-tag,
.grid-editorial .product-card p.desc,
.grid-editorial .product-card .spec-chip-row { display: none; }

/* The name is a caption under a picture, not a card title: it sits on one
   line beside the action with no description under it, so it takes the body
   size rather than --fs-card-title (20px), which is sized for a stacked card
   with copy beneath. This matches the action opposite it, so the row reads
   as one line of type — as the reference's name/price row does. */
.grid-editorial .product-card h3 {
  margin: 0;
  min-width: 0;
  flex: 1;
  font-size: var(--fs-card-desc);
  line-height: var(--lh-card);
  font-weight: var(--fw-label);
  letter-spacing: var(--ls-body);
}
.grid-editorial .product-card h3 a { color: var(--ink-900); text-decoration: none; }
.grid-editorial .product-card:hover h3 a { color: var(--blue-700); }

/* "From $195.00" sits opposite the name in the reference. We do not publish
   prices, so the price slot carries the pricing ACTION instead — same
   position, same quiet treatment, as a text link rather than a button, so
   the row stays one line of type. */
.grid-editorial .product-card .card-actions {
  margin: 0;
  flex: none;
  gap: 0;
}
.grid-editorial .product-card .card-actions .btn-outline { display: none; }
/* The base .btn-whatsapp carries a border, a box-shadow and the waPulse
   attention animation — all of which are for a green pill, not a line of
   type. They have to be cleared explicitly, or the link renders as a faintly
   glowing outlined box. */
.grid-editorial .product-card .card-actions .btn-whatsapp {
  flex: none;
  padding: 0;
  background: none;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  animation: none;
  color: var(--ink-500);
  font-size: var(--fs-card-desc);
  font-weight: var(--fw-body);
  line-height: var(--lh-card);
  white-space: nowrap;
}
.grid-editorial .product-card .card-actions .btn-whatsapp svg { display: none; }
.grid-editorial .product-card .card-actions .btn-whatsapp:hover {
  background: none;
  color: var(--blue-700);
  text-decoration: underline;
}

/* The section head goes left-aligned to match the grid's left edge — a
   centred head over a flush gallery grid reads as two different systems. */
.section-editorial .section-head {
  max-width: none;
  margin-left: 0;
  margin-right: 0;
  text-align: left;
}

@media (max-width: 767px) {
  .grid.grid-editorial { gap: 32px 14px; }
}
@media (max-width: 560px) {
  .grid.grid-editorial { gap: 26px 12px; }
  .grid-editorial .product-card .body { flex-direction: column; align-items: flex-start; gap: 3px; }
}

/* ---------- Editorial grid: feature panel ----------
   Matched to the reference's own .featured-products spec rather than
   approximated: the grid runs FOUR columns and the panel spans two of them,
   so exactly two product tiles sit beside it and the row reads 1 feature +
   2 products. The panel occupies a single row at a near-square ratio
   (the reference uses 696/704) — it is not a two-row block.

   Below 768px the grid drops to two columns and the panel goes full width
   at a tall portrait ratio, which is what the reference does at its own
   48rem breakpoint. */
/* The panel spans TWO tile rows. Each row is one tile plus its name line, so
   two stacked tiles come out exactly as tall as one panel — which is what
   squares off the reference's rows. Height comes from the span, so the panel
   carries no aspect-ratio of its own. */
.grid-editorial .range-feature {
  aspect-ratio: 696/704;
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: clamp(24px, 2.4vw, 40px);
  overflow: hidden;
  background: #0b2030;
  color: #fff;
  text-decoration: none;
}
/* The reference alternates the panel's side between sections. Here every
   panel lives in one grid, so each is pinned to an explicit column AND row,
   alternating sides down the page.

   Each panel occupies ONE row, spanning two of the four columns — so the two
   columns left beside it hold exactly TWO product tiles, not four. (A
   two-row panel would leave a 2x2 space and take four tiles.) */
.grid-editorial { grid-auto-flow: dense; }
.grid-editorial .range-feature   { grid-column: 1 / span 2; grid-row: 1; }
.grid-editorial .range-feature-2 { grid-column: 3 / span 2; grid-row: 2; }
.grid-editorial .range-feature-3 { grid-column: 1 / span 2; grid-row: 3; }

/* The final row holds the three products left over after the panels. Left in
   the 4-column flow they sit in columns 1-3 and leave a hole at the right.
   This row spans the full width and uses space-between, so the tiles KEEP
   the column width they have everywhere else — the extra space goes into the
   gaps instead of stretching the tiles. First is flush left, last flush
   right. */
.grid-editorial .range-tail {
  grid-column: 1 / -1;
  display: flex;
  justify-content: space-between;
  gap: clamp(16px, 1.8vw, 26px);
}
/* One column's width on the parent's 4-track grid. */
.grid-editorial .range-tail > .product-card {
  flex: 0 0 calc((100% - 3 * clamp(16px, 1.8vw, 26px)) / 4);
}

/* The image is oversized by the parallax travel on BOTH edges, then pulled
   up by that same amount, so it still covers the panel at either end of the
   drift. --px-travel must match the data-parallax value in the markup; the
   reference does the same thing with its own --fp-parallax-travel. */
.grid-editorial .range-feature img {
  --px-travel: 30%;
  position: absolute; left: 0; z-index: 0;
  top: calc(var(--px-travel) * -1);
  width: 100%;
  height: calc(100% + var(--px-travel) * 2);
  object-fit: cover; object-position: 62% 58%;
  will-change: transform;
}
/* The hover zoom is dropped on parallax images: a transition on transform
   fights the scrubbed tween, which sets transform every frame. */
.grid-editorial .range-feature:hover img { transform: none; }
.grid-editorial .range-feature:hover img { transform: scale(1.03); }
/* A radial vignette, as the reference uses — it darkens the edges and leaves
   the centre of the photograph clear, unlike a bottom-up linear scrim which
   flattens the whole lower half. */
.grid-editorial .range-feature::after {
  content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 0%, rgba(4,14,22,.92) 100%);
  opacity: .62;
}
/* Copy sits bottom-right with the headline pulled to the left edge — the
   reference's align-items:flex-end plus align-self:flex-start on the title. */
.grid-editorial .rf-content {
  position: relative; z-index: 2;
  display: flex; flex-direction: column;
  align-items: flex-end;
  gap: clamp(14px, 1.4vw, 22px);
}
.grid-editorial .rf-title {
  align-self: flex-start;
  margin: 0;
  color: #fff;
  font-size: clamp(var(--fs-h3), 2.4vw, 38px);
  line-height: var(--lh-title);
  letter-spacing: var(--ls-title);
  max-width: 8em;
  text-wrap: balance;
}
/* The reference pins this column to 18rem; ours matches so the paragraph
   sets as a narrow block against the headline rather than a wide band. */
.grid-editorial .rf-detail {
  display: flex; flex-direction: column;
  gap: clamp(14px, 1.4vw, 22px);
  width: 18rem;
  max-width: 100%;
}
.grid-editorial .rf-copy {
  margin: 0;
  font-size: var(--fs-card-desc);
  line-height: var(--lh-body);
  color: rgba(255,255,255,.92);
}
.grid-editorial .range-feature .btn { width: 100%; }

@media (max-width: 767px) {
  .grid.grid-editorial { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid-editorial .range-feature,
  .grid-editorial .range-feature-2,
  .grid-editorial .range-feature-3 {
    grid-column: 1 / -1;
    grid-row: auto;
    height: auto;
    aspect-ratio: 370/537;
  }
  .grid-editorial .rf-detail { width: 100%; }
}

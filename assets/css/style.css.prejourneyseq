/* ---------- Panel utility block ---------- */
.menu-bottom-links-group {
  display: flex; justify-content: space-between; align-items: flex-end;
  width: 100%; flex: none; gap: 1.5em; padding-top: 1.5em;
  border-top: 1px solid rgba(255,255,255,.18);
  /* Last thing in, and on the reference it is a pure fade with no travel:
     up from ~1030ms over ~500ms, and out over ~470ms on close. */
  opacity: 0;
  /* First thing in is the last thing out: the open fades this up at 1.03s,
     so the close drops it immediately, over the same .5s. */
  transition: opacity .5s ease;
}
.menu-side-bar.open .menu-bottom-links-group {
  opacity: 1;
  transition: opacity .5s ease 1.03s;
}
.menu-bottom-links-1, .menu-bottom-links-2 { display: flex; flex-direction: column; gap: .38em; }
.menu-caps {
  font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: none; letter-spacing: var(--ls-label-tight); line-height: var(--lh-tight);
  color: var(--blue-300); text-decoration: none;
}
a.menu-caps.link { transition: color .2s ease; }
a.menu-caps.link:hover { color: #fff; }

/* Locks the page behind the open panel without the scrollbar's disappearance
   shifting the layout. */
body.menu-open { overflow: hidden; }

/* ---------- Panel responsiveness ----------
   One component at every width, so these are size steps, not layout rewrites. */
@media (max-width: 900px) {
  /* Matches their mobile override: flex-flow column, full width, and the
     divider laid flat under the CLOSE row. */
  .menu-side-bar-inner {
    width: 100vw; padding: 1em var(--gutter) 1.5em;
    flex-direction: column; align-items: stretch; gap: 1.1em;
  }
  .close-btn-wrap { width: 100%; justify-content: flex-end; }
